<%
  var headerActions = [];
  if (can('purchases.manage')) {
    headerActions.push({ label: 'Add supplier', url: '/suppliers/new', icon: 'bi-plus-lg', class: 'btn-primary' });
  }
%>

<%- include('../partials/page-header', {
  heading: 'Suppliers',
  subheading: 'Vendors, payment terms and live payable balances.',
  actions: headerActions
}) %>

<div class="card app-card mt-3">
  <div class="card-body border-bottom">
    <form method="GET" action="/suppliers" class="row g-2 align-items-end">
      <div class="col-12 col-md-5">
        <label for="search" class="form-label small text-muted mb-1">Search</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="search" class="form-control" id="search" name="search"
                 value="<%= filters.search %>" placeholder="Code, name, company, contact, phone, NTN">
        </div>
      </div>
      <div class="col-6 col-md-3">
        <label for="city" class="form-label small text-muted mb-1">City</label>
        <select class="form-select" id="city" name="city">
          <option value="">All cities</option>
          <% cities.forEach(function (city) { %>
            <option value="<%= city %>"<%= filters.city === city ? ' selected' : '' %>><%= city %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-6 col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Filter</button>
        <a href="/suppliers" class="btn btn-outline-secondary">Reset</a>
      </div>
    </form>
  </div>

  <div class="card-header bg-transparent d-flex flex-wrap gap-2 justify-content-between align-items-center">
    <span class="small text-muted"><strong><%= total %></strong> supplier<%= total === 1 ? '' : 's' %> found</span>
    <span class="badge text-bg-light border">Payable = opening + purchases − payments</span>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle app-table mb-0">
      <thead>
        <tr>
          <th>Supplier</th>
          <th>Contact</th>
          <th>City</th>
          <th class="text-end">Purchases</th>
          <th class="text-end">Payable</th>
          <th>Terms</th>
          <th class="text-end" style="width:130px"></th>
        </tr>
      </thead>
      <tbody>
        <% if (!suppliers.length) { %>
          <tr><td colspan="7" class="text-center py-5 text-muted"><i class="bi bi-truck fs-3 d-block mb-2"></i>No suppliers match your filters.</td></tr>
        <% } else { %>
          <% suppliers.forEach(function (supplier) { %>
            <tr>
              <td>
                <a href="/suppliers/<%= supplier._id %>" class="fw-semibold text-decoration-none"><%= supplier.name %></a>
                <div class="text-muted small"><span class="font-monospace"><%= supplier.code %></span><%= supplier.company ? ' · ' + supplier.company : '' %></div>
              </td>
              <td class="small">
                <div><%= supplier.contactName || '—' %></div>
                <div class="text-muted"><%= supplier.phone || supplier.email || '' %></div>
              </td>
              <td class="small text-muted"><%= supplier.city || '—' %></td>
              <td class="text-end small">
                <div><%= supplier.purchaseCount %> order<%= supplier.purchaseCount === 1 ? '' : 's' %></div>
                <div class="text-muted"><%= formatPKR(supplier.purchaseTotalPaisa) %></div>
              </td>
              <td class="text-end fw-semibold <%= supplier.payablePaisa > 0 ? 'text-danger' : 'text-success' %>">
                <%= formatPKR(supplier.payablePaisa) %>
              </td>
              <td class="small text-muted"><%= supplier.paymentTermsDays ? supplier.paymentTermsDays + ' days' : 'Cash' %></td>
              <td class="text-end">
                <div class="d-flex justify-content-end gap-1">
                  <a class="btn btn-sm btn-outline-secondary" href="/suppliers/<%= supplier._id %>" title="View supplier"><i class="bi bi-eye"></i></a>
                  <% if (can('purchases.manage')) { %>
                    <a class="btn btn-sm btn-outline-secondary" href="/suppliers/<%= supplier._id %>/edit" title="Edit supplier"><i class="bi bi-pencil"></i></a>
                    <button type="button" class="btn btn-sm btn-outline-danger" title="Delete supplier"
                            data-delete-url="/suppliers/<%= supplier._id %>"
                            data-delete-name="<%= supplier.name %>"><i class="bi bi-trash"></i></button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <%- include('../partials/pagination', { pagination: pagination }) %>
</div>
