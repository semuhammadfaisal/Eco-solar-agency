<%- include('../partials/page-header', {
  heading: "Today's Recovery Queue",
  subheading: 'Field and phone collection queue for installments due today, overdue accounts, and active promises.',
  actions: [
    { label: 'Escalations', url: '/recovery/escalations', icon: 'bi-exclamation-octagon', class: 'btn-outline-danger' },
    { label: 'Calendar', url: '/installments/calendar', icon: 'bi-calendar-event', class: 'btn-outline-secondary' }
  ]
}) %>

<div x-data="{
  search: '',
  selectedPlanId: '',
  selectedCustomerId: '',
  customerName: '',
  planNumber: '',
  ptpDate: '',
  ptpAmount: '',
  ptpNotes: '',
  noteOutcome: 'spoke_to_customer',
  noteText: '',
  nextActionDate: '',

  openPtpModal(planId, custId, name, planNo, defaultAmount) {
    this.selectedPlanId = planId;
    this.selectedCustomerId = custId;
    this.customerName = name;
    this.planNumber = planNo;
    this.ptpAmount = (defaultAmount / 100).toFixed(2);
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    this.ptpDate = tomorrow.toISOString().split('T')[0];
    new bootstrap.Modal(document.getElementById('ptpModal')).show();
  },

  openNoteModal(planId, custId, name, planNo) {
    this.selectedPlanId = planId;
    this.selectedCustomerId = custId;
    this.customerName = name;
    this.planNumber = planNo;
    this.noteText = '';
    new bootstrap.Modal(document.getElementById('noteModal')).show();
  }
}">

  <!-- Overview Stats -->
  <div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
      <div class="card app-card text-center p-3 border-danger-subtle h-100">
        <div class="small text-muted text-uppercase fw-semibold">Delinquent Queue</div>
        <div class="display-6 fw-bold text-danger"><%= recoveryItems.length %></div>
        <div class="small text-muted">Accounts requiring collection</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card app-card text-center p-3 border-warning-subtle h-100">
        <div class="small text-muted text-uppercase fw-semibold">Due Today</div>
        <div class="display-6 fw-bold text-warning-emphasis">
          <%= recoveryItems.filter(i => i.hasDueToday).length %>
        </div>
        <div class="small text-muted">Tranches maturing today</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card app-card text-center p-3 border-info-subtle h-100">
        <div class="small text-muted text-uppercase fw-semibold">Active Promises</div>
        <div class="display-6 fw-bold text-info">
          <%= recoveryItems.reduce((acc, i) => acc + (i.activePromises ? i.activePromises.length : 0), 0) %>
        </div>
        <div class="small text-muted">Customer commitments</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card app-card text-center p-3 border-success-subtle h-100">
        <div class="small text-muted text-uppercase fw-semibold">Total Recoverable</div>
        <div class="display-6 fw-bold text-success">
          <%= formatPKR(recoveryItems.reduce((acc, i) => acc + i.totalDuePaisa, 0)) %>
        </div>
        <div class="small text-muted">Queue balance</div>
      </div>
    </div>
  </div>

  <!-- Search Filter -->
  <div class="card app-card mb-3">
    <div class="card-body p-2 p-md-3">
      <div class="input-group">
        <span class="input-group-text bg-transparent text-muted"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" x-model="search" placeholder="Quick search by customer name, phone, plan # or area…">
      </div>
    </div>
  </div>

  <!-- Queue Cards List -->
  <% if (!recoveryItems.length) { %>
    <div class="card app-card text-center py-5">
      <div class="card-body">
        <i class="bi bi-check-circle-fill text-success fs-1 mb-2"></i>
        <h5 class="fw-semibold">Recovery Queue Clear!</h5>
        <p class="text-muted mb-0">No delinquent or due installments found in your queue today.</p>
      </div>
    </div>
  <% } else { %>
    <div class="row g-3">
      <% recoveryItems.forEach(function (item) { %>
        <div class="col-12 col-lg-6"
             x-show="!search || '<%= item.customer.name.toLowerCase() %>'.includes(search.toLowerCase()) || '<%= (item.customer.phone || '').toLowerCase() %>'.includes(search.toLowerCase()) || '<%= item.planNumber.toLowerCase() %>'.includes(search.toLowerCase()) || '<%= (item.customer.area || '').toLowerCase() %>'.includes(search.toLowerCase())">
          <div class="card app-card h-100 shadow-sm border-start border-4 <%= item.maxDaysOverdue >= 15 ? 'border-danger' : item.maxDaysOverdue > 0 ? 'border-warning' : 'border-info' %>">
            <div class="card-body p-3">

              <!-- Customer & Plan Header -->
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <h5 class="mb-0 fw-bold">
                    <a href="/customers/<%= item.customer._id %>" class="text-dark text-decoration-none">
                      <%= item.customer.name %>
                    </a>
                  </h5>
                  <div class="small text-muted">
                    <span class="badge text-bg-light border me-1"><%= item.customer.code %></span>
                    <a href="/installments/<%= item.planId %>" class="text-decoration-none fw-semibold">
                      <%= item.planNumber %>
                    </a>
                    <% if (item.isFlaggedForRecovery) { %>
                      <span class="badge text-bg-danger ms-1">RECOVERY FLAGGED</span>
                    <% } %>
                  </div>
                </div>

                <!-- Overdue Status Badge -->
                <div class="text-end">
                  <% if (item.maxDaysOverdue > 0) { %>
                    <span class="badge text-bg-danger fs-6 px-2 py-1">
                      <%= item.maxDaysOverdue %> Days Overdue
                    </span>
                  <% } else { %>
                    <span class="badge text-bg-warning fs-6 px-2 py-1">Due Today</span>
                  <% } %>
                  <div class="fw-bold text-danger mt-1 fs-5">
                    <%= formatPKR(item.totalDuePaisa) %>
                  </div>
                </div>
              </div>

              <!-- Contact & Location Info -->
              <div class="bg-light p-2 rounded small mb-3">
                <div class="d-flex flex-wrap gap-3">
                  <div>
                    <i class="bi bi-telephone text-muted me-1"></i>
                    <strong><%= item.customer.phone %></strong>
                  </div>
                  <% if (item.customer.area || item.customer.city) { %>
                    <div>
                      <i class="bi bi-geo-alt text-muted me-1"></i>
                      <%= [item.customer.area, item.customer.city].filter(Boolean).join(', ') %>
                    </div>
                  <% } %>
                  <% if (item.customer.gps && item.customer.gps.lat) { %>
                    <div>
                      <a href="https://maps.google.com/?q=<%= item.customer.gps.lat %>,<%= item.customer.gps.lng %>"
                         target="_blank" class="text-primary text-decoration-none">
                        <i class="bi bi-map me-1"></i>Map Pin
                      </a>
                    </div>
                  <% } %>
                  <% if (item.assignedOfficer) { %>
                    <div>
                      <i class="bi bi-person-badge text-muted me-1"></i>
                      Officer: <strong><%= item.assignedOfficer.name %></strong>
                    </div>
                  <% } %>
                </div>

                <% if (item.customer.address) { %>
                  <div class="text-muted mt-1 text-truncate" title="<%= item.customer.address %>">
                    <i class="bi bi-house me-1"></i><%= item.customer.address %>
                  </div>
                <% } %>
              </div>

              <!-- Active PTPs Alert -->
              <% if (item.activePromises && item.activePromises.length) { %>
                <div class="alert alert-info py-1 px-2 small mb-3 d-flex align-items-center gap-2">
                  <i class="bi bi-handshake text-info fs-5"></i>
                  <div>
                    <strong>PTP Active:</strong>
                    Promised <%= formatPKR(item.activePromises[0].promisedAmountPaisa) %> on
                    <%= formatDate(item.activePromises[0].promisedDate) %>
                    <% if (item.activePromises[0].notes) { %>
                      <em>("<%= item.activePromises[0].notes %>")</em>
                    <% } %>
                  </div>
                </div>
              <% } %>

              <!-- Action Bar (Mobile-friendly buttons) -->
              <div class="d-flex flex-wrap gap-1">
                <% if (item.telLink) { %>
                  <a href="<%= item.telLink %>" class="btn btn-outline-primary btn-sm flex-fill">
                    <i class="bi bi-telephone-fill me-1"></i>Call
                  </a>
                <% } %>

                <% if (item.waLink) { %>
                  <a href="<%= item.waLink %>" target="_blank" class="btn btn-outline-success btn-sm flex-fill">
                    <i class="bi bi-whatsapp me-1"></i>WhatsApp
                  </a>
                <% } %>

                <a href="/installments/<%= item.planId %>" class="btn btn-primary btn-sm flex-fill">
                  <i class="bi bi-cash-stack me-1"></i>Collect
                </a>

                <button type="button" class="btn btn-outline-warning btn-sm"
                        @click="openPtpModal('<%= item.planId %>', '<%= item.customer._id %>', '<%= item.customer.name.replace(/'/g, "\\'") %>', '<%= item.planNumber %>', <%= item.totalDuePaisa %>)"
                        title="Record Promise to Pay">
                  <i class="bi bi-calendar-plus me-1"></i>PTP
                </button>

                <button type="button" class="btn btn-outline-secondary btn-sm"
                        @click="openNoteModal('<%= item.planId %>', '<%= item.customer._id %>', '<%= item.customer.name.replace(/'/g, "\\'") %>', '<%= item.planNumber %>')"
                        title="Record Call / Visit Note">
                  <i class="bi bi-journal-text me-1"></i>Note
                </button>
              </div>

            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- Modal: Record Promise to Pay -->
  <div class="modal fade" id="ptpModal" tabindex="-1" aria-labelledby="ptpModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="POST" action="/recovery/ptp">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="installmentPlanId" :value="selectedPlanId">
          <input type="hidden" name="customerId" :value="selectedCustomerId">

          <div class="modal-header">
            <h5 class="modal-title" id="ptpModalLabel">
              <i class="bi bi-handshake text-warning me-2"></i>Record Promise to Pay (PTP)
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>

          <div class="modal-body">
            <div class="mb-3">
              <div class="small text-muted">Customer & Plan</div>
              <div class="fw-bold" x-text="customerName + ' (' + planNumber + ')'"></div>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-12 col-md-6">
                <label class="form-label small fw-semibold">Promised Date *</label>
                <input type="date" class="form-control" name="promisedDate" x-model="ptpDate" required>
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label small fw-semibold">Promised Amount (PKR) *</label>
                <input type="number" step="1" min="1" class="form-control" name="promisedAmount" x-model="ptpAmount" required>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Call / Commitment Notes</label>
              <textarea class="form-control" name="notes" rows="3" x-model="ptpNotes"
                        placeholder="e.g. Customer promised cash deposit via Raast after harvest sale..."></textarea>
            </div>
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-warning">Save Promise</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal: Record Recovery Note -->
  <div class="modal fade" id="noteModal" tabindex="-1" aria-labelledby="noteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="POST" action="/recovery/notes">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="installmentPlanId" :value="selectedPlanId">
          <input type="hidden" name="customerId" :value="selectedCustomerId">

          <div class="modal-header">
            <h5 class="modal-title" id="noteModalLabel">
              <i class="bi bi-journal-text text-primary me-2"></i>Log Recovery Interaction
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>

          <div class="modal-body">
            <div class="mb-3">
              <div class="small text-muted">Customer & Plan</div>
              <div class="fw-bold" x-text="customerName + ' (' + planNumber + ')'"></div>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Call / Visit Outcome *</label>
              <select class="form-select" name="callOutcome" x-model="noteOutcome" required>
                <option value="spoke_to_customer">Spoke to Customer</option>
                <option value="promise_to_pay">Promise to Pay Made</option>
                <option value="call_not_answered">Call Not Answered</option>
                <option value="phone_switched_off">Phone Switched Off</option>
                <option value="wrong_number">Wrong / Invalid Number</option>
                <option value="site_visit">Physical Site Visit Conducted</option>
                <option value="dispute">Billing / Warranty Dispute Raised</option>
                <option value="refused_to_pay">Customer Refused to Pay</option>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Interaction Notes *</label>
              <textarea class="form-control" name="notes" rows="3" x-model="noteText" required
                        placeholder="Summarize the discussion, customer reasons, or observations..."></textarea>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Next Follow-up Action Date</label>
              <input type="date" class="form-control" name="nextActionDate" x-model="nextActionDate">
            </div>
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Interaction</button>
          </div>
        </form>
      </div>
    </div>
  </div>

</div>
