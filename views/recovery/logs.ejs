<%- include('../partials/page-header', {
  heading: 'Notification & Reminder Logs',
  subheading: 'Audit trail of all automated and manual customer notifications dispatched via WhatsApp, SMS, and Email.',
  actions: [
    { label: "Today's queue", url: '/recovery/today', icon: 'bi-phone-flip', class: 'btn-outline-primary' }
  ]
}) %>

<!-- Search & Filters -->
<div class="card app-card mb-3">
  <div class="card-body p-3">
    <form method="GET" action="/recovery/logs" class="row g-2 align-items-center">
      <div class="col-6 col-md-3">
        <select class="form-select" name="channel">
          <option value="">All Channels</option>
          <option value="whatsapp" <%= filters.channel === 'whatsapp' ? 'selected' : '' %>>WhatsApp</option>
          <option value="sms" <%= filters.channel === 'sms' ? 'selected' : '' %>>SMS</option>
          <option value="email" <%= filters.channel === 'email' ? 'selected' : '' %>>Email</option>
        </select>
      </div>

      <div class="col-6 col-md-3">
        <select class="form-select" name="status">
          <option value="">All Statuses</option>
          <option value="sent" <%= filters.status === 'sent' ? 'selected' : '' %>>Sent</option>
          <option value="dry_run" <%= filters.status === 'dry_run' ? 'selected' : '' %>>Dry Run (Simulated)</option>
          <option value="delivered" <%= filters.status === 'delivered' ? 'selected' : '' %>>Delivered</option>
          <option value="failed" <%= filters.status === 'failed' ? 'selected' : '' %>>Failed</option>
        </select>
      </div>

      <div class="col-12 col-md-6 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/recovery/logs" class="btn btn-light border">Reset</a>
      </div>
    </form>
  </div>
</div>

<!-- Logs Table -->
<div class="card app-card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light text-muted small text-uppercase">
        <tr>
          <th>Sent At</th>
          <th>Channel</th>
          <th>Stage</th>
          <th>Recipient</th>
          <th>Plan #</th>
          <th>Message Preview</th>
          <th>Status</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (!logs.length) { %>
          <tr>
            <td colspan="8" class="text-center py-4 text-muted">No notification logs found.</td>
          </tr>
        <% } else { %>
          <% logs.forEach(function (l) { %>
            <tr>
              <td class="small text-muted"><%= formatDateTime(l.sentAt || l.createdAt) %></td>
              <td>
                <% if (l.channel === 'whatsapp') { %>
                  <span class="badge text-bg-success"><i class="bi bi-whatsapp me-1"></i>WhatsApp</span>
                <% } else if (l.channel === 'sms') { %>
                  <span class="badge text-bg-info"><i class="bi bi-chat-text me-1"></i>SMS</span>
                <% } else { %>
                  <span class="badge text-bg-secondary"><i class="bi bi-envelope me-1"></i>Email</span>
                <% } %>
              </td>
              <td>
                <span class="badge text-bg-light border"><%= l.stage %></span>
              </td>
              <td>
                <div class="fw-semibold">
                  <% if (l.recipientCustomer) { %>
                    <a href="/customers/<%= l.recipientCustomer._id %>" class="text-dark text-decoration-none">
                      <%= l.recipientCustomer.name %>
                    </a>
                  <% } else { %>
                    Unknown
                  <% } %>
                </div>
                <div class="small text-muted">
                  <%= l.recipientPhone || l.recipientEmail || 'N/A' %>
                </div>
              </td>
              <td>
                <% if (l.installmentPlan) { %>
                  <a href="/installments/<%= l.installmentPlan._id %>" class="text-decoration-none small fw-semibold">
                    <%= l.installmentPlan.planNumber %>
                  </a>
                <% } else { %>
                  <span class="text-muted small">—</span>
                <% } %>
              </td>
              <td>
                <div class="small text-muted text-truncate" style="max-width: 320px;" title="<%= l.body %>">
                  <%= l.body %>
                </div>
              </td>
              <td>
                <% if (l.status === 'sent' || l.status === 'delivered') { %>
                  <span class="badge text-bg-success"><%= l.status %></span>
                <% } else if (l.status === 'dry_run') { %>
                  <span class="badge text-bg-info" title="Dry Run: Simulated without live API credentials">Dry Run (Simulated)</span>
                <% } else if (l.status === 'failed') { %>
                  <span class="badge text-bg-danger" title="<%= l.errorMessage %>">Failed</span>
                <% } else { %>
                  <span class="badge text-bg-secondary"><%= l.status %></span>
                <% } %>
              </td>
              <td class="text-end">
                <% if (l.status === 'failed') { %>
                  <form method="POST" action="/recovery/logs/<%= l._id %>/retry" class="d-inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Retry sending notification">
                      <i class="bi bi-arrow-repeat me-1"></i>Retry
                    </button>
                  </form>
                <% } else { %>
                  <span class="text-muted small">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (pagination.pages > 1) { %>
    <div class="card-footer bg-transparent py-3">
      <%- include('../partials/pagination', { pagination }) %>
    </div>
  <% } %>
</div>
