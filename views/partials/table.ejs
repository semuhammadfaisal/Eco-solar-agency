<%
  // Reusable table.
  //   columns: [{ label, class, width }]
  //   rows:    [{ class, cells: [ { html } | { value, class } | 'plain text' ] }]
  //   empty:   message shown when there are no rows
  var tableColumns = (typeof columns !== 'undefined' && columns) ? columns : [];
  var tableRows = (typeof rows !== 'undefined' && rows) ? rows : [];
  var emptyMessage = (typeof empty !== 'undefined' && empty) ? empty : 'No records found.';
%>
<div class="table-responsive">
  <table class="table table-hover align-middle app-table mb-0">
    <thead>
      <tr>
        <% tableColumns.forEach(function (column) { %>
          <th scope="col" class="<%= column.class || '' %>"<%= column.width ? ' style="width:' + column.width + '"' : '' %>>
            <%= column.label %>
          </th>
        <% }); %>
      </tr>
    </thead>
    <tbody>
      <% if (!tableRows.length) { %>
        <tr>
          <td colspan="<%= tableColumns.length %>" class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
            <%= emptyMessage %>
          </td>
        </tr>
      <% } else { %>
        <% tableRows.forEach(function (row) { %>
          <tr class="<%= row.class || '' %>">
            <% (row.cells || []).forEach(function (cell) { %>
              <% if (cell !== null && typeof cell === 'object' && cell.html !== undefined) { %>
                <td class="<%= cell.class || '' %>"><%- cell.html %></td>
              <% } else if (cell !== null && typeof cell === 'object') { %>
                <td class="<%= cell.class || '' %>"><%= cell.value !== undefined ? cell.value : '' %></td>
              <% } else { %>
                <td><%= cell %></td>
              <% } %>
            <% }); %>
          </tr>
        <% }); %>
      <% } %>
    </tbody>
  </table>
</div>
