<%- include('../partials/page-header', {
  heading: 'Installation Projects & Commissioning',
  subheading: 'Manage engineering workflows, material release from warehouse, technical checklists, and commissioning reports.',
  actions: [
    { label: 'Warranty registry', url: '/warranties', icon: 'bi-shield-check', class: 'btn-outline-secondary' },
    { label: 'Complaints', url: '/complaints', icon: 'bi-headset', class: 'btn-outline-secondary' }
  ]
}) %>

<!-- Search & Status Filter Toolbar -->
<div class="card app-card mb-3">
  <div class="card-body p-3">
    <form method="GET" action="/installations" class="row g-2 align-items-center">
      <div class="col-12 col-md-4">
        <div class="input-group">
          <span class="input-group-text bg-transparent text-muted"><i class="bi bi-search"></i></span>
          <input type="text" class="form-control" name="search" value="<%= filters.search || '' %>"
                 placeholder="Search by installation # (e.g. INS-2026-0001)...">
        </div>
      </div>

      <div class="col-6 col-md-3">
        <select class="form-select" name="status">
          <option value="">All Statuses</option>
          <% installationsConfig.INSTALLATION_STATUSES.forEach(function (st) { %>
            <option value="<%= st %>" <%= filters.status === st ? 'selected' : '' %>>
              <%= installationsConfig.INSTALLATION_STATUS_LABELS[st] || st %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-6 col-md-3">
        <select class="form-select" name="leadTechnician">
          <option value="">All Technicians</option>
          <% technicians.forEach(function (t) { %>
            <option value="<%= t._id %>" <%= filters.leadTechnician === String(t._id) ? 'selected' : '' %>>
              <%= t.name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-12 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">Filter</button>
        <a href="/installations" class="btn btn-light border">Reset</a>
      </div>
    </form>
  </div>
</div>

<!-- Installations Table -->
<div class="card app-card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light text-muted small text-uppercase">
        <tr>
          <th>Installation #</th>
          <th>Customer</th>
          <th>Sale Contract</th>
          <th>Lead Technician</th>
          <th>Scheduled Date</th>
          <th>Status</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!installations.length) { %>
          <tr>
            <td colspan="7" class="text-center py-4 text-muted">No installation projects found.</td>
          </tr>
        <% } else { %>
          <% installations.forEach(function (inst) { %>
            <tr>
              <td>
                <a href="/installations/<%= inst._id %>" class="font-monospace fw-bold text-decoration-none">
                  <%= inst.installationNumber %>
                </a>
              </td>
              <td>
                <div class="fw-semibold">
                  <% if (inst.customer) { %>
                    <a href="/customers/<%= inst.customer._id %>" class="text-dark text-decoration-none">
                      <%= inst.customer.name %>
                    </a>
                  <% } else { %>
                    Unknown
                  <% } %>
                </div>
                <div class="small text-muted">
                  <%= inst.customer ? inst.customer.phone : '' %> &bull; <%= inst.customer ? [inst.customer.area, inst.customer.city].filter(Boolean).join(', ') : '' %>
                </div>
              </td>
              <td>
                <% if (inst.sale) { %>
                  <a href="/projects/<%= inst.sale._id %>" class="font-monospace small text-decoration-none">
                    <%= inst.sale.saleNumber %>
                  </a>
                  <div class="text-muted" style="font-size:0.75rem;">
                    <%= inst.sale.systemSummary ? inst.sale.systemSummary.capacityKw + ' kW' : '' %>
                  </div>
                <% } else { %>—<% } %>
              </td>
              <td>
                <span class="small fw-semibold">
                  <%= inst.leadTechnician ? inst.leadTechnician.name : 'Unassigned' %>
                </span>
              </td>
              <td>
                <%= inst.scheduledStartDate ? formatDate(inst.scheduledStartDate) : 'Pending Schedule' %>
              </td>
              <td>
                <span class="badge text-bg-<%= installationsConfig.INSTALLATION_STATUS_BADGES[inst.status] || 'secondary' %>">
                  <%= installationsConfig.INSTALLATION_STATUS_LABELS[inst.status] || inst.status %>
                </span>
              </td>
              <td class="text-end">
                <a href="/installations/<%= inst._id %>" class="btn btn-sm btn-outline-primary me-1">
                  Workspace
                </a>
                <% if (['completed', 'commissioned'].includes(inst.status)) { %>
                  <a href="/installations/<%= inst._id %>/commissioning-pdf" target="_blank" class="btn btn-sm btn-outline-secondary" title="Commissioning Report PDF">
                    <i class="bi bi-file-earmark-pdf"></i>
                  </a>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (pagination.pages > 1) { %>
    <div class="card-footer bg-transparent py-3">
      <%- include('../partials/pagination', { pagination }) %>
    </div>
  <% } %>
</div>
