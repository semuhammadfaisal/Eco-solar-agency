<%- include('../partials/page-header', {
  heading: hasPassword ? 'Reset branch password' : 'Set branch password',
  subheading: 'This password is shared by everyone who signs in with the branch login.',
  actions: [{ label: 'Back to branch logins', url: '/users/branch-logins', icon: 'bi-arrow-left', class: 'btn-outline-secondary' }]
}) %>

<div class="row g-3 g-lg-4 mt-1">
  <div class="col-12 col-xl-8">
    <div class="card app-card">
      <div class="card-body p-4">
        <%- include('../partials/form-errors') %>

        <div class="d-flex align-items-center gap-3 mb-4">
          <span class="avatar"><%= initials(branch.name) %></span>
          <div class="min-w-0">
            <div class="fw-semibold"><%= branch.name %></div>
            <div class="small text-muted"><%= branch.code %><%= branch.city ? ' · ' + branch.city : '' %></div>
          </div>
          <span class="badge text-bg-<%= branch.isActive ? 'success' : 'secondary' %> ms-auto"><%= branch.isActive ? 'Active' : 'Inactive' %></span>
        </div>

        <% if (!branch.isActive) { %>
          <div class="alert alert-warning d-flex gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <div class="small">This branch is inactive. Activate it before enabling branch login.</div>
          </div>
        <% } %>

        <form method="POST" action="<%= formAction %>" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label for="password" class="form-label">Branch password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" id="password" name="password"
                     autocomplete="new-password" minlength="8" required autofocus
                     <%= branch.isActive ? '' : 'disabled' %>>
              <div class="form-text">8–72 characters with at least one letter and one number.</div>
            </div>

            <div class="col-12 col-md-6">
              <label for="passwordConfirm" class="form-label">Confirm branch password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" id="passwordConfirm" name="passwordConfirm"
                     autocomplete="new-password" minlength="8" required
                     <%= branch.isActive ? '' : 'disabled' %>>
            </div>
          </div>

          <div class="alert alert-warning d-flex gap-2 mt-4 mb-0" role="alert">
            <i class="bi bi-shield-exclamation mt-1"></i>
            <div class="small">
              Saving a new password enables the branch login and signs out any session already using the old password.
              Share it only with this branch's team.
            </div>
          </div>

          <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-primary" <%= branch.isActive ? '' : 'disabled' %>>
              <i class="bi bi-key me-1"></i><%= hasPassword ? 'Reset password' : 'Enable branch login' %>
            </button>
            <a href="/users/branch-logins" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-4">
    <div class="card app-card">
      <div class="card-header bg-transparent"><span class="fw-semibold">Branch login</span></div>
      <div class="card-body">
        <dl class="row small mb-0">
          <dt class="col-6 text-muted fw-normal">Status</dt>
          <dd class="col-6">
            <% if (branch.loginEnabled && hasPassword) { %>
              <span class="badge text-bg-success">Enabled</span>
            <% } else { %>
              <span class="badge text-bg-secondary">Disabled</span>
            <% } %>
          </dd>
          <dt class="col-6 text-muted fw-normal">Last used</dt>
          <dd class="col-6"><%= formatDateTime(branch.loginLastUsedAt) %></dd>
          <dt class="col-6 text-muted fw-normal">Last IP</dt>
          <dd class="col-6"><%= branch.loginLastLoginIp || '—' %></dd>
          <dt class="col-6 text-muted fw-normal">Password set</dt>
          <dd class="col-6"><%= formatDateTime(branch.loginPasswordChangedAt) %></dd>
        </dl>
      </div>
    </div>

    <div class="card app-card mt-3">
      <div class="card-body small text-muted">
        <div class="fw-semibold text-body mb-1"><i class="bi bi-shop me-1"></i>What the branch sees</div>
        Branch dashboard, POS sales, this branch's stock, stock transfers and the product catalogue. Company CRM, finance, purchasing, accounting and user admin stay blocked.
      </div>
    </div>
  </div>
</div>
