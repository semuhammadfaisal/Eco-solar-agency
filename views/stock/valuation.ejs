<%- include('../partials/page-header', {
  heading: 'Stock valuation',
  subheading: 'On-hand quantity at moving-average cost, grouped by category.',
  actions: [
    { label: 'Back to ledger', url: '/stock', icon: 'bi-arrow-left', class: 'btn-outline-secondary' }
  ]
}) %>

<div class="row g-3 mt-1">
  <div class="col-6 col-lg-3">
    <div class="card app-card h-100"><div class="card-body stat-card">
      <span class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-boxes"></i></span>
      <div class="stat-value"><%= totals.itemCount %></div>
      <div class="stat-label">Items with stock records</div>
    </div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card h-100"><div class="card-body stat-card">
      <span class="stat-icon bg-info-subtle text-info-emphasis"><i class="bi bi-stack"></i></span>
      <div class="stat-value"><%= formatQty(totals.totalUnits) %></div>
      <div class="stat-label">Total units on hand</div>
    </div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card h-100"><div class="card-body stat-card">
      <span class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-exclamation-triangle"></i></span>
      <div class="stat-value"><%= totals.lowStock %></div>
      <div class="stat-label">Low-stock items</div>
    </div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card h-100"><div class="card-body stat-card">
      <span class="stat-icon bg-success-subtle text-success"><i class="bi bi-cash-stack"></i></span>
      <div class="stat-value"><%= formatPKR(totals.totalValuePaisa) %></div>
      <div class="stat-label">Total stock value</div>
    </div></div>
  </div>
</div>

<div class="row g-3 mt-1">
  <div class="col-12 col-xl-4">
    <div class="card app-card">
      <div class="card-header bg-transparent"><h2 class="h6 fw-semibold mb-0">Value by category</h2></div>
      <div class="table-responsive">
        <table class="table table-hover align-middle app-table mb-0">
          <thead>
            <tr>
              <th>Category</th>
              <th class="text-end">Items</th>
              <th class="text-end">Units</th>
              <th class="text-end">Value</th>
            </tr>
          </thead>
          <tbody>
            <% if (!categories.length) { %>
              <tr><td colspan="4" class="text-center py-4 text-muted">No stock records yet.</td></tr>
            <% } else { %>
              <% categories.forEach(function (row) { 
                   var label = inventory.ITEM_CATEGORY_LABELS[row._id] || row._id;
                   var badge = inventory.ITEM_CATEGORY_BADGES[row._id] || 'secondary';
              %>
                <tr>
                  <td><span class="badge text-bg-<%= badge %>"><%= label %></span></td>
                  <td class="text-end small"><%= row.itemCount %></td>
                  <td class="text-end small"><%= formatQty(row.units) %></td>
                  <td class="text-end small fw-semibold"><%= formatPKR(row.valuePaisa) %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
          <tfoot>
            <tr>
              <th class="small text-uppercase text-muted">Total</th>
              <th class="text-end"><%= totals.itemCount %></th>
              <th class="text-end"><%= formatQty(totals.totalUnits) %></th>
              <th class="text-end"><%= formatPKR(totals.totalValuePaisa) %></th>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <div class="card app-card bg-light-subtle mt-3">
      <div class="card-header bg-transparent"><h2 class="h6 fw-semibold mb-0">How value is calculated</h2></div>
      <div class="card-body small text-muted">
        <div class="font-monospace bg-white border rounded p-2 mb-2">current stock × moving-average cost</div>
        <p class="mb-0">
          The average cost moves when stock is received on a GRN and is stored as integer paisa,
          so the valuation never depends on a catalogue price being edited later.
        </p>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-8">
    <div class="card app-card">
      <div class="card-body border-bottom">
        <form method="GET" action="/stock/valuation" class="row g-2 align-items-end">
          <div class="col-12 col-md-5">
            <label for="category" class="form-label small text-muted mb-1">Category</label>
            <select class="form-select" id="category" name="category">
              <option value="">All categories</option>
              <% inventory.ITEM_CATEGORIES.forEach(function (category) { %>
                <option value="<%= category %>"<%= filters.category === category ? ' selected' : '' %>>
                  <%= inventory.ITEM_CATEGORY_LABELS[category] %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="col-12 col-md-7 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Apply</button>
            <a href="/stock/valuation" class="btn btn-outline-secondary">Reset</a>
            <button type="button" class="btn btn-outline-secondary ms-auto" onclick="window.print()">
              <i class="bi bi-printer me-1"></i>Print
            </button>
          </div>
        </form>
      </div>

      <div class="card-header bg-transparent d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <h2 class="h6 fw-semibold mb-0">Item valuation</h2>
        <span class="badge text-bg-light border"><%= items.length %> item<%= items.length === 1 ? '' : 's' %></span>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle app-table mb-0">
          <thead>
            <tr>
              <th>Item</th>
              <th>Category</th>
              <th class="text-end">On hand</th>
              <th class="text-end">Average cost</th>
              <th class="text-end">Stock value</th>
            </tr>
          </thead>
          <tbody>
            <% if (!items.length) { %>
              <tr><td colspan="5" class="text-center py-5 text-muted">No items match this category.</td></tr>
            <% } else { %>
              <% items.forEach(function (item) { 
                   var rowClass = item.isOutOfStock ? 'stock-out-row' : (item.isLowStock ? 'stock-low-row' : '');
              %>
                <tr class="<%= rowClass %>">
                  <td>
                    <a href="/items/<%= item._id %>" class="fw-semibold text-decoration-none"><%= item.name %></a>
                    <div class="text-muted small"><span class="font-monospace"><%= item.sku %></span><%= item.brand ? ' · ' + item.brand : '' %></div>
                  </td>
                  <td class="small">
                    <span class="badge text-bg-<%= inventory.ITEM_CATEGORY_BADGES[item.category] || 'secondary' %>">
                      <%= inventory.ITEM_CATEGORY_LABELS[item.category] || item.category %>
                    </span>
                  </td>
                  <td class="text-end small">
                    <%= formatQty(item.currentStock) %> <span class="text-muted"><%= item.unit %></span>
                    <% if (item.isOutOfStock) { %><div class="text-danger" style="font-size:.72rem">Out of stock</div>
                    <% } else if (item.isLowStock) { %><div class="text-warning-emphasis" style="font-size:.72rem">Low stock</div><% } %>
                  </td>
                  <td class="text-end small"><%= formatPKR(item.avgCostPaisa) %></td>
                  <td class="text-end small fw-semibold"><%= formatPKR(item.stockValuePaisa) %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
          <tfoot>
            <tr>
              <th colspan="4" class="text-end text-uppercase small text-muted">Total valuation</th>
              <th class="text-end"><%= formatPKR(totals.totalValuePaisa) %></th>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</div>
