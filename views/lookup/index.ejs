<%- include('../partials/page-header', {
  heading: 'Find Business Record',
  subheading: 'Open a customer, invoice, quotation, or receipt using its permanent reference number.'
}) %>

<div class="card app-card mb-3">
  <div class="card-body p-3 p-md-4">
    <form method="GET" action="/lookup" class="row g-2">
      <div class="col-12 col-md-9">
        <label for="business-number" class="form-label fw-semibold">Business number</label>
        <div class="input-group input-group-lg">
          <span class="input-group-text bg-transparent"><i class="bi bi-upc-scan"></i></span>
          <input id="business-number" name="q" value="<%= query %>" class="form-control font-monospace"
                 placeholder="e.g. CUS-0001, INV-2026-0001, QT-2026-0001, RC-0001" autofocus>
        </div>
      </div>
      <div class="col-12 col-md-3 d-flex align-items-end">
        <button class="btn btn-primary btn-lg w-100" type="submit">
          <i class="bi bi-search me-1"></i>Find record
        </button>
      </div>
    </form>
  </div>
</div>

<% if (query) { %>
  <div class="card app-card">
    <div class="card-header bg-transparent py-3">
      <h2 class="h6 fw-bold mb-0"><%= results.length %> result<%= results.length === 1 ? '' : 's' %> for <span class="font-monospace text-primary"><%= query %></span></h2>
    </div>
    <% if (!results.length) { %>
      <div class="card-body text-center text-muted py-5">
        <i class="bi bi-search fs-1 d-block mb-2"></i>
        <div class="fw-semibold text-dark">No matching business number</div>
        <div class="small">Check the prefix and digits, then try again.</div>
      </div>
    <% } else { %>
      <div class="list-group list-group-flush">
        <% results.forEach(function (row) { %>
          <a href="<%= row.url %>" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
            <span class="badge text-bg-light border text-primary"><%= row.type %></span>
            <span class="flex-grow-1 min-w-0">
              <strong class="font-monospace d-block"><%= row.number %></strong>
              <span class="small text-muted"><%= row.title %><%= row.subtitle ? ' · ' + row.subtitle : '' %></span>
            </span>
            <span class="small text-muted d-none d-md-inline"><%= formatDate(row.date) %></span>
            <i class="bi bi-chevron-right text-muted"></i>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
<% } %>
