<%- include('../partials/page-header', {
  heading: 'Equipment Warranty Registry',
  subheading: 'Official warranty tracking for solar panels (product & 25-yr performance), inverters, batteries, and workmanship.',
  actions: [
    { label: 'Installations', url: '/installations', icon: 'bi-tools', class: 'btn-outline-primary' },
    { label: 'Complaints', url: '/complaints', icon: 'bi-headset', class: 'btn-outline-secondary' }
  ]
}) %>

<!-- Search & Filters -->
<div class="card app-card mb-3">
  <div class="card-body p-3">
    <form method="GET" action="/warranties" class="row g-2 align-items-center">
      <div class="col-12 col-md-4">
        <div class="input-group">
          <span class="input-group-text bg-transparent text-muted"><i class="bi bi-search"></i></span>
          <input type="text" class="form-control" name="search" value="<%= filters.search || '' %>"
                 placeholder="Search by warranty # (WAR-2026-...) or serial #...">
        </div>
      </div>

      <div class="col-6 col-md-3">
        <select class="form-select" name="warrantyType">
          <option value="">All Classifications</option>
          <% installationsConfig.WARRANTY_TYPES.forEach(function (wt) { %>
            <option value="<%= wt %>" <%= filters.warrantyType === wt ? 'selected' : '' %>>
              <%= installationsConfig.WARRANTY_TYPE_LABELS[wt] || wt %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-6 col-md-3">
        <select class="form-select" name="status">
          <option value="">All Statuses</option>
          <% installationsConfig.WARRANTY_STATUSES.forEach(function (ws) { %>
            <option value="<%= ws %>" <%= filters.status === ws ? 'selected' : '' %>>
              <%= installationsConfig.WARRANTY_STATUS_LABELS[ws] || ws %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-12 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">Filter</button>
        <a href="/warranties" class="btn btn-light border">Reset</a>
      </div>
    </form>
  </div>
</div>

<!-- Warranties Table -->
<div class="card app-card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light text-muted small text-uppercase">
        <tr>
          <th>Certificate #</th>
          <th>Customer</th>
          <th>Equipment / Model</th>
          <th>Serial Number</th>
          <th>Classification</th>
          <th>Validity Period</th>
          <th>Status</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!warranties.length) { %>
          <tr>
            <td colspan="8" class="text-center py-4 text-muted">No warranty certificates found.</td>
          </tr>
        <% } else { %>
          <% warranties.forEach(function (w) { %>
            <tr>
              <td>
                <a href="/warranties/<%= w._id %>" class="font-monospace fw-bold text-decoration-none">
                  <%= w.warrantyNumber %>
                </a>
              </td>
              <td>
                <div class="fw-semibold">
                  <% if (w.customer) { %>
                    <a href="/customers/<%= w.customer._id %>" class="text-dark text-decoration-none">
                      <%= w.customer.name %>
                    </a>
                  <% } else { %>—<% } %>
                </div>
                <div class="small text-muted"><%= w.customer ? w.customer.phone : '' %></div>
              </td>
              <td>
                <div class="fw-semibold"><%= w.item ? w.item.name : 'System Equipment' %></div>
                <div class="small text-muted"><%= w.item ? w.item.sku : '' %></div>
              </td>
              <td>
                <% if (w.serialString) { %>
                  <code class="fw-bold"><%= w.serialString %></code>
                <% } else { %>
                  <span class="text-muted small">Standard Bundle</span>
                <% } %>
              </td>
              <td>
                <span class="badge text-bg-<%= installationsConfig.WARRANTY_TYPE_BADGES[w.warrantyType] || 'secondary' %>">
                  <%= installationsConfig.WARRANTY_TYPE_LABELS[w.warrantyType] || w.warrantyType %>
                </span>
              </td>
              <td class="small">
                <%= formatDate(w.startDate) %> to <strong><%= formatDate(w.endDate) %></strong>
                (<%= w.years %>y)
              </td>
              <td>
                <span class="badge text-bg-<%= installationsConfig.WARRANTY_STATUS_BADGES[w.status] || 'secondary' %>">
                  <%= installationsConfig.WARRANTY_STATUS_LABELS[w.status] || w.status %>
                </span>
              </td>
              <td class="text-end">
                <a href="/warranties/<%= w._id %>/certificate-pdf" target="_blank" class="btn btn-sm btn-outline-primary" title="Download Official Certificate PDF">
                  <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                </a>
                <a href="/warranties/<%= w._id %>" class="btn btn-sm btn-outline-secondary" title="View details & claim history">
                  <i class="bi bi-eye"></i>
                </a>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (pagination.pages > 1) { %>
    <div class="card-footer bg-transparent py-3">
      <%- include('../partials/pagination', { pagination }) %>
    </div>
  <% } %>
</div>
