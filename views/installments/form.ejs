<%- include('../partials/page-header', {
  heading: 'Create Installment Plan',
  subheading: 'Set up custom solar financing, down payments, markup rates, payment frequencies, and guarantor security.',
  actions: [
    { label: 'Back to plans', url: '/installments', icon: 'bi-arrow-left', class: 'btn-outline-secondary' }
  ]
}) %>

<div class="mt-2"
     x-data="installmentPlanForm(
       <%= JSON.stringify(sales) %>,
       <%= JSON.stringify(preselectedSale) %>
     )"
     x-init="init()">

  <form method="POST" action="/installments" @submit="handleSubmit($event)" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="chequesJson" :value="JSON.stringify(cheques)">
    <input type="hidden" name="downPayment" :value="downPayment">
    <input type="hidden" name="markupFixedAmount" :value="markupFixedAmount">

    <div class="row g-3 mb-3">
      <!-- Left Column: Financial Configuration -->
      <div class="col-12 col-lg-7">
        <div class="card app-card mb-3">
          <div class="card-header bg-transparent py-3">
            <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
              <i class="bi bi-cash-stack"></i> Financing &amp; Contract Sizing
            </h3>
          </div>
          <div class="card-body p-3 p-md-4">
            <div class="row g-3">
              <!-- Sale Selection -->
              <div class="col-12">
                <label class="form-label small fw-semibold text-uppercase text-muted">Confirmed Sale Contract <span class="text-danger">*</span></label>
                <select class="form-select form-select-lg" name="sale" x-model="selectedSaleId" @change="onSaleChange()" required>
                  <option value="">Select a confirmed project contract…</option>
                  <template x-for="s in salesList" :key="s._id">
                    <option :value="s._id"
                            x-text="`${s.saleNumber} — ${s.customer ? s.customer.name : 'Client'} (Contract: PKR ${(s.amountPaisa/100).toLocaleString('en-PK')})`">
                    </option>
                  </template>
                </select>
              </div>

              <!-- Contract Total (Readonly) -->
              <div class="col-6 col-md-4">
                <label class="form-label small fw-semibold text-uppercase text-muted">Total Sale Value</label>
                <input type="text" class="form-control bg-light fw-bold" readonly :value="formatMoney(saleTotal)">
              </div>

              <!-- Down Payment -->
              <div class="col-6 col-md-4">
                <label class="form-label small fw-semibold text-uppercase text-muted">Down Payment (PKR) <span class="text-danger">*</span></label>
                <input type="number" class="form-control fw-bold text-success" min="0" step="any"
                       x-model.number="downPayment" @input="recalculate()" required>
              </div>

              <!-- Financed Amount -->
              <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-uppercase text-muted">Financed Capital</label>
                <input type="text" class="form-control bg-light font-monospace fw-semibold" readonly :value="formatMoney(financedAmount)">
              </div>

              <hr class="my-2">

              <!-- Markup Type & Rate -->
              <div class="col-6 col-md-4">
                <label class="form-label small fw-semibold text-uppercase text-muted">Markup Type</label>
                <select class="form-select" name="markupType" x-model="markupType" @change="recalculate()">
                  <option value="percent">Percentage (%)</option>
                  <option value="fixed_amount">Fixed Amount (PKR)</option>
                </select>
              </div>

              <div class="col-6 col-md-4">
                <label class="form-label small fw-semibold text-uppercase text-muted" x-text="markupType === 'percent' ? 'Markup Rate (%)' : 'Fixed Markup (PKR)'"></label>
                <div class="input-group">
                  <template x-if="markupType === 'percent'">
                    <input type="number" class="form-control fw-semibold" min="0" max="200" step="any"
                           name="markupRatePercent" x-model.number="markupRatePercent" @input="recalculate()">
                  </template>
                  <template x-if="markupType === 'fixed_amount'">
                    <input type="number" class="form-control fw-semibold" min="0" step="any"
                           x-model.number="markupFixedAmount" @input="recalculate()">
                  </template>
                  <span class="input-group-text" x-text="markupType === 'percent' ? '%' : 'PKR'"></span>
                </div>
              </div>

              <!-- Total Payable -->
              <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-uppercase text-muted">Total Financed Payable</label>
                <input type="text" class="form-control bg-light font-monospace fw-bold text-primary" readonly :value="formatMoney(totalPayable)">
              </div>

              <hr class="my-2">

              <!-- Schedule Count, Frequency & Start Date -->
              <div class="col-4">
                <label class="form-label small fw-semibold text-uppercase text-muted">Installments <span class="text-danger">*</span></label>
                <input type="number" class="form-control fw-bold" name="installmentCount"
                       min="1" max="120" step="1" x-model.number="installmentCount" @input="recalculate()" required>
              </div>

              <div class="col-4">
                <label class="form-label small fw-semibold text-uppercase text-muted">Frequency <span class="text-danger">*</span></label>
                <select class="form-select" name="frequency" x-model="frequency" @change="recalculate()">
                  <option value="monthly">Monthly</option>
                  <option value="bi_monthly">Bi-Monthly (Every 2 mo)</option>
                  <option value="quarterly">Quarterly (Every 3 mo)</option>
                </select>
              </div>

              <div class="col-4">
                <label class="form-label small fw-semibold text-uppercase text-muted">First Due Date <span class="text-danger">*</span></label>
                <input type="date" class="form-control" name="startDate" x-model="startDate" @change="recalculate()" required>
              </div>

              <!-- Assigned Officer & Late Fee Policy -->
              <div class="col-6">
                <label class="form-label small fw-semibold text-uppercase text-muted">Collection Officer</label>
                <select class="form-select" name="assignedOfficer">
                  <option value="">Unassigned (General Queue)</option>
                  <% officers.forEach(function (off) { %>
                    <option value="<%= off._id %>"><%= off.name %> (<%= off.role %>)</option>
                  <% }); %>
                </select>
              </div>

              <div class="col-3">
                <label class="form-label small fw-semibold text-uppercase text-muted">Grace Days</label>
                <input type="number" class="form-control" name="graceDays" min="0" max="60" value="5">
              </div>

              <div class="col-3">
                <label class="form-label small fw-semibold text-uppercase text-muted">Late Fee (PKR)</label>
                <input type="number" class="form-control" name="lateFeeAmount" min="0" value="500">
              </div>
            </div>
          </div>
        </div>

        <!-- Guarantor Information Card -->
        <div class="card app-card mb-3">
          <div class="card-header bg-transparent py-3">
            <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
              <i class="bi bi-person-check"></i> Guarantor Information
            </h3>
          </div>
          <div class="card-body p-3 p-md-4">
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <label class="form-label small fw-semibold text-uppercase text-muted">Guarantor Name</label>
                <input type="text" class="form-control" name="guarantorName" placeholder="e.g. Muhammad Akram">
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label small fw-semibold text-uppercase text-muted">Guarantor CNIC</label>
                <input type="text" class="form-control" name="guarantorCnic" placeholder="e.g. 35201-1234567-1">
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label small fw-semibold text-uppercase text-muted">Guarantor Phone / Mobile</label>
                <input type="text" class="form-control" name="guarantorPhone" placeholder="e.g. 0300-9876543">
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label small fw-semibold text-uppercase text-muted">Relationship to Customer</label>
                <input type="text" class="form-control" name="guarantorRelation" placeholder="e.g. Brother, Business Partner">
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label small fw-semibold text-uppercase text-muted">Residential Address</label>
                <input type="text" class="form-control" name="guarantorAddress" placeholder="Guarantor complete address">
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label small fw-semibold text-uppercase text-muted">Workplace / Business</label>
                <input type="text" class="form-control" name="guarantorWorkplace" placeholder="Company / Occupation">
              </div>
            </div>
          </div>
        </div>

        <!-- Security Document Checklist Card -->
        <div class="card app-card mb-3">
          <div class="card-header bg-transparent py-3">
            <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
              <i class="bi bi-shield-check"></i> Security Document Checklist
            </h3>
            <p class="text-muted small mb-0">Rule: Material cannot be issued for installment sales until the checklist is complete (or owner override is granted).</p>
          </div>
          <div class="card-body p-3 p-md-4">
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="check_stampAgreement" id="check_stampAgreement" value="true">
                  <label class="form-check-label fw-medium" for="check_stampAgreement">
                    Legal Stamp Agreement Signed
                  </label>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="check_customerCnicCopy" id="check_customerCnicCopy" value="true">
                  <label class="form-check-label fw-medium" for="check_customerCnicCopy">
                    Customer CNIC Copy (Verified)
                  </label>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="check_guarantorCnicCopy" id="check_guarantorCnicCopy" value="true">
                  <label class="form-check-label fw-medium" for="check_guarantorCnicCopy">
                    Guarantor CNIC Copy (Verified)
                  </label>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="check_utilityBillCopy" id="check_utilityBillCopy" value="true">
                  <label class="form-check-label fw-medium" for="check_utilityBillCopy">
                    Utility / DISCO Electricity Bill Copy
                  </label>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="check_promissoryNote" id="check_promissoryNote" value="true">
                  <label class="form-check-label fw-medium" for="check_promissoryNote">
                    Signed Promissory Note / Undated Guarantee Cheque
                  </label>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="d-flex align-items-center gap-2">
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" name="check_postDatedCheques" id="check_postDatedCheques" value="true">
                    <label class="form-check-label fw-medium" for="check_postDatedCheques">
                      Post-Dated Cheques in Vault
                    </label>
                  </div>
                  <input type="number" class="form-control form-control-sm" style="width: 70px;"
                         name="postDatedChequesCount" placeholder="Qty" min="0" :value="installmentCount">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Live Schedule Preview & Cheques Entry -->
      <div class="col-12 col-lg-5">
        <!-- Live Schedule Preview Card -->
        <div class="card app-card mb-3 bg-light border-primary-subtle">
          <div class="card-header bg-transparent py-3">
            <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
              <i class="bi bi-calendar-event"></i> Live Schedule Preview
            </h3>
          </div>
          <div class="card-body p-3">
            <div class="d-flex justify-content-between small text-muted mb-2">
              <span>Monthly Payment:</span>
              <strong class="fs-6 text-dark" x-text="formatMoney(monthlyInstallmentAmount)">PKR 0</strong>
            </div>
            <div class="d-flex justify-content-between small text-muted mb-2">
              <span>Total Capital + Markup:</span>
              <strong class="fs-6 text-primary" x-text="formatMoney(totalPayable)">PKR 0</strong>
            </div>

            <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
              <table class="table table-sm align-middle table-bordered mb-0 bg-white">
                <thead class="table-light">
                  <tr>
                    <th style="width: 40px;">#</th>
                    <th>Due Date</th>
                    <th class="text-end">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  <template x-for="(inst, idx) in schedulePreview" :key="idx">
                    <tr>
                      <td class="text-muted small text-center" x-text="idx + 1"></td>
                      <td class="small" x-text="inst.dueDate"></td>
                      <td class="text-end font-monospace small fw-bold" x-text="formatMoney(inst.amount)"></td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Initial Post-Dated Cheques Register (Optional Quick Add) -->
        <div class="card app-card mb-3">
          <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
            <h3 class="h6 fw-bold mb-0 text-primary">Post-Dated Cheques</h3>
            <button type="button" class="btn btn-sm btn-outline-secondary" @click="autoGenerateChequeRows()">
              <i class="bi bi-magic me-1"></i>Auto-Fill Rows
            </button>
          </div>
          <div class="card-body p-3">
            <p class="text-muted small mb-2">Log the post-dated monthly cheques received from the customer for security custody.</p>
            <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
              <table class="table table-sm align-middle table-bordered mb-0">
                <thead class="table-light">
                  <tr>
                    <th style="width: 35px;">#</th>
                    <th>Cheque #</th>
                    <th>Bank</th>
                    <th style="width: 120px;">Maturity Date</th>
                  </tr>
                </thead>
                <tbody>
                  <template x-for="(ch, cIdx) in cheques" :key="cIdx">
                    <tr>
                      <td class="text-muted small text-center" x-text="cIdx + 1"></td>
                      <td>
                        <input type="text" class="form-control form-control-sm" x-model="ch.chequeNumber" placeholder="Cheque #">
                      </td>
                      <td>
                        <input type="text" class="form-control form-control-sm" x-model="ch.bankName" placeholder="Bank">
                      </td>
                      <td>
                        <input type="date" class="form-control form-control-sm" x-model="ch.chequeDate">
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
            <div class="mt-2 text-end">
              <button type="button" class="btn btn-sm btn-link text-primary p-0" @click="addChequeRow()">
                <i class="bi bi-plus-lg me-1"></i>Add single cheque
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Action Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 py-3 border-top">
      <a href="/installments" class="btn btn-outline-secondary">
        <i class="bi bi-x-lg me-1"></i>Cancel
      </a>
      <button type="submit" class="btn btn-primary btn-lg shadow-sm">
        <i class="bi bi-check2-circle me-1"></i>Generate Plan &amp; Schedule
      </button>
    </div>
  </form>
</div>

<script>
function installmentPlanForm(sales, preselected) {
  return {
    salesList: sales || [],
    selectedSaleId: preselected ? preselected._id : '',
    saleTotal: preselected ? Number(preselected.amountPaisa / 100) : 0,

    downPayment: preselected ? Math.round(Number(preselected.amountPaisa / 100) * 0.3) : 0,
    financedAmount: 0,

    markupType: 'percent',
    markupRatePercent: 12,
    markupFixedAmount: 0,
    markupAmount: 0,

    totalPayable: 0,
    installmentCount: 12,
    frequency: 'monthly',
    startDate: new Date(Date.now() + 30 * 86400000).toISOString().split('T')[0],

    monthlyInstallmentAmount: 0,
    schedulePreview: [],
    cheques: [],

    init() {
      if (this.selectedSaleId) {
        this.onSaleChange();
      } else {
        this.recalculate();
      }
    },

    formatMoney(val) {
      const num = Math.round(Number(val) || 0);
      return 'PKR ' + num.toLocaleString('en-PK');
    },

    onSaleChange() {
      const found = this.salesList.find(s => String(s._id) === String(this.selectedSaleId));
      if (found) {
        this.saleTotal = Number((found.amountPaisa || 0) / 100);
        // Default 30% down payment
        this.downPayment = Math.round(this.saleTotal * 0.3);
      } else {
        this.saleTotal = 0;
        this.downPayment = 0;
      }
      this.recalculate();
    },

    recalculate() {
      this.financedAmount = Math.max(0, this.saleTotal - (Number(this.downPayment) || 0));

      if (this.markupType === 'percent') {
        const rate = Math.max(0, Number(this.markupRatePercent) || 0);
        this.markupAmount = Math.round(this.financedAmount * (rate / 100));
      } else {
        this.markupAmount = Math.max(0, Number(this.markupFixedAmount) || 0);
      }

      this.totalPayable = this.financedAmount + this.markupAmount;
      const count = Math.max(1, parseInt(this.installmentCount, 10) || 1);

      this.monthlyInstallmentAmount = Math.floor(this.totalPayable / count);

      // Generate schedule preview
      const preview = [];
      const baseStart = new Date(this.startDate || Date.now());
      const baseAmount = Math.floor(this.totalPayable / count);
      const remainder = this.totalPayable - (baseAmount * count);

      for (let i = 1; i <= count; i++) {
        const d = new Date(baseStart);
        if (this.frequency === 'quarterly') {
          d.setMonth(d.getMonth() + (i - 1) * 3);
        } else if (this.frequency === 'bi_monthly') {
          d.setMonth(d.getMonth() + (i - 1) * 2);
        } else {
          d.setMonth(d.getMonth() + (i - 1));
        }

        const isLast = i === count;
        preview.push({
          installmentNumber: i,
          dueDate: d.toISOString().split('T')[0],
          amount: isLast ? baseAmount + remainder : baseAmount
        });
      }

      this.schedulePreview = preview;
    },

    autoGenerateChequeRows() {
      const count = Math.max(1, parseInt(this.installmentCount, 10) || 1);
      this.cheques = [];
      const baseStart = new Date(this.startDate || Date.now());

      for (let i = 1; i <= count; i++) {
        const d = new Date(baseStart);
        if (this.frequency === 'quarterly') d.setMonth(d.getMonth() + (i - 1) * 3);
        else if (this.frequency === 'bi_monthly') d.setMonth(d.getMonth() + (i - 1) * 2);
        else d.setMonth(d.getMonth() + (i - 1));

        this.cheques.push({
          chequeNumber: '',
          bankName: '',
          chequeDate: d.toISOString().split('T')[0],
          amount: this.monthlyInstallmentAmount
        });
      }
    },

    addChequeRow() {
      this.cheques.push({
        chequeNumber: '',
        bankName: '',
        chequeDate: '',
        amount: this.monthlyInstallmentAmount
      });
    },

    handleSubmit(e) {
      if (!this.selectedSaleId) {
        alert('Please select a confirmed sale contract.');
        e.preventDefault();
        return;
      }
      if (this.downPayment >= this.saleTotal) {
        alert('Down payment cannot be equal to or exceed the total contract value.');
        e.preventDefault();
        return;
      }
    }
  };
}
</script>
