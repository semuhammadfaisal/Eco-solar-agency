<%- include('../partials/page-header', {
  heading: 'Payment Receipt ' + payment.receiptNumber,
  subheading: 'Official payment acknowledgment for ' + (payment.customer ? payment.customer.name : 'Customer') + ' · Issued ' + formatDate(payment.paymentDate),
  actions: [
    { label: 'Print receipt', url: 'javascript:window.print()', icon: 'bi-printer', class: 'btn-primary' },
    { label: 'Download PDF', url: '/installments/receipts/' + payment._id + '/pdf', icon: 'bi-file-earmark-pdf', class: 'btn-outline-primary', target: '_blank' },
    ...(whatsappUrl ? [{ label: 'WhatsApp Share', url: whatsappUrl, icon: 'bi-whatsapp', class: 'btn-success', target: '_blank' }] : []),
    { label: 'View plan', url: '/installments/' + (payment.installmentPlan ? (payment.installmentPlan._id || payment.installmentPlan) : ''), icon: 'bi-arrow-left', class: 'btn-outline-secondary' }
  ]
}) %>

<!-- Printable Receipt Voucher Card -->
<div class="row justify-content-center my-3">
  <div class="col-12 col-lg-9">
    <div class="card app-card shadow-sm p-4 p-md-5 print-voucher" style="background:#fff;">

      <!-- Letterhead Header -->
      <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4">
        <div>
          <% if (settings.logoPath) { %>
            <img src="<%= settings.logoPath %>" alt="<%= settings.companyName %>" style="max-height: 55px;" class="mb-2">
          <% } %>
          <h2 class="h5 fw-bold text-primary mb-1"><%= settings.companyName || 'SOLAR AGENCY' %></h2>
          <div class="text-muted small" style="line-height: 1.4;">
            <%= [settings.address, settings.city].filter(Boolean).join(', ') %><br>
            <% if (settings.phone) { %><span>Phone: <%= settings.phone %></span><% } %>
            <% if (settings.email) { %><span> · Email: <%= settings.email %></span><% } %><br>
            <% if (settings.ntn) { %><span>NTN: <%= settings.ntn %></span><% } %>
            <% if (settings.strn) { %><span> · STRN: <%= settings.strn %></span><% } %>
          </div>
        </div>
        <div class="text-end">
          <span class="badge text-bg-success fs-6 px-3 py-2 mb-2">PAID RECEIPT</span>
          <h3 class="h5 font-monospace fw-bold text-dark mb-1"><%= payment.receiptNumber %></h3>
          <div class="text-muted small">Date: <%= formatDate(payment.paymentDate) %></div>
          <% if (payment.installmentPlan && payment.installmentPlan.planNumber) { %>
            <div class="text-muted small font-monospace">Plan: <%= payment.installmentPlan.planNumber %></div>
          <% } %>
        </div>
      </div>

      <!-- Customer & Payment Details -->
      <div class="row g-3 mb-4">
        <div class="col-7">
          <div class="p-3 bg-light rounded border">
            <div class="small fw-semibold text-uppercase text-muted mb-1">Received From (Customer):</div>
            <h4 class="h6 fw-bold text-dark mb-1"><%= payment.customer ? payment.customer.name : 'Valued Client' %></h4>
            <div class="text-muted small">
              <% if (payment.customer && payment.customer.phone) { %>Phone: <%= payment.customer.phone %><br><% } %>
              <% if (payment.customer && payment.customer.code) { %>Code: <%= payment.customer.code %><br><% } %>
              Address: <%= (payment.customer && [payment.customer.address, payment.customer.city].filter(Boolean).join(', ')) || '—' %>
            </div>
          </div>
        </div>

        <div class="col-5">
          <div class="p-3 bg-light rounded border text-end h-100 d-flex flex-column justify-content-center">
            <div class="small fw-semibold text-uppercase text-muted mb-1">Amount Received</div>
            <div class="display-6 fw-bold text-success mb-1 font-monospace"><%= formatPKR(payment.amountPaisa) %></div>
            <div class="small text-muted">
              Method: <strong><%= installments.PAYMENT_METHOD_LABELS[payment.paymentMethod] || payment.paymentMethod %></strong>
              <% if (payment.reference) { %><br>Ref: <%= payment.reference %><% } %>
            </div>
          </div>
        </div>

        <!-- Amount in Words -->
        <div class="col-12">
          <div class="p-2 px-3 rounded bg-success-subtle text-success-emphasis border border-success-subtle d-flex align-items-center gap-2">
            <i class="bi bi-cash-stack fs-5"></i>
            <div>
              <span class="fw-bold small text-uppercase">Amount in Words:</span>
              <span class="fw-semibold ms-1"><%= numberToWordsPKR(payment.amountPaisa, true) %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Allocation Breakdown Table -->
      <h4 class="h6 fw-bold text-primary mb-2">Installment Allocation Breakdown</h4>
      <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle mb-0">
          <thead class="table-light small">
            <tr>
              <th style="width: 45px;">#</th>
              <th>Installment Tranche</th>
              <th class="text-end" style="width: 140px;">Principal Paid</th>
              <th class="text-end" style="width: 130px;">Late Fee Paid</th>
              <th class="text-end" style="width: 150px;">Total Allocated</th>
            </tr>
          </thead>
          <tbody>
            <% (payment.allocations || []).forEach(function (al, idx) { %>
              <tr>
                <td class="text-center text-muted small"><%= idx + 1 %></td>
                <td>
                  <span class="fw-semibold">Installment #<%= al.installmentNumber %></span>
                  <% if (al.wasFullySettled) { %>
                    <span class="badge text-bg-success ms-1" style="font-size:0.65rem;">Fully Settled</span>
                  <% } else { %>
                    <span class="badge text-bg-warning ms-1" style="font-size:0.65rem;">Partial</span>
                  <% } %>
                </td>
                <td class="text-end font-monospace"><%= formatPKR(al.principalPaidPaisa || 0) %></td>
                <td class="text-end font-monospace text-danger small"><%= al.lateFeePaidPaisa ? formatPKR(al.lateFeePaidPaisa) : '—' %></td>
                <td class="text-end font-monospace fw-bold text-dark"><%= formatPKR(al.totalAllocatedPaisa || 0) %></td>
              </tr>
            <% }); %>

            <% if (payment.excessAdvancePaisa > 0) { %>
              <tr class="table-info-subtle">
                <td class="text-center small"><i class="bi bi-arrow-right-circle"></i></td>
                <td colspan="3" class="fw-bold text-primary">Advance Overpayment (Credited to future installments)</td>
                <td class="text-end font-monospace fw-bold text-primary"><%= formatPKR(payment.excessAdvancePaisa) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Remaining Plan Balance Summary -->
      <div class="row justify-content-end mb-4">
        <div class="col-12 col-md-5">
          <div class="p-3 bg-light rounded border small">
            <div class="d-flex justify-content-between text-muted mb-1">
              <span>Total Received:</span>
              <strong class="font-monospace text-dark"><%= formatPKR(payment.amountPaisa) %></strong>
            </div>
            <div class="d-flex justify-content-between mt-2 pt-2 border-top">
              <span class="fw-bold text-dark">Remaining Plan Balance:</span>
              <strong class="font-monospace text-danger fs-6"><%= formatPKR(payment.remainingPlanBalancePaisa) %></strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Signatures Footer -->
      <div class="row pt-4 mt-4 border-top">
        <div class="col-6">
          <div class="small text-muted">
            <em>Computer generated official receipt.</em><br>
            Received by: <strong><%= payment.receivedBy ? payment.receivedBy.name : 'Authorized Staff' %></strong>
          </div>
        </div>
        <div class="col-6 text-end">
          <div style="border-top: 1px dashed #94a3b8; display: inline-block; width: 190px; text-align: center; padding-top: 5px;">
            <div class="small fw-bold text-dark"><%= settings.companyName || 'Authorized Signatory' %></div>
            <div class="text-muted" style="font-size: 0.7rem;">Cashier / Official Stamp</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
@media print {
  body * {
    visibility: hidden;
  }
  .print-voucher, .print-voucher * {
    visibility: visible;
  }
  .print-voucher {
    position: absolute;
    left: 0;
    top: 0;
    width: 100% !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }
}
</style>
