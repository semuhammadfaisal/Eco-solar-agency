<%- include('../partials/page-header', {
  heading: 'Payment Receipts',
  subheading: 'Audited log of official installment payment receipts, banking references, and customer acknowledgments.',
  actions: [
    { label: 'Installment plans', url: '/installments', icon: 'bi-calendar3-range', class: 'btn-outline-primary' },
    { label: 'Collection calendar', url: '/installments/calendar', icon: 'bi-calendar-event', class: 'btn-outline-secondary' }
  ]
}) %>

<!-- Search & Filter Card -->
<div class="card app-card mb-3">
  <div class="card-body p-3">
    <form method="GET" action="/installments/receipts" class="row g-2 align-items-center">
      <div class="col-12 col-md-8">
        <div class="input-group">
          <span class="input-group-text bg-transparent text-muted"><i class="bi bi-search"></i></span>
          <input type="text" class="form-control" name="search" value="<%= filters.search %>"
                 placeholder="Search by receipt # (e.g. RC-0001) or cheque/reference #…">
        </div>
      </div>
      <div class="col-12 col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">
          <i class="bi bi-funnel me-1"></i>Search
        </button>
        <% if (filters.search) { %>
          <a href="/installments/receipts" class="btn btn-outline-secondary" title="Clear search">
            <i class="bi bi-x-lg"></i>
          </a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Receipts Table -->
<div class="card app-card">
  <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
    <h3 class="h6 fw-bold mb-0 text-primary">
      <i class="bi bi-receipt-cutoff me-1"></i>Issued Payment Receipts (<%= total %>)
    </h3>
  </div>

  <% if (!receipts || !receipts.length) { %>
    <div class="card-body text-center py-5 text-muted">
      <i class="bi bi-receipt fs-1 d-block mb-2 text-muted"></i>
      <h4 class="h6 fw-semibold text-dark">No payment receipts found</h4>
      <p class="small mb-0">Receipts are automatically generated when installment or contract payments are collected.</p>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 app-table">
        <thead class="table-light">
          <tr>
            <th>Receipt #</th>
            <th>Customer</th>
            <th>Plan #</th>
            <th>Method</th>
            <th>Reference</th>
            <th>Payment Date</th>
            <th class="text-end">Amount Paid</th>
            <th>Received By</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% receipts.forEach(function (pmt) { %>
            <tr>
              <td>
                <a href="/installments/receipts/<%= pmt._id %>" class="font-monospace fw-bold text-decoration-none">
                  <%= pmt.receiptNumber %>
                </a>
              </td>
              <td>
                <% if (pmt.customer) { %>
                  <a href="/customers/<%= pmt.customer._id %>" class="fw-semibold text-body">
                    <%= pmt.customer.name %>
                  </a>
                  <div class="text-muted small"><%= pmt.customer.phone %></div>
                <% } else { %>—<% } %>
              </td>
              <td>
                <% if (pmt.installmentPlan) { %>
                  <a href="/installments/<%= pmt.installmentPlan._id %>" class="font-monospace small">
                    <%= pmt.installmentPlan.planNumber %>
                  </a>
                <% } else { %>—<% } %>
              </td>
              <td>
                <span class="badge text-bg-light border text-uppercase" style="font-size:0.7rem;">
                  <%= installments.PAYMENT_METHOD_LABELS[pmt.paymentMethod] || pmt.paymentMethod %>
                </span>
              </td>
              <td class="small text-muted"><%= pmt.reference || '—' %></td>
              <td class="small text-muted"><%= formatDate(pmt.paymentDate) %></td>
              <td class="text-end font-monospace fw-bold text-success"><%= formatPKR(pmt.amountPaisa) %></td>
              <td class="small text-muted"><%= pmt.receivedBy ? pmt.receivedBy.name : '—' %></td>
              <td class="text-end">
                <div class="btn-group btn-group-sm">
                  <a href="/installments/receipts/<%= pmt._id %>" class="btn btn-outline-primary" title="View Receipt">
                    <i class="bi bi-eye"></i>
                  </a>
                  <a href="/installments/receipts/<%= pmt._id %>/pdf" target="_blank" class="btn btn-outline-secondary" title="Download PDF">
                    <i class="bi bi-file-earmark-pdf"></i>
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (pagination && pagination.pages > 1) { %>
      <div class="card-footer bg-transparent py-3">
        <%- include('../partials/pagination', { pagination: pagination, url: '/installments/receipts' }) %>
      </div>
    <% } %>
  <% } %>
</div>
