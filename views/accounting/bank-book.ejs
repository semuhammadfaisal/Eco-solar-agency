<%- include('../partials/page-header', {
  heading: 'Bank Book Register (Account 1020)',
  subheading: 'Bank Alfalah business checking account ledger tracking customer online transfers, cleared cheques, and vendor payments.',
  actions: [
    { label: 'Download PDF', url: `/accounting/bank-book?from=${filters.from || ''}&to=${filters.to || ''}&format=pdf`, icon: 'bi-file-earmark-pdf', class: 'btn-outline-danger' },
    { label: 'Export CSV', url: `/accounting/bank-book?from=${filters.from || ''}&to=${filters.to || ''}&format=csv`, icon: 'bi-file-earmark-spreadsheet', class: 'btn-outline-success' },
    { label: 'Cheque Register', url: '/installments/cheques', icon: 'bi-journal-check', class: 'btn-outline-primary' }
  ]
}) %>

<!-- Date Filter Form -->
<div class="card app-card mb-4 shadow-sm">
  <div class="card-body p-3">
    <form method="GET" action="/accounting/bank-book" class="row g-2 align-items-end">
      <div class="col-12 col-md-4">
        <label class="form-label small fw-semibold">From Date</label>
        <input type="date" name="from" value="<%= filters.from || '' %>" class="form-control form-control-sm">
      </div>
      <div class="col-12 col-md-4">
        <label class="form-label small fw-semibold">To Date</label>
        <input type="date" name="to" value="<%= filters.to || '' %>" class="form-control form-control-sm">
      </div>
      <div class="col-12 col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-dark w-100"><i class="bi bi-funnel me-1"></i>Filter Ledger</button>
        <a href="/accounting/bank-book" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></a>
      </div>
    </form>
  </div>
</div>

<!-- Ledger Summary Ribbon -->
<div class="row g-3 mb-4">
  <div class="col-12 col-md-3">
    <div class="card app-card p-3 border-secondary-subtle">
      <div class="small text-muted text-uppercase fw-semibold">Opening Balance</div>
      <div class="fs-4 fw-bold text-dark"><%= formatPKR(bankBook.openingBalancePaisa) %></div>
      <div class="small text-muted">Carried forward</div>
    </div>
  </div>
  <div class="col-12 col-md-3">
    <div class="card app-card p-3 border-success-subtle">
      <div class="small text-muted text-uppercase fw-semibold">Total Deposits (Debits)</div>
      <div class="fs-4 fw-bold text-success">+<%= formatPKR(bankBook.periodDebitPaisa) %></div>
      <div class="small text-muted">Cleared cheques &amp; wire in</div>
    </div>
  </div>
  <div class="col-12 col-md-3">
    <div class="card app-card p-3 border-danger-subtle">
      <div class="small text-muted text-uppercase fw-semibold">Total Outflows (Credits)</div>
      <div class="fs-4 fw-bold text-danger">-<%= formatPKR(bankBook.periodCreditPaisa) %></div>
      <div class="small text-muted">Supplier payments &amp; payroll</div>
    </div>
  </div>
  <div class="col-12 col-md-3">
    <div class="card app-card p-3 border-primary-subtle bg-primary-subtle">
      <div class="small text-primary-emphasis text-uppercase fw-semibold">Closing Bank Balance</div>
      <div class="fs-4 fw-bold text-primary"><%= formatPKR(bankBook.closingBalancePaisa) %></div>
      <div class="small text-primary-emphasis">Current book balance</div>
    </div>
  </div>
</div>

<!-- Chronological Ledger Table -->
<div class="card app-card shadow-sm mb-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 app-table">
      <thead class="table-light">
        <tr>
          <th>Date</th>
          <th>Reference #</th>
          <th>Particulars / Memo</th>
          <th class="text-end text-success">Deposits (Dr)</th>
          <th class="text-end text-danger">Withdrawals (Cr)</th>
          <th class="text-end">Running Balance</th>
        </tr>
      </thead>
      <tbody>
        <tr class="table-light text-muted small fw-semibold">
          <td colspan="3"><i class="bi bi-arrow-right-short me-1"></i>OPENING BALANCE BROUGHT FORWARD</td>
          <td class="text-end">—</td>
          <td class="text-end">—</td>
          <td class="text-end font-monospace"><%= formatPKR(bankBook.openingBalancePaisa) %></td>
        </tr>
        <% if (bankBook.transactions && bankBook.transactions.length) { %>
          <% bankBook.transactions.forEach(function(tx) { %>
            <tr>
              <td><%= formatDate(tx.date) %></td>
              <td class="font-monospace fw-bold text-dark"><%= tx.entryNumber %></td>
              <td>
                <div class="fw-semibold text-dark"><%= tx.memo %></div>
                <% if (tx.description && tx.description !== tx.memo) { %>
                  <div class="small text-muted"><%= tx.description %></div>
                <% } %>
              </td>
              <td class="text-end font-monospace text-success fw-semibold">
                <%= tx.debitPaisa ? '+' + formatPKR(tx.debitPaisa) : '—' %>
              </td>
              <td class="text-end font-monospace text-danger fw-semibold">
                <%= tx.creditPaisa ? '-' + formatPKR(tx.creditPaisa) : '—' %>
              </td>
              <td class="text-end font-monospace fw-bold text-dark">
                <%= formatPKR(tx.runningBalancePaisa) %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              No bank transactions recorded during this date range.
            </td>
          </tr>
        <% } %>
      </tbody>
      <tfoot class="table-light fw-bold">
        <tr>
          <td colspan="3">CLOSING BANK BALANCE</td>
          <td class="text-end text-success">+<%= formatPKR(bankBook.periodDebitPaisa) %></td>
          <td class="text-end text-danger">-<%= formatPKR(bankBook.periodCreditPaisa) %></td>
          <td class="text-end text-primary font-monospace fs-6"><%= formatPKR(bankBook.closingBalancePaisa) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
