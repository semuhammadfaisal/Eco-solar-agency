<%- include('../partials/page-header', {
  heading: 'Staff Salary & Sales Commission Sheet',
  subheading: 'Monthly staff payroll, attendance records, performance-based sales commission calculations, and disbursement vouchers.',
  actions: [
    { label: 'Disburse Payout', url: '#', icon: 'bi-cash-coin', class: 'btn-primary', modal: '#disburseModal' },
    { label: 'Employees', url: '/employees', icon: 'bi-person-badge', class: 'btn-outline-secondary' }
  ]
}) %>

<!-- Month Filter Bar -->
<div class="card app-card mb-4 shadow-sm">
  <div class="card-body p-3">
    <form method="GET" action="/accounting/salary-sheet" class="row g-2 align-items-end">
      <div class="col-12 col-md-5">
        <label class="form-label small fw-semibold">Month</label>
        <select name="month" class="form-select form-select-sm" onchange="this.form.submit()">
          <% 
            const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
            monthNames.forEach(function(mName, idx) { 
          %>
            <option value="<%= idx %>" <%= selectedMonth === idx ? 'selected' : '' %>><%= mName %></option>
          <% }); %>
        </select>
      </div>

      <div class="col-12 col-md-5">
        <label class="form-label small fw-semibold">Year</label>
        <select name="year" class="form-select form-select-sm" onchange="this.form.submit()">
          <% for (let y = 2024; y <= 2028; y++) { %>
            <option value="<%= y %>" <%= selectedYear === y ? 'selected' : '' %>><%= y %></option>
          <% } %>
        </select>
      </div>

      <div class="col-12 col-md-2">
        <button type="submit" class="btn btn-sm btn-dark w-100"><i class="bi bi-funnel me-1"></i>Load Sheet</button>
      </div>
    </form>
  </div>
</div>

<!-- Payroll Totals Ribbon -->
<div class="row g-3 mb-4">
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card app-card p-3 border-secondary-subtle">
      <div class="small text-muted text-uppercase fw-semibold">Total Base Salaries</div>
      <div class="fs-4 fw-bold text-dark"><%= formatPKR(sheet.totalBaseSalaryPaisa) %></div>
      <div class="small text-muted">Fixed monthly wages</div>
    </div>
  </div>
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card app-card p-3 border-info-subtle">
      <div class="small text-muted text-uppercase fw-semibold">Total Sales Commissions</div>
      <div class="fs-4 fw-bold text-info">+<%= formatPKR(sheet.totalCommissionPaisa) %></div>
      <div class="small text-muted">Won projects bonus</div>
    </div>
  </div>
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card app-card p-3 border-success-subtle">
      <div class="small text-muted text-uppercase fw-semibold">Total Disbursed</div>
      <div class="fs-4 fw-bold text-success"><%= formatPKR(sheet.totalDisbursedPaisa) %></div>
      <div class="small text-muted">Paid to date</div>
    </div>
  </div>
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card app-card p-3 border-danger-subtle bg-danger-subtle">
      <div class="small text-danger-emphasis text-uppercase fw-semibold">Net Outstanding Payable</div>
      <div class="fs-4 fw-bold text-danger"><%= formatPKR(sheet.totalNetPayablePaisa) %></div>
      <div class="small text-danger-emphasis">Pending disbursement</div>
    </div>
  </div>
</div>

<!-- Payroll Sheet Table -->
<div class="card app-card shadow-sm mb-4">
  <div class="card-header bg-body-tertiary py-3 d-flex justify-content-between align-items-center">
    <h2 class="h6 fw-bold mb-0"><i class="bi bi-table me-2"></i>Staff Payroll &amp; Commission Roster — <%= sheet.periodLabel %></h2>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 app-table">
      <thead class="table-light">
        <tr>
          <th>Staff Member</th>
          <th>Designation</th>
          <th class="text-end">Base Salary</th>
          <th class="text-center">Days</th>
          <th class="text-end">Won Sales</th>
          <th class="text-end">Commission</th>
          <th class="text-end">Total Earned</th>
          <th class="text-end">Disbursed</th>
          <th class="text-end">Net Payable</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (sheet.rows && sheet.rows.length) { %>
          <% sheet.rows.forEach(function(row) { %>
            <tr>
              <td>
                <div class="fw-bold text-dark"><%= row.name %></div>
                <div class="small text-muted font-monospace"><%= row.employeeCode || 'EMP' %></div>
              </td>
              <td><span class="badge text-bg-light border"><%= row.designation || 'Staff' %></span></td>
              <td class="text-end font-monospace"><%= formatPKR(row.baseSalaryPaisa) %></td>
              <td class="text-center"><span class="badge bg-light text-dark border"><%= row.presentDays %></span></td>
              <td class="text-end font-monospace small">
                <% if (row.wonSalesCount > 0) { %>
                  <%= formatPKR(row.wonSalesVolumePaisa) %> (<%= row.wonSalesCount %>)
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td class="text-end font-monospace text-info fw-semibold">
                <%= row.commissionEarnedPaisa ? '+' + formatPKR(row.commissionEarnedPaisa) : '—' %>
              </td>
              <td class="text-end font-monospace fw-bold text-dark">
                <%= formatPKR(row.totalEarnedPaisa) %>
              </td>
              <td class="text-end font-monospace text-success">
                <%= formatPKR(row.disbursedPaisa) %>
              </td>
              <td class="text-end font-monospace fw-bold <%= row.netPayablePaisa > 0 ? 'text-danger' : 'text-muted' %>">
                <%= formatPKR(row.netPayablePaisa) %>
              </td>
              <td class="text-end">
                <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2"
                  onclick="openDisburseModal('<%= row._id %>', '<%= row.name %>', '<%= row.netPayablePaisa / 100 %>')">
                  <i class="bi bi-cash me-1"></i>Pay
                </button>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="10" class="text-center py-5 text-muted">No active staff members found.</td>
          </tr>
        <% } %>
      </tbody>
      <tfoot class="table-light fw-bold font-monospace">
        <tr>
          <td colspan="2">ROSTER TOTALS</td>
          <td class="text-end"><%= formatPKR(sheet.totalBaseSalaryPaisa) %></td>
          <td></td>
          <td></td>
          <td class="text-end text-info">+<%= formatPKR(sheet.totalCommissionPaisa) %></td>
          <td class="text-end text-dark"><%= formatPKR(sheet.totalEarnedPaisa) %></td>
          <td class="text-end text-success"><%= formatPKR(sheet.totalDisbursedPaisa) %></td>
          <td class="text-end text-danger"><%= formatPKR(sheet.totalNetPayablePaisa) %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<!-- Modal: Disburse Payout -->
<div class="modal fade" id="disburseModal" tabindex="-1" aria-labelledby="disburseModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form method="POST" action="/accounting/salary-sheet/disburse">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="disburseModalLabel"><i class="bi bi-cash-stack text-primary me-2"></i>Disburse Salary / Commission</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Employee <span class="text-danger">*</span></label>
            <select name="employeeId" id="modalEmployeeId" class="form-select" required>
              <option value="">Select Employee...</option>
              <% employees.forEach(function(e) { %>
                <option value="<%= e._id %>"><%= e.name %> (<%= e.employeeCode || 'Staff' %>)</option>
              <% }); %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Disbursement Type <span class="text-danger">*</span></label>
            <select name="disbursementType" class="form-select" required>
              <option value="salary">Monthly Base Salary</option>
              <option value="commission">Sales Performance Commission</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Payment Source <span class="text-danger">*</span></label>
            <select name="paymentAccountCode" class="form-select" required>
              <% paymentAccounts.forEach(function(acc) { %>
                <option value="<%= acc.code %>" <%= acc.code === '1020' ? 'selected' : '' %>>
                  <%= acc.code %> - <%= acc.name %>
                </option>
              <% }); %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Amount to Disburse (PKR) <span class="text-danger">*</span></label>
            <input type="text" name="amount" id="modalAmount" class="form-control" placeholder="e.g. 50,000" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Notes / Transaction Ref</label>
            <input type="text" name="notes" class="form-control" placeholder="Cheque # / Online transfer reference" maxlength="500">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Confirm Disbursement</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openDisburseModal(empId, empName, defaultAmount) {
    const empSelect = document.getElementById('modalEmployeeId');
    if (empSelect) empSelect.value = empId;
    const amtInput = document.getElementById('modalAmount');
    if (amtInput && defaultAmount > 0) amtInput.value = defaultAmount;
    const modalEl = document.getElementById('disburseModal');
    if (modalEl) {
      const modal = new bootstrap.Modal(modalEl);
      modal.show();
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    const trigger = document.querySelector('[data-bs-target="#disburseModal"]') || document.querySelector('a[href="#disburseModal"]');
    if (trigger) {
      trigger.setAttribute('data-bs-toggle', 'modal');
    }
  });
</script>
