<%- include('../partials/page-header', {
  heading: 'Accounts Payable (AP) Ledger',
  subheading: 'Outstanding supplier bills for tier-1 solar panels, on-grid & hybrid inverters, batteries, and mounting hardware.',
  actions: [
    { label: 'Export CSV', url: '/accounting/payables?format=csv', icon: 'bi-file-earmark-spreadsheet', class: 'btn-outline-success' },
    { label: 'Pay Supplier', url: '/accounting/supplier-payments', icon: 'bi-credit-card', class: 'btn-primary' },
    { label: 'Purchases', url: '/purchases', icon: 'bi-receipt', class: 'btn-outline-secondary' }
  ]
}) %>

<!-- Summary Ribbon -->
<div class="row g-3 mb-4">
  <div class="col-12 col-md-4">
    <div class="card app-card p-3 border-warning-subtle bg-warning-subtle">
      <div class="small text-warning-emphasis text-uppercase fw-semibold">Total Accounts Payable (Vendors)</div>
      <div class="fs-4 fw-bold text-warning-emphasis"><%= formatPKR(payables.totalPayablePaisa) %></div>
      <div class="small text-warning-emphasis"><%= payables.rows.length %> Suppliers awaiting payment</div>
    </div>
  </div>
</div>

<!-- Payables Listing Table -->
<div class="card app-card shadow-sm mb-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 app-table">
      <thead class="table-light">
        <tr>
          <th>Supplier</th>
          <th>Contact</th>
          <th class="text-center">Orders</th>
          <th class="text-end">Total Purchases</th>
          <th class="text-end">Total Paid</th>
          <th class="text-end">Balance Due</th>
          <th class="text-center">Days Overdue</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (payables.rows && payables.rows.length) { %>
          <% payables.rows.forEach(function(r) { %>
            <tr>
              <td>
                <div class="fw-bold text-dark"><%= r.supplier ? r.supplier.name : 'Supplier' %></div>
                <div class="small text-muted font-monospace"><%= r.supplier ? r.supplier.code : '' %></div>
              </td>
              <td>
                <div><%= r.supplier ? r.supplier.phone : '—' %></div>
                <div class="small text-muted"><%= r.supplier ? r.supplier.contactPerson : '' %></div>
              </td>
              <td class="text-center"><span class="badge bg-light text-dark border"><%= r.ordersCount %></span></td>
              <td class="text-end font-monospace text-muted"><%= formatPKR(r.totalPurchasesPaisa) %></td>
              <td class="text-end font-monospace text-success"><%= formatPKR(r.totalPaidPaisa) %></td>
              <td class="text-end font-monospace fw-bold text-danger"><%= formatPKR(r.balanceDuePaisa) %></td>
              <td class="text-center">
                <% if (r.daysOverdue > 0) { %>
                  <span class="badge <%= r.daysOverdue > 60 ? 'bg-danger' : (r.daysOverdue > 30 ? 'bg-warning text-dark' : 'bg-secondary') %>">
                    <%= r.daysOverdue %>d
                  </span>
                <% } else { %>
                  <span class="badge bg-success-subtle text-success">Current</span>
                <% } %>
              </td>
              <td class="text-end">
                <a href="/accounting/supplier-payments" class="btn btn-sm btn-outline-primary py-1 px-2" title="Record Payment">
                  <i class="bi bi-credit-card me-1"></i>Pay
                </a>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="8" class="text-center py-5 text-muted">
              All supplier bills are completely settled. No outstanding payables.
            </td>
          </tr>
        <% } %>
      </tbody>
      <tfoot class="table-light fw-bold font-monospace">
        <tr>
          <td colspan="5">TOTAL PAYABLE TO SUPPLIERS</td>
          <td class="text-end text-danger fs-6"><%= formatPKR(payables.totalPayablePaisa) %></td>
          <td colspan="2"></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
