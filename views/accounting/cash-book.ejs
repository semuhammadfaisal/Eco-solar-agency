<%- include('../partials/page-header', {
  heading: 'Cash in Hand Book (Account 1010)',
  subheading: 'Physical cash drawer register recording showroom customer collections, counter receipts, petty cash, and daily disbursements.',
  actions: [
    { label: 'Download PDF', url: `/accounting/cash-book?from=${filters.from || ''}&to=${filters.to || ''}&format=pdf`, icon: 'bi-file-earmark-pdf', class: 'btn-outline-danger' },
    { label: 'Export CSV', url: `/accounting/cash-book?from=${filters.from || ''}&to=${filters.to || ''}&format=csv`, icon: 'bi-file-earmark-spreadsheet', class: 'btn-outline-success' },
    { label: 'Record Expense', url: '/accounting/expenses', icon: 'bi-wallet2', class: 'btn-primary' }
  ]
}) %>

<!-- Date Filter Form -->
<div class="card app-card mb-4 shadow-sm">
  <div class="card-body p-3">
    <form method="GET" action="/accounting/cash-book" class="row g-2 align-items-end">
      <div class="col-12 col-md-4">
        <label class="form-label small fw-semibold">From Date</label>
        <input type="date" name="from" value="<%= filters.from || '' %>" class="form-control form-control-sm">
      </div>
      <div class="col-12 col-md-4">
        <label class="form-label small fw-semibold">To Date</label>
        <input type="date" name="to" value="<%= filters.to || '' %>" class="form-control form-control-sm">
      </div>
      <div class="col-12 col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-dark w-100"><i class="bi bi-funnel me-1"></i>Filter Ledger</button>
        <a href="/accounting/cash-book" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></a>
      </div>
    </form>
  </div>
</div>

<!-- Ledger Summary Ribbon -->
<div class="row g-3 mb-4">
  <div class="col-12 col-md-3">
    <div class="card app-card p-3 border-secondary-subtle">
      <div class="small text-muted text-uppercase fw-semibold">Opening Balance</div>
      <div class="fs-4 fw-bold text-dark"><%= formatPKR(cashBook.openingBalancePaisa) %></div>
      <div class="small text-muted">Carried forward</div>
    </div>
  </div>
  <div class="col-12 col-md-3">
    <div class="card app-card p-3 border-success-subtle">
      <div class="small text-muted text-uppercase fw-semibold">Total Cash IN (Debits)</div>
      <div class="fs-4 fw-bold text-success">+<%= formatPKR(cashBook.periodDebitPaisa) %></div>
      <div class="small text-muted">Collections &amp; receipts</div>
    </div>
  </div>
  <div class="col-12 col-md-3">
    <div class="card app-card p-3 border-danger-subtle">
      <div class="small text-muted text-uppercase fw-semibold">Total Cash OUT (Credits)</div>
      <div class="fs-4 fw-bold text-danger">-<%= formatPKR(cashBook.periodCreditPaisa) %></div>
      <div class="small text-muted">Expenses &amp; wages paid</div>
    </div>
  </div>
  <div class="col-12 col-md-3">
    <div class="card app-card p-3 border-primary-subtle bg-primary-subtle">
      <div class="small text-primary-emphasis text-uppercase fw-semibold">Closing Physical Cash</div>
      <div class="fs-4 fw-bold text-primary"><%= formatPKR(cashBook.closingBalancePaisa) %></div>
      <div class="small text-primary-emphasis">Expected in drawer / safe</div>
    </div>
  </div>
</div>

<!-- Chronological Ledger Table -->
<div class="card app-card shadow-sm mb-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 app-table">
      <thead class="table-light">
        <tr>
          <th>Date</th>
          <th>Voucher #</th>
          <th>Particulars / Memo</th>
          <th class="text-end text-success">Cash IN (Dr)</th>
          <th class="text-end text-danger">Cash OUT (Cr)</th>
          <th class="text-end">Running Balance</th>
        </tr>
      </thead>
      <tbody>
        <tr class="table-light text-muted small fw-semibold">
          <td colspan="3"><i class="bi bi-arrow-right-short me-1"></i>OPENING BALANCE BROUGHT FORWARD</td>
          <td class="text-end">—</td>
          <td class="text-end">—</td>
          <td class="text-end font-monospace"><%= formatPKR(cashBook.openingBalancePaisa) %></td>
        </tr>
        <% if (cashBook.transactions && cashBook.transactions.length) { %>
          <% cashBook.transactions.forEach(function(tx) { %>
            <tr>
              <td><%= formatDate(tx.date) %></td>
              <td class="font-monospace fw-bold text-dark"><%= tx.entryNumber %></td>
              <td>
                <div class="fw-semibold text-dark"><%= tx.memo %></div>
                <% if (tx.description && tx.description !== tx.memo) { %>
                  <div class="small text-muted"><%= tx.description %></div>
                <% } %>
              </td>
              <td class="text-end font-monospace text-success fw-semibold">
                <%= tx.debitPaisa ? '+' + formatPKR(tx.debitPaisa) : '—' %>
              </td>
              <td class="text-end font-monospace text-danger fw-semibold">
                <%= tx.creditPaisa ? '-' + formatPKR(tx.creditPaisa) : '—' %>
              </td>
              <td class="text-end font-monospace fw-bold text-dark">
                <%= formatPKR(tx.runningBalancePaisa) %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              No cash transactions recorded during this date range.
            </td>
          </tr>
        <% } %>
      </tbody>
      <tfoot class="table-light fw-bold">
        <tr>
          <td colspan="3">CLOSING CASH DRAWER BALANCE</td>
          <td class="text-end text-success">+<%= formatPKR(cashBook.periodDebitPaisa) %></td>
          <td class="text-end text-danger">-<%= formatPKR(cashBook.periodCreditPaisa) %></td>
          <td class="text-end text-primary font-monospace fs-6"><%= formatPKR(cashBook.closingBalancePaisa) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
