<%- include('../partials/page-header', {
  heading: 'Profit & Loss Statement (Income Statement)',
  subheading: 'Commercial financial performance, gross profitability margins, cost of goods sold, and net operational earnings.',
  actions: [
    { label: 'Download PDF', url: `/accounting/profit-loss?from=${filters.from || ''}&to=${filters.to || ''}&format=pdf`, icon: 'bi-file-earmark-pdf', class: 'btn-outline-danger' },
    { label: 'Export CSV', url: `/accounting/profit-loss?from=${filters.from || ''}&to=${filters.to || ''}&format=csv`, icon: 'bi-file-earmark-spreadsheet', class: 'btn-outline-success' },
    { label: 'Trial Balance', url: '/accounting/trial-balance', icon: 'bi-scale', class: 'btn-outline-secondary' }
  ]
}) %>

<!-- Date Range Filter -->
<div class="card app-card mb-4 shadow-sm">
  <div class="card-body p-3">
    <form method="GET" action="/accounting/profit-loss" class="row g-2 align-items-end">
      <div class="col-12 col-md-4">
        <label class="form-label small fw-semibold">From Date</label>
        <input type="date" name="from" value="<%= filters.from || '' %>" class="form-control form-control-sm">
      </div>
      <div class="col-12 col-md-4">
        <label class="form-label small fw-semibold">To Date</label>
        <input type="date" name="to" value="<%= filters.to || '' %>" class="form-control form-control-sm">
      </div>
      <div class="col-12 col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-dark w-100"><i class="bi bi-funnel me-1"></i>Generate P&amp;L</button>
        <a href="/accounting/profit-loss" class="btn btn-sm btn-outline-secondary">All Time</a>
      </div>
    </form>
  </div>
</div>

<!-- Statement Content Card -->
<div class="card app-card shadow-sm mb-4">
  <div class="card-body p-4">
    <!-- SECTION 1: OPERATING REVENUE -->
    <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3">
      <h3 class="h6 fw-bold text-success mb-0 text-uppercase">
        <i class="bi bi-arrow-down-left-circle me-2"></i>1. Operating Revenue &amp; Income
      </h3>
      <span class="fs-5 fw-bold text-success font-monospace">+<%= formatPKR(pnl.totalIncomePaisa) %></span>
    </div>
    <div class="table-responsive mb-4">
      <table class="table table-sm align-middle mb-0">
        <tbody>
          <% if (pnl.incomeItems && pnl.incomeItems.length) { %>
            <% pnl.incomeItems.forEach(function(item) { %>
              <tr>
                <td style="width: 80px;" class="font-monospace text-muted small"><%= item.code %></td>
                <td><%= item.name %></td>
                <td class="text-end font-monospace text-dark fw-semibold"><%= formatPKR(item.amountPaisa) %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="3" class="text-muted small">No revenue booked in this period.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- SECTION 2: COST OF GOODS SOLD -->
    <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3">
      <h3 class="h6 fw-bold text-warning-emphasis mb-0 text-uppercase">
        <i class="bi bi-box-seam me-2"></i>2. Cost of Goods Sold (COGS)
      </h3>
      <span class="fs-5 fw-bold text-danger font-monospace">-<%= formatPKR(pnl.totalCogsPaisa) %></span>
    </div>
    <div class="table-responsive mb-4">
      <table class="table table-sm align-middle mb-0">
        <tbody>
          <% if (pnl.cogsItems && pnl.cogsItems.length) { %>
            <% pnl.cogsItems.forEach(function(item) { %>
              <tr>
                <td style="width: 80px;" class="font-monospace text-muted small"><%= item.code %></td>
                <td><%= item.name %></td>
                <td class="text-end font-monospace text-danger"><%= formatPKR(item.amountPaisa) %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="3" class="text-muted small">No cost of goods sold recorded.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- GROSS PROFIT HIGHLIGHT -->
    <div class="p-3 bg-light rounded border border-primary-subtle d-flex justify-content-between align-items-center mb-4">
      <div>
        <div class="fw-bold text-primary fs-6">GROSS OPERATING PROFIT</div>
        <div class="small text-muted">Revenue minus direct hardware and installation costs</div>
      </div>
      <div class="text-end">
        <div class="fs-4 fw-bold text-primary font-monospace"><%= formatPKR(pnl.grossProfitPaisa) %></div>
        <span class="badge text-bg-primary"><%= pnl.grossMarginPercent %>% Gross Margin</span>
      </div>
    </div>

    <!-- SECTION 3: OPERATING EXPENSES -->
    <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3">
      <h3 class="h6 fw-bold text-secondary mb-0 text-uppercase">
        <i class="bi bi-wallet2 me-2"></i>3. Operating Expenses (OPEX)
      </h3>
      <span class="fs-5 fw-bold text-danger font-monospace">-<%= formatPKR(pnl.totalOperatingExpensePaisa) %></span>
    </div>
    <div class="table-responsive mb-4">
      <table class="table table-sm align-middle mb-0">
        <tbody>
          <% if (pnl.operatingExpenseItems && pnl.operatingExpenseItems.length) { %>
            <% pnl.operatingExpenseItems.forEach(function(item) { %>
              <tr>
                <td style="width: 80px;" class="font-monospace text-muted small"><%= item.code %></td>
                <td><%= item.name %></td>
                <td class="text-end font-monospace text-danger"><%= formatPKR(item.amountPaisa) %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="3" class="text-muted small">No operating expenses recorded.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- NET PROFIT HIGHLIGHT -->
    <div class="p-4 rounded border <%= pnl.netProfitPaisa >= 0 ? 'bg-success-subtle border-success' : 'bg-danger-subtle border-danger' %> d-flex justify-content-between align-items-center">
      <div>
        <div class="fw-bold fs-5 <%= pnl.netProfitPaisa >= 0 ? 'text-success-emphasis' : 'text-danger-emphasis' %>">
          NET OPERATING <%= pnl.netProfitPaisa >= 0 ? 'PROFIT' : 'LOSS' %>
        </div>
        <div class="small <%= pnl.netProfitPaisa >= 0 ? 'text-success' : 'text-danger' %>">
          Bottom line earnings after all direct costs and operating overheads
        </div>
      </div>
      <div class="text-end">
        <div class="fs-3 fw-bold font-monospace <%= pnl.netProfitPaisa >= 0 ? 'text-success' : 'text-danger' %>">
          <%= formatPKR(pnl.netProfitPaisa) %>
        </div>
        <span class="badge <%= pnl.netProfitPaisa >= 0 ? 'bg-success' : 'bg-danger' %> fs-6">
          <%= pnl.netMarginPercent %>% Net Margin
        </span>
      </div>
    </div>
  </div>
</div>
