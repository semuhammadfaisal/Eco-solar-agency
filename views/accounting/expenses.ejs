<%- include('../partials/page-header', {
  heading: 'Operating Expense Register',
  subheading: 'Record showroom rent, fuel, vehicle maintenance, marketing, utilities, and sundry office disbursements.',
  actions: [
    { label: 'New Expense Voucher', url: '#', icon: 'bi-plus-lg', class: 'btn-primary', modal: '#newExpenseModal' },
    { label: 'Cash Book', url: '/accounting/cash-book', icon: 'bi-cash-stack', class: 'btn-outline-secondary' }
  ]
}) %>

<!-- Filter Bar -->
<div class="card app-card mb-4 shadow-sm">
  <div class="card-body p-3">
    <form method="GET" action="/accounting/expenses" class="row g-2 align-items-end">
      <div class="col-12 col-md-3">
        <label class="form-label small fw-semibold">Category Account</label>
        <select name="category" class="form-select form-select-sm">
          <option value="">All Operating Categories</option>
          <% expenseCategories.forEach(function(cat) { %>
            <option value="<%= cat.code %>" <%= filters.category === cat.code ? 'selected' : '' %>>
              <%= cat.code %> - <%= cat.name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-12 col-md-3">
        <label class="form-label small fw-semibold">Payment Source</label>
        <select name="paymentAccount" class="form-select form-select-sm">
          <option value="">All Payment Sources</option>
          <% paymentAccounts.forEach(function(acc) { %>
            <option value="<%= acc.code %>" <%= filters.paymentAccount === acc.code ? 'selected' : '' %>>
              <%= acc.code %> - <%= acc.name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-6 col-md-2">
        <label class="form-label small fw-semibold">From</label>
        <input type="date" name="from" value="<%= filters.from || '' %>" class="form-control form-control-sm">
      </div>

      <div class="col-6 col-md-2">
        <label class="form-label small fw-semibold">To</label>
        <input type="date" name="to" value="<%= filters.to || '' %>" class="form-control form-control-sm">
      </div>

      <div class="col-12 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-dark w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
        <a href="/accounting/expenses" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
      </div>
    </form>
  </div>
</div>

<!-- Expense Listing Table -->
<div class="card app-card shadow-sm mb-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 app-table">
      <thead class="table-light">
        <tr>
          <th>Voucher #</th>
          <th>Date</th>
          <th>Category Account</th>
          <th>Payee</th>
          <th>Payment Account</th>
          <th class="text-end">Amount (PKR)</th>
          <th>Recorded By</th>
          <th>Receipt</th>
        </tr>
      </thead>
      <tbody>
        <% if (expenses && expenses.length) { %>
          <% expenses.forEach(function(exp) { %>
            <tr>
              <td class="font-monospace fw-bold text-dark"><%= exp.voucherNumber %></td>
              <td><%= formatDate(exp.date) %></td>
              <td>
                <span class="badge text-bg-light border text-dark font-monospace me-1"><%= exp.categoryAccount ? exp.categoryAccount.code : '' %></span>
                <%= exp.categoryAccount ? exp.categoryAccount.name : 'Expense' %>
              </td>
              <td>
                <div class="fw-semibold text-dark"><%= exp.payee %></div>
                <% if (exp.notes) { %>
                  <div class="small text-muted text-truncate" style="max-width: 200px;"><%= exp.notes %></div>
                <% } %>
              </td>
              <td>
                <span class="badge <%= (exp.paymentAccount && exp.paymentAccount.code === '1010') ? 'text-bg-success-subtle text-success' : 'text-bg-primary-subtle text-primary' %>">
                  <%= exp.paymentAccount ? exp.paymentAccount.name : 'Cash/Bank' %>
                </span>
              </td>
              <td class="text-end fw-bold text-danger">
                <%= formatPKR(exp.amountPaisa) %>
              </td>
              <td class="small text-muted">
                <%= exp.recordedBy ? exp.recordedBy.name : 'System' %>
              </td>
              <td>
                <% if (exp.receiptAttachment) { %>
                  <a href="<%= exp.receiptAttachment %>" target="_blank" class="btn btn-sm btn-outline-secondary py-0 px-2" title="View attached receipt">
                    <i class="bi bi-paperclip"></i>
                  </a>
                <% } else { %>
                  <span class="text-muted small">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="8" class="text-center py-5 text-muted">
              <i class="bi bi-wallet2 fs-2 d-block mb-2 text-muted"></i>
              No expense vouchers found matching your filters.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% if (pagination && pagination.pages > 1) { %>
    <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center py-3">
      <div class="small text-muted">Showing <%= expenses.length %> of <%= total %> vouchers</div>
      <%- include('../partials/pagination', { pagination, query: filters }) %>
    </div>
  <% } %>
</div>

<!-- Modal: Record New Expense Voucher -->
<div class="modal fade" id="newExpenseModal" tabindex="-1" aria-labelledby="newExpenseModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form method="POST" action="/accounting/expenses" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="newExpenseModalLabel"><i class="bi bi-wallet2 text-primary me-2"></i>Record Operating Expense Voucher</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Expense Category <span class="text-danger">*</span></label>
            <select name="categoryAccountCode" class="form-select" required>
              <option value="">Select Category...</option>
              <% expenseCategories.forEach(function(cat) { %>
                <option value="<%= cat.code %>"><%= cat.code %> - <%= cat.name %></option>
              <% }); %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Payment Source <span class="text-danger">*</span></label>
            <select name="paymentAccountCode" class="form-select" required>
              <% paymentAccounts.forEach(function(acc) { %>
                <option value="<%= acc.code %>"><%= acc.code %> - <%= acc.name %></option>
              <% }); %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Branch (cash drawer)</label>
            <select name="branch" class="form-select">
              <% (branches || []).forEach(function(b) { %>
                <option value="<%= b._id %>" <%= String(b._id) === String(defaultBranchId) ? 'selected' : '' %>>
                  <%= b.code %> — <%= b.name %><%= b.type === 'main' ? ' (Main)' : '' %>
                </option>
              <% }); %>
            </select>
            <div class="form-text">Cash expenses reduce this branch's drawer when the payment source is Cash in Hand.</div>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label fw-semibold">Amount (PKR) <span class="text-danger">*</span></label>
              <input type="text" name="amount" class="form-control" placeholder="e.g. 5,000" required>
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">Date</label>
              <input type="date" name="date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Payee / Recipient <span class="text-danger">*</span></label>
            <input type="text" name="payee" class="form-control" placeholder="Vendor, landlord, fuel station, staff" required maxlength="150">
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Notes / Description</label>
            <textarea name="notes" class="form-control" rows="2" placeholder="Brief explanation of the expense..." maxlength="500"></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Receipt / Bill Attachment</label>
            <input type="file" name="receipt" class="form-control" accept="image/jpeg,image/png,image/webp,application/pdf">
            <div class="form-text">JPG, PNG or PDF (Max 5MB)</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Post Expense Voucher</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // Enable opening modal via hash or action button
  document.addEventListener('DOMContentLoaded', function () {
    const trigger = document.querySelector('[data-bs-target="#newExpenseModal"]') || document.querySelector('a[href="#newExpenseModal"]');
    if (trigger) {
      trigger.setAttribute('data-bs-toggle', 'modal');
    }
  });
</script>
