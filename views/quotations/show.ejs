<%
  var statusBadgeClass = quotations.QUOTATION_STATUS_BADGES[quotation.status] || 'secondary';
  var statusLabel = quotations.QUOTATION_STATUS_LABELS[quotation.status] || quotation.status;
  var fullNumber = quotation.fullNumber || (quotation.quotationNumber + (quotation.revision > 1 ? ' (Rev ' + quotation.revision + ')' : ''));
  var hasSale = Boolean(quotation.sale);
  var saleId = quotation.sale ? (quotation.sale._id || quotation.sale) : null;
%>

<%- include('../partials/page-header', {
  heading: fullNumber,
  subheading: (quotation.customer ? quotation.customer.name : 'Client') + ' · ' + formatQty(quotation.systemSummary ? quotation.systemSummary.capacityKw : 0) + ' kW ' + (systems.SYSTEM_TYPE_LABELS[quotation.systemSummary ? quotation.systemSummary.systemType : 'on_grid'] || 'Solar System') + ' · Created ' + formatDate(quotation.createdAt),
  actions: [
    { label: 'Download PDF', url: '/quotations/' + quotation._id + '/pdf', icon: 'bi-file-earmark-pdf', class: 'btn-primary', target: '_blank' },
    ...(whatsappUrl ? [{ label: 'WhatsApp Share', url: whatsappUrl, icon: 'bi-whatsapp', class: 'btn-success', target: '_blank' }] : []),
    { label: 'Email PDF', url: '#emailQuoteModal', icon: 'bi-envelope', class: 'btn-outline-primary', extra: 'data-bs-toggle="modal" data-bs-target="#emailQuoteModal"' },
    { label: 'Back to quotations', url: '/quotations', icon: 'bi-arrow-left', class: 'btn-outline-secondary' }
  ]
}) %>

<!-- Revision Bar (if multiple revisions exist) -->
<% if (quotation.allRevisions && quotation.allRevisions.length > 1) { %>
  <div class="card app-card mb-3 bg-light border-0">
    <div class="card-body p-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-clock-history text-muted"></i>
        <span class="small fw-semibold text-muted text-uppercase">Revisions:</span>
        <div class="nav nav-pills gap-1">
          <% quotation.allRevisions.forEach(function (rev) { %>
            <a href="/quotations/<%= rev._id %>"
               class="btn btn-sm <%= String(rev._id) === String(quotation._id) ? 'btn-primary active' : 'btn-outline-secondary' %>">
              Rev <%= rev.revision %>
              <span class="badge text-bg-<%= quotations.QUOTATION_STATUS_BADGES[rev.status] || 'secondary' %> ms-1" style="font-size:0.65rem;">
                <%= quotations.QUOTATION_STATUS_LABELS[rev.status] || rev.status %>
              </span>
            </a>
          <% }); %>
        </div>
      </div>
      <% if (quotation.isLatestRevision && quotation.status !== 'approved') { %>
        <form method="POST" action="/quotations/<%= quotation._id %>/duplicate" class="d-inline"
              onsubmit="return confirm('Create a new revision (Rev <%= quotation.revision + 1 %>) based on this quotation?');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-sm btn-outline-dark">
            <i class="bi bi-copy me-1"></i>Duplicate as Rev <%= quotation.revision + 1 %>
          </button>
        </form>
      <% } %>
    </div>
  </div>
<% } %>

<!-- Status Banner / Sale Conversion Notice -->
<% if (quotation.status === 'approved') { %>
  <div class="alert alert-success border-success shadow-sm mt-2 mb-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <div class="fw-bold d-flex align-items-center gap-2">
          <i class="bi bi-check-circle-fill fs-5"></i>
          <span>Quotation Approved &amp; Converted into Project Contract!</span>
        </div>
        <div class="small text-muted mt-1">
          This quotation has been approved by the customer.
          <% if (quotation.sale) { %>
            Invoice: <strong><%= quotation.sale.invoiceNumber || '—' %></strong>
            · Project: <strong><%= quotation.sale.saleNumber || 'Confirmed' %></strong>.
          <% } %>
        </div>
      </div>
      <% if (saleId) { %>
        <a href="/projects/<%= saleId %>" class="btn btn-success btn-sm">
          <i class="bi bi-briefcase me-1"></i>View Confirmed Project
        </a>
      <% } %>
    </div>
  </div>
<% } else if (quotation.status === 'rejected') { %>
  <div class="alert alert-danger border-danger shadow-sm mt-2 mb-3 d-flex align-items-center justify-content-between">
    <div class="small">
      <i class="bi bi-x-circle-fill me-1"></i>
      <strong>Quotation Rejected.</strong>
      <% var latestHistory = quotation.statusHistory && quotation.statusHistory.length ? quotation.statusHistory[quotation.statusHistory.length - 1] : null; %>
      <% if (latestHistory && latestHistory.reason) { %>
        Reason: "<%= latestHistory.reason %>"
      <% } %>
    </div>
    <span class="badge text-bg-danger">Rejected</span>
  </div>
<% } %>

<!-- Sizing, Energy & Financial Metrics Ribbon -->
<div class="row g-2 mb-3">
  <div class="col-6 col-lg-3">
    <div class="card app-card border-primary-subtle text-center p-3 h-100">
      <div class="text-uppercase small text-muted fw-semibold">Capacity</div>
      <div class="display-6 fw-bold text-primary"><%= formatQty(quotation.systemSummary ? quotation.systemSummary.capacityKw : 0) %> kW</div>
      <div class="small text-muted"><%= quotation.systemSummary ? quotation.systemSummary.panelCount : 0 %> Solar Panels</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card border-success-subtle text-center p-3 h-100">
      <div class="text-uppercase small text-muted fw-semibold">Estimated Daily</div>
      <div class="display-6 fw-bold text-success"><%= quotation.systemSummary && quotation.systemSummary.estimatedUnits ? quotation.systemSummary.estimatedUnits.daily : 0 %> units</div>
      <div class="small text-muted">kWh per day avg</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card border-info-subtle text-center p-3 h-100">
      <div class="text-uppercase small text-muted fw-semibold">Monthly Generation</div>
      <div class="display-6 fw-bold text-info"><%= formatQty(quotation.systemSummary && quotation.systemSummary.estimatedUnits ? quotation.systemSummary.estimatedUnits.monthly : 0) %> units</div>
      <div class="small text-muted">Yearly: <%= formatQty(quotation.systemSummary && quotation.systemSummary.estimatedUnits ? quotation.systemSummary.estimatedUnits.yearly : 0) %> kWh</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card border-warning-subtle text-center p-3 h-100">
      <div class="text-uppercase small text-muted fw-semibold">Total Investment</div>
      <div class="display-6 fw-bold text-dark"><%= formatPKR(quotation.finalPricePaisa) %></div>
      <% if (canViewProfit && quotation.netProfitPaisa !== undefined) { %>
        <div class="small <%= quotation.netProfitPaisa < 0 ? 'text-danger' : 'text-success' %> fw-semibold">
          Profit: <%= formatPKR(quotation.netProfitPaisa) %> (<%= quotation.netProfitMarginPercent %>%)
        </div>
      <% } else { %>
        <div class="small text-muted"><%= quotation.paymentOption === 'installment' ? 'Milestone Installments' : '100% Advance Payment' %></div>
      <% } %>
    </div>
  </div>
</div>

<div class="row g-3 mb-3">
  <!-- Customer & Location Card -->
  <div class="col-12 col-lg-6">
    <div class="card app-card h-100">
      <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
        <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
          <i class="bi bi-person-badge"></i> Customer Profile
        </h3>
        <% if (quotation.customer) { %>
          <a href="/customers/<%= quotation.customer._id %>" class="btn btn-sm btn-outline-secondary">View Profile</a>
        <% } %>
      </div>
      <div class="card-body p-3 p-md-4">
        <% if (quotation.customer) { %>
          <dl class="row mb-0 small">
            <dt class="col-4 text-muted fw-normal">Client Name</dt>
            <dd class="col-8 fw-semibold"><%= quotation.customer.name %> (<%= quotation.customer.code %>)</dd>

            <dt class="col-4 text-muted fw-normal">Phone / Mobile</dt>
            <dd class="col-8"><%= quotation.customer.phone %></dd>

            <dt class="col-4 text-muted fw-normal">WhatsApp</dt>
            <dd class="col-8">
              <%= quotation.customer.whatsapp || quotation.customer.phone %>
              <% if (whatsappUrl) { %>
                <a href="<%= whatsappUrl %>" target="_blank" class="badge text-bg-success text-decoration-none ms-1">
                  <i class="bi bi-whatsapp me-1"></i>Chat
                </a>
              <% } %>
            </dd>

            <dt class="col-4 text-muted fw-normal">Address / Area</dt>
            <dd class="col-8"><%= [quotation.customer.address, quotation.customer.city].filter(Boolean).join(', ') || '—' %></dd>

            <dt class="col-4 text-muted fw-normal">DISCO / Ref #</dt>
            <dd class="col-8">
              <%= quotation.customer.disco || '—' %>
              <% if (quotation.customer.electricityReferenceNo) { %>
                · <span class="font-monospace text-muted"><%= quotation.customer.electricityReferenceNo %></span>
              <% } %>
            </dd>
          </dl>
        <% } else { %>
          <div class="text-muted small">No customer linked.</div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Proposal Meta & Sales Representative Card -->
  <div class="col-12 col-lg-6">
    <div class="card app-card h-100">
      <div class="card-header bg-transparent py-3">
        <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
          <i class="bi bi-info-circle"></i> Quotation Metadata
        </h3>
      </div>
      <div class="card-body p-3 p-md-4">
        <dl class="row mb-0 small">
          <dt class="col-4 text-muted fw-normal">Quotation Number</dt>
          <dd class="col-8 font-monospace fw-bold text-dark"><%= quotation.quotationNumber %> (Rev <%= quotation.revision %>)</dd>

          <dt class="col-4 text-muted fw-normal">Quotation Date</dt>
          <dd class="col-8"><%= formatDate(quotation.quotationDate || quotation.createdAt) %></dd>

          <dt class="col-4 text-muted fw-normal">Valid Until</dt>
          <dd class="col-8 fw-semibold text-danger">
            <%= formatDate(quotation.validUntil) %>
            <% if (new Date(quotation.validUntil) < new Date() && quotation.status !== 'approved') { %>
              <span class="badge text-bg-danger ms-1">Expired</span>
            <% } %>
          </dd>

          <dt class="col-4 text-muted fw-normal">Sales Consultant</dt>
          <dd class="col-8"><%= quotation.assignedTo ? quotation.assignedTo.name : 'Unassigned' %></dd>

          <dt class="col-4 text-muted fw-normal">System Config Link</dt>
          <dd class="col-8">
            <% if (quotation.systemConfig) { %>
              <a href="/system-configs/<%= quotation.systemConfig._id || quotation.systemConfig %>" class="font-monospace">
                <%= quotation.systemConfig.number || 'View BOM' %>
              </a>
            <% } else { %>
              <span class="text-muted">Custom Quote</span>
            <% } %>
          </dd>

          <dt class="col-4 text-muted fw-normal">Current Status</dt>
          <dd class="col-8">
            <span class="badge text-bg-<%= statusBadgeClass %> fs-7"><%= statusLabel %></span>
          </dd>
        </dl>
      </div>
    </div>
  </div>
</div>

<!-- Snapshot Bill of Materials / Items Table Card -->
<div class="card app-card mb-3">
  <div class="card-header bg-transparent py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div>
      <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
        <i class="bi bi-box-seam"></i> Itemized Equipment &amp; Bill of Materials
      </h3>
      <p class="text-muted small mb-0">Locked snapshot of items, quantities, and agreed proposal pricing.</p>
    </div>
    <span class="badge text-bg-light border text-muted">
      <%= quotation.items ? quotation.items.length : 0 %> Components
    </span>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 app-table">
      <thead class="table-light">
        <tr>
          <th style="width: 40px;">#</th>
          <th>Item</th>
          <th>Description</th>
          <th>Category</th>
          <th>Brand &amp; Model</th>
          <th class="text-center" style="width: 90px;">Qty</th>
          <th class="text-end" style="width: 140px;">Unit Price</th>
          <th class="text-end" style="width: 140px;">Total Price</th>
          <% if (canViewCosts) { %>
            <th class="text-end" style="width: 130px;">Unit Cost</th>
            <th class="text-end" style="width: 130px;">Total Cost</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% (quotation.items || []).forEach(function (line, idx) { %>
          <tr class="<%= line.isOptionalExtra ? 'table-info-subtle' : '' %>">
            <td class="text-muted small"><%= idx + 1 %></td>
            <td>
              <div class="fw-semibold text-body">
                <%= line.itemSnapshot ? line.itemSnapshot.name : 'Item' %>
                <% if (line.isOptionalExtra) { %>
                  <span class="badge text-bg-info text-white ms-1" style="font-size:0.65rem;">Optional Extra</span>
                <% } %>
              </div>
            </td>
            <td class="small text-muted">
              <%= line.notes || '—' %>
            </td>
            <td>
              <span class="badge text-bg-secondary text-uppercase" style="font-size:0.65rem;">
                <%= line.itemSnapshot ? line.itemSnapshot.category : 'other' %>
              </span>
            </td>
            <td class="small text-muted">
              <%= [line.itemSnapshot ? line.itemSnapshot.brand : '', line.itemSnapshot ? line.itemSnapshot.model : ''].filter(Boolean).join(' ') || '—' %>
              <% if (line.itemSnapshot && line.itemSnapshot.wattage) { %>
                · <span class="fw-medium"><%= line.itemSnapshot.wattage %>W</span>
              <% } %>
            </td>
            <td class="text-center fw-semibold">
              <%= formatQty(line.qty) %> <span class="text-muted small"><%= line.itemSnapshot ? line.itemSnapshot.unit : 'pcs' %></span>
            </td>
            <td class="text-end font-monospace"><%= formatPKR(line.unitSellingPricePaisa) %></td>
            <td class="text-end font-monospace fw-bold text-dark"><%= formatPKR(line.totalSellingPricePaisa) %></td>
            <% if (canViewCosts) { %>
              <td class="text-end font-monospace text-muted small"><%= formatPKR(line.unitCostPaisa) %></td>
              <td class="text-end font-monospace text-muted small"><%= formatPKR(line.totalCostPaisa) %></td>
            <% } %>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- Commercial Overheads & Summary Footer -->
  <div class="card-footer bg-light p-3 p-md-4">
    <div class="row g-3 justify-content-end">
      <div class="col-12 col-md-6 col-lg-5">
        <dl class="row mb-0 small">
          <dt class="col-7 text-muted fw-normal">Components Total</dt>
          <dd class="col-5 text-end font-monospace"><%= formatPKR(quotation.totalItemSellingPricePaisa) %></dd>

          <% if (quotation.laborCostPaisa) { %>
            <dt class="col-7 text-muted fw-normal">Labor &amp; Civil Mounting</dt>
            <dd class="col-5 text-end font-monospace"><%= formatPKR(quotation.laborCostPaisa) %></dd>
          <% } %>

          <% if (quotation.transportCostPaisa) { %>
            <dt class="col-7 text-muted fw-normal">Transport &amp; Handling</dt>
            <dd class="col-5 text-end font-monospace"><%= formatPKR(quotation.transportCostPaisa) %></dd>
          <% } %>

          <% if (quotation.netMeteringCostPaisa) { %>
            <dt class="col-7 text-muted fw-normal">Net Metering Documentation &amp; Fee</dt>
            <dd class="col-5 text-end font-monospace"><%= formatPKR(quotation.netMeteringCostPaisa) %></dd>
          <% } %>

          <% if (quotation.additionalCostPaisa) { %>
            <dt class="col-7 text-muted fw-normal">Additional Services</dt>
            <dd class="col-5 text-end font-monospace"><%= formatPKR(quotation.additionalCostPaisa) %></dd>
          <% } %>

          <% if (quotation.discountPaisa > 0) { %>
            <dt class="col-7 text-danger fw-normal">
              Discount Applied
              <% if (quotation.discountType === 'percent') { %>(<%= quotation.discountPercent %>%)<% } %>
            </dt>
            <dd class="col-5 text-end font-monospace text-danger">- <%= formatPKR(quotation.discountPaisa) %></dd>
          <% } %>

          <hr class="my-2">

          <dt class="col-6 fs-6 fw-bold text-dark">Total Selling Price</dt>
          <dd class="col-6 text-end fs-5 fw-bold text-primary mb-0 font-monospace"><%= formatPKR(quotation.finalPricePaisa) %></dd>

          <dt class="col-12 mt-2 pt-2 border-top text-muted small fw-normal">Amount in Words:</dt>
          <dd class="col-12 fw-semibold text-dark"><%= numberToWordsPKR(quotation.finalPricePaisa, true) %></dd>

          <% if (canViewProfit && quotation.netProfitPaisa !== undefined) { %>
            <div class="col-12 mt-2 p-2 bg-white rounded border small">
              <div class="d-flex justify-content-between text-muted">
                <span>Total Base Cost:</span>
                <span class="font-monospace"><%= formatPKR(quotation.totalBaseCostPaisa) %></span>
              </div>
              <div class="d-flex justify-content-between mt-1">
                <span>Net Expected Profit:</span>
                <span class="font-monospace fw-bold <%= quotation.netProfitPaisa < 0 ? 'text-danger' : 'text-success' %>">
                  <%= formatPKR(quotation.netProfitPaisa) %> (<%= quotation.netProfitMarginPercent %>%)
                </span>
              </div>
            </div>
          <% } %>
        </dl>
      </div>
    </div>
  </div>
</div>

<!-- Payment Plan / Milestone Schedule Card -->
<div class="card app-card mb-3">
  <div class="card-header bg-transparent py-3">
    <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
      <i class="bi bi-credit-card"></i> Payment Plan (<%= quotation.paymentOption === 'installment' ? 'Milestone Schedule' : '100% Advance Payment' %>)
    </h3>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 app-table">
        <thead class="table-light">
          <tr>
            <th style="width: 40px;">#</th>
            <th>Milestone Description</th>
            <th class="text-center" style="width: 120px;">Percentage</th>
            <th class="text-end" style="width: 170px;">Amount (PKR)</th>
            <th style="width: 160px;">Target Due Date</th>
            <th>Notes</th>
          </tr>
        </thead>
        <tbody>
          <% (quotation.paymentPlan || []).forEach(function (ms, mIdx) { %>
            <tr>
              <td class="text-muted small"><%= mIdx + 1 %></td>
              <td class="fw-semibold"><%= ms.label %></td>
              <td class="text-center"><span class="badge text-bg-light border font-monospace"><%= ms.percent %>%</span></td>
              <td class="text-end font-monospace fw-bold text-dark"><%= formatPKR(ms.amountPaisa) %></td>
              <td class="small text-muted"><%= ms.dueDate ? formatDate(ms.dueDate) : 'On milestone handover' %></td>
              <td class="small text-muted"><%= ms.notes || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Warranties, Terms & Bilingual Section -->
<div class="row g-3 mb-3">
  <div class="col-12 col-lg-6">
    <div class="card app-card h-100">
      <div class="card-header bg-transparent py-3">
        <h3 class="h6 fw-bold mb-0 text-primary">Warranty Terms</h3>
      </div>
      <div class="card-body p-3 p-md-4">
        <div class="small text-muted font-monospace" style="white-space: pre-line;">
          <%= quotation.warrantyTerms || 'Standard manufacturer warranty applies to panels and inverters.' %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-6">
    <div class="card app-card h-100">
      <div class="card-header bg-transparent py-3">
        <h3 class="h6 fw-bold mb-0 text-primary">Terms &amp; Conditions</h3>
      </div>
      <div class="card-body p-3 p-md-4">
        <div class="small text-muted font-monospace" style="white-space: pre-line;">
          <%= quotation.terms || '1. Quotation valid for 15 days.\n2. Civil structure included.\n3. Net metering subject to DISCO regulations.' %>
        </div>
      </div>
    </div>
  </div>

  <% if (quotation.includeUrdu || quotation.urduNotes) { %>
    <div class="col-12">
      <div class="card app-card border-warning-subtle bg-warning-subtle bg-opacity-25">
        <div class="card-header bg-transparent py-2 border-warning-subtle">
          <h3 class="h6 fw-bold mb-0 text-warning-emphasis">Bilingual Notes / اہم ہدایات</h3>
        </div>
        <div class="card-body p-3 text-end" dir="rtl">
          <p class="mb-0 fs-6 fw-medium text-dark"><%= quotation.urduNotes %></p>
        </div>
      </div>
    </div>
  <% } %>
</div>

<!-- Status Update Workflow & Status History Timeline -->
<div class="row g-3 mb-4">
  <% if (canManage) { %>
    <div class="col-12 col-lg-5">
      <div class="card app-card h-100">
        <div class="card-header bg-transparent py-3">
          <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
            <i class="bi bi-sliders"></i> Update Quotation Status
          </h3>
        </div>
        <div class="card-body p-3 p-md-4">
          <form method="POST" action="/quotations/<%= quotation._id %>/status">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3">
              <label class="form-label small fw-semibold text-uppercase text-muted">New Status <span class="text-danger">*</span></label>
              <select class="form-select" name="status" required>
                <% quotations.QUOTATION_STATUSES.forEach(function (st) { %>
                  <option value="<%= st %>" <%= quotation.status === st ? 'selected' : '' %>>
                    <%= quotations.QUOTATION_STATUS_LABELS[st] || st %>
                  </option>
                <% }); %>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-uppercase text-muted">Reason / Client Feedback</label>
              <textarea class="form-control" name="reason" rows="2" placeholder="e.g. Approved via signed copy, or Price too high"></textarea>
              <div class="form-text">
                <strong>Notice:</strong> Marking status as <em>Approved</em> will automatically create a <strong>Sale / Confirmed Project</strong> record.
              </div>
            </div>

            <button type="submit" class="btn btn-primary w-100">
              <i class="bi bi-check2 me-1"></i>Update Status
            </button>
          </form>
        </div>
      </div>
    </div>
  <% } %>

  <div class="col-12 <%= canManage ? 'col-lg-7' : 'col-12' %>">
    <div class="card app-card h-100">
      <div class="card-header bg-transparent py-3">
        <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
          <i class="bi bi-clock-history"></i> Status &amp; Action History
        </h3>
      </div>
      <div class="card-body p-3 p-md-4">
        <% if (quotation.statusHistory && quotation.statusHistory.length) { %>
          <div class="timeline">
            <% quotation.statusHistory.forEach(function (h) { %>
              <div class="d-flex align-items-start gap-3 pb-3 mb-3 border-bottom">
                <span class="badge text-bg-<%= quotations.QUOTATION_STATUS_BADGES[h.status] || 'secondary' %> mt-1">
                  <%= quotations.QUOTATION_STATUS_LABELS[h.status] || h.status %>
                </span>
                <div class="flex-grow-1 min-w-0">
                  <div class="small fw-semibold text-dark">
                    <%= h.changedBy ? h.changedBy.name : 'System / User' %>
                    <span class="text-muted fw-normal ms-1">· <%= formatDate(h.changedAt) %></span>
                  </div>
                  <% if (h.reason) { %>
                    <div class="small text-muted mt-1"><%= h.reason %></div>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-muted small">No status changes recorded yet.</div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Email Modal -->
<div class="modal fade" id="emailQuoteModal" tabindex="-1" aria-labelledby="emailQuoteModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/quotations/<%= quotation._id %>/email">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title" id="emailQuoteModalLabel">Email Quotation PDF</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold text-uppercase text-muted">Recipient Email <span class="text-danger">*</span></label>
            <input type="email" class="form-control" name="recipientEmail" required
                   value="<%= (quotation.customer && quotation.customer.email) || '' %>" placeholder="customer@example.com">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold text-uppercase text-muted">Subject</label>
            <input type="text" class="form-control" name="subject"
                   value="Solar System Quotation - <%= quotation.quotationNumber %> - Solar Agency">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold text-uppercase text-muted">Message Note</label>
            <textarea class="form-control" name="message" rows="4">Dear <%= quotation.customer ? quotation.customer.name : 'Valued Client' %>,

Please find attached your official quotation <%= quotation.fullNumber %> for a <%= quotation.systemSummary ? quotation.systemSummary.capacityKw : '' %> kW solar system.

Feel free to reach out if you have any questions or wish to schedule the installation.

Best regards,
Solar Engineering Team</textarea>
          </div>
          <div class="small text-muted">
            <i class="bi bi-paperclip me-1"></i>Official PDF proposal <code><%= quotation.quotationNumber %>_Rev<%= quotation.revision %>.pdf</code> will be attached automatically.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-send me-1"></i>Send Email
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
