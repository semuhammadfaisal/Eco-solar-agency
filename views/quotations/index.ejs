<%- include('../partials/page-header', {
  heading: 'Quotations',
  subheading: 'Commercial proposals, multi-revision tracking, and conversion analytics.',
  actions: can('quotations.manage') ? [
    { label: 'New quotation', url: '/quotations/new', icon: 'bi-plus-lg', class: 'btn-primary' }
  ] : []
}) %>

<!-- Pipeline & Conversion Metrics Ribbon -->
<div class="row g-2 mb-3 mt-1">
  <div class="col-6 col-lg-3">
    <div class="card app-card border-primary-subtle text-center p-3 h-100">
      <div class="text-uppercase small text-muted fw-semibold">Quotation Pipeline</div>
      <div class="fs-4 fw-bold text-primary mt-1"><%= formatPKR(metrics.pipelineValuePaisa || 0) %></div>
      <div class="small text-muted"><%= metrics.totalQuotes %> total <%= metrics.totalQuotes === 1 ? 'quote' : 'quotes' %></div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card border-success-subtle text-center p-3 h-100">
      <div class="text-uppercase small text-muted fw-semibold">Approved Revenue</div>
      <div class="fs-4 fw-bold text-success mt-1"><%= formatPKR(metrics.approvedValuePaisa || 0) %></div>
      <div class="small text-muted"><%= metrics.approvedQuotes %> confirmed deals</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card border-info-subtle text-center p-3 h-100">
      <div class="text-uppercase small text-muted fw-semibold">Conversion Rate</div>
      <div class="fs-4 fw-bold text-info mt-1"><%= metrics.conversionRate %>%</div>
      <div class="small text-muted">Sent &rarr; Approved ratio</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card border-warning-subtle text-center p-3 h-100">
      <div class="text-uppercase small text-muted fw-semibold">
        <%= canViewProfit ? 'Expected Profit' : 'Active Deals' %>
      </div>
      <% if (canViewProfit && metrics.totalProfitPaisa !== undefined) { %>
        <div class="fs-4 fw-bold text-dark mt-1"><%= formatPKR(metrics.totalProfitPaisa) %></div>
        <div class="small text-muted">Gross portfolio margin</div>
      <% } else { %>
        <div class="fs-4 fw-bold text-dark mt-1"><%= metrics.totalQuotes - metrics.approvedQuotes %></div>
        <div class="small text-muted">In discussion</div>
      <% } %>
    </div>
  </div>
</div>

<div class="card app-card">
  <div class="card-body p-3 p-md-4">
    <!-- Filter bar -->
    <form method="GET" action="/quotations" class="row g-2 mb-3">
      <div class="col-12 col-md-4">
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="text" class="form-control" name="search" placeholder="Search by QT number or system type…" value="<%= filters.search %>">
        </div>
      </div>
      <div class="col-6 col-md-2">
        <select class="form-select" name="status" onchange="this.form.submit()">
          <option value="">All statuses</option>
          <% quotations.QUOTATION_STATUSES.forEach(function (st) { %>
            <option value="<%= st %>" <%= filters.status === st ? 'selected' : '' %>><%= quotations.QUOTATION_STATUS_LABELS[st] %></option>
          <% }); %>
        </select>
      </div>

      <% if (userRole !== 'sales' && salesUsers && salesUsers.length) { %>
        <div class="col-6 col-md-3">
          <select class="form-select" name="assignedTo" onchange="this.form.submit()">
            <option value="">All salespersons</option>
            <% salesUsers.forEach(function (u) { %>
              <option value="<%= u._id %>" <%= String(filters.assignedTo) === String(u._id) ? 'selected' : '' %>>
                <%= u.name %> (<%= u.role %>)
              </option>
            <% }); %>
          </select>
        </div>
      <% } %>

      <div class="col-6 col-md-2">
        <input type="date" class="form-control" name="from" value="<%= filters.from %>" title="From date" onchange="this.form.submit()">
      </div>
      <div class="col-6 col-md-1 d-flex gap-1">
        <button type="submit" class="btn btn-outline-secondary w-100" title="Filter"><i class="bi bi-funnel"></i></button>
        <% if (filters.search || filters.status || filters.assignedTo || filters.from || filters.to) { %>
          <a href="/quotations" class="btn btn-outline-danger" title="Clear filters"><i class="bi bi-x-lg"></i></a>
        <% } %>
      </div>
    </form>

    <% if (!quotationRows || !quotationRows.length) { %>
      <div class="text-center py-5 text-muted">
        <i class="bi bi-file-earmark-text fs-1 d-block mb-2"></i>
        <p class="mb-2">No quotations found.</p>
        <% if (can('quotations.manage')) { %>
          <a href="/quotations/new" class="btn btn-sm btn-primary">Create the first quotation</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle app-table mb-0">
          <thead>
            <tr>
              <th>Quotation #</th>
              <th>Customer</th>
              <th>System</th>
              <th class="text-end">Final Price</th>
              <th>Salesperson</th>
              <th>Validity</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% quotationRows.forEach(function (q) { %>
              <tr>
                <td>
                  <a href="/quotations/<%= q._id %>" class="font-monospace fw-semibold">
                    <%= q.quotationNumber %>
                  </a>
                  <% if (q.revision > 1) { %>
                    <span class="badge text-bg-light border font-monospace">Rev <%= q.revision %></span>
                  <% } %>
                  <div class="small text-muted"><%= formatDate(q.quotationDate || q.createdAt) %></div>
                </td>
                <td>
                  <% if (q.customer) { %>
                    <a href="/customers/<%= q.customer._id %>" class="fw-medium text-body"><%= q.customer.name %></a>
                    <div class="small text-muted"><%= q.customer.phone || q.customer.city || '' %></div>
                  <% } else { %>
                    <span class="text-muted">Direct Client</span>
                  <% } %>
                </td>
                <td>
                  <div class="fw-semibold text-primary">
                    <%= formatQty(q.systemSummary ? q.systemSummary.capacityKw : 0) %> kW
                  </div>
                  <div class="small text-muted">
                    <%= systems.SYSTEM_TYPE_LABELS[q.systemSummary ? q.systemSummary.systemType : 'on_grid'] || 'On-Grid' %>
                  </div>
                </td>
                <td class="text-end fw-bold text-dark">
                  <%= formatPKR(q.finalPricePaisa) %>
                  <% if (q.discountPaisa > 0) { %>
                    <div class="small text-danger fw-normal">-<%= formatPKR(q.discountPaisa) %></div>
                  <% } %>
                </td>
                <td class="small text-muted">
                  <%= q.assignedTo ? q.assignedTo.name : '—' %>
                </td>
                <td class="small">
                  <% if (q.isExpired) { %>
                    <span class="text-danger fw-semibold"><i class="bi bi-clock-history me-1"></i>Expired</span>
                  <% } else { %>
                    <span class="text-muted"><%= formatDate(q.validUntil) %></span>
                  <% } %>
                </td>
                <td>
                  <span class="badge text-bg-<%= quotations.QUOTATION_STATUS_BADGES[q.status] || 'secondary' %>">
                    <%= quotations.QUOTATION_STATUS_LABELS[q.status] || q.status %>
                  </span>
                </td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm">
                    <a href="/quotations/<%= q._id %>" class="btn btn-outline-primary" title="View details & revisions">
                      <i class="bi bi-eye"></i>
                    </a>
                    <a href="/quotations/<%= q._id %>/pdf" target="_blank" class="btn btn-outline-secondary" title="View / Print PDF">
                      <i class="bi bi-file-earmark-pdf"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <%- include('../partials/pagination', { pagination: pagination }) %>
    <% } %>
  </div>
</div>
