<%- include('../partials/page-header', {
  heading: 'Periodic Maintenance & Cleaning Schedules',
  subheading: 'Scheduled solar panel washing, thermal inverter checks, and preventive maintenance visits.',
  actions: [
    ...(can('installations.manage') ? [{ label: 'Schedule maintenance', url: '#', icon: 'bi-plus-lg', class: 'btn-primary', attrs: 'data-bs-toggle="modal" data-bs-target="#newMaintenanceModal"' }] : []),
    { label: 'Complaints', url: '/complaints', icon: 'bi-headset', class: 'btn-outline-secondary' }
  ]
}) %>

<!-- Search & Filters -->
<div class="card app-card mb-3">
  <div class="card-body p-3">
    <form method="GET" action="/maintenance" class="row g-2 align-items-center">
      <div class="col-12 col-md-4">
        <div class="input-group">
          <span class="input-group-text bg-transparent text-muted"><i class="bi bi-search"></i></span>
          <input type="text" class="form-control" name="search" value="<%= filters.search || '' %>"
                 placeholder="Search by schedule # (MNT-2026-0001)...">
        </div>
      </div>

      <div class="col-6 col-md-3">
        <select class="form-select" name="serviceType">
          <option value="">All Service Types</option>
          <% types.forEach(function (t) { %>
            <option value="<%= t %>" <%= filters.serviceType === t ? 'selected' : '' %>>
              <%= installationsConfig.MAINTENANCE_TYPE_LABELS[t] || t %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-6 col-md-3">
        <select class="form-select" name="status">
          <option value="">All Statuses</option>
          <option value="scheduled" <%= filters.status === 'scheduled' ? 'selected' : '' %>>Scheduled / Pending</option>
          <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
          <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select>
      </div>

      <div class="col-12 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">Filter</button>
        <a href="/maintenance" class="btn btn-light border">Reset</a>
      </div>
    </form>
  </div>
</div>

<!-- Maintenance Table -->
<div class="card app-card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light text-muted small text-uppercase">
        <tr>
          <th>Schedule #</th>
          <th>Customer</th>
          <th>Service Type</th>
          <th>Frequency</th>
          <th>Scheduled Date</th>
          <th>Assigned Technician</th>
          <th>Status</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (!schedules.length) { %>
          <tr>
            <td colspan="8" class="text-center py-4 text-muted">No maintenance visits scheduled.</td>
          </tr>
        <% } else { %>
          <% schedules.forEach(function (m) { %>
            <tr>
              <td>
                <span class="font-monospace fw-bold"><%= m.scheduleNumber %></span>
              </td>
              <td>
                <div class="fw-semibold">
                  <% if (m.customer) { %>
                    <a href="/customers/<%= m.customer._id %>" class="text-dark text-decoration-none">
                      <%= m.customer.name %>
                    </a>
                  <% } else { %>—<% } %>
                </div>
                <div class="small text-muted"><%= m.customer ? m.customer.phone : '' %></div>
              </td>
              <td>
                <span class="badge text-bg-light border">
                  <%= installationsConfig.MAINTENANCE_TYPE_LABELS[m.serviceType] || m.serviceType %>
                </span>
              </td>
              <td>
                <span class="small"><%= installationsConfig.MAINTENANCE_FREQUENCY_LABELS[m.frequency] || m.frequency %></span>
              </td>
              <td>
                <strong class="<%= new Date(m.scheduledDate) < new Date() && m.status === 'scheduled' ? 'text-danger' : 'text-dark' %>">
                  <%= formatDate(m.scheduledDate) %>
                </strong>
              </td>
              <td>
                <span class="small fw-semibold"><%= m.assignedTechnician ? m.assignedTechnician.name : 'Unassigned' %></span>
              </td>
              <td>
                <span class="badge text-bg-<%= m.status === 'completed' ? 'success' : m.status === 'cancelled' ? 'secondary' : 'primary' %>">
                  <%= m.status.toUpperCase() %>
                </span>
              </td>
              <td class="text-end">
                <% if (m.status === 'scheduled') { %>
                  <form method="POST" action="/maintenance/<%= m._id %>/complete" class="d-inline"
                        onsubmit="return confirm('Mark maintenance visit complete?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-outline-success">
                      <i class="bi bi-check2-circle me-1"></i>Complete
                    </button>
                  </form>
                <% } else { %>
                  <span class="small text-muted">Done <%= formatDate(m.completedAt) %></span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (pagination.pages > 1) { %>
    <div class="card-footer bg-transparent py-3">
      <%- include('../partials/pagination', { pagination }) %>
    </div>
  <% } %>
</div>

<!-- Modal: Schedule Maintenance -->
<div class="modal fade" id="newMaintenanceModal" tabindex="-1" aria-labelledby="newMaintenanceModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/maintenance">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="modal-header">
          <h5 class="modal-title" id="newMaintenanceModalLabel"><i class="bi bi-calendar-check me-2"></i>Schedule Maintenance Visit</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Customer *</label>
            <select class="form-select form-select-sm" name="customer" required>
              <option value="">Select customer...</option>
              <% customers.forEach(function (cust) { %>
                <option value="<%= cust._id %>"><%= cust.name %> (<%= cust.code %>)</option>
              <% }); %>
            </select>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label small fw-semibold">Service Type</label>
              <select class="form-select form-select-sm" name="serviceType">
                <% types.forEach(function (t) { %>
                  <option value="<%= t %>"><%= installationsConfig.MAINTENANCE_TYPE_LABELS[t] || t %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label small fw-semibold">Frequency</label>
              <select class="form-select form-select-sm" name="frequency">
                <% frequencies.forEach(function (f) { %>
                  <option value="<%= f %>"><%= installationsConfig.MAINTENANCE_FREQUENCY_LABELS[f] || f %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label small fw-semibold">Scheduled Date *</label>
              <input type="date" class="form-control form-control-sm" name="scheduledDate" required>
            </div>
            <div class="col-6">
              <label class="form-label small fw-semibold">Assigned Technician</label>
              <select class="form-select form-select-sm" name="assignedTechnician">
                <option value="">Unassigned...</option>
                <% technicians.forEach(function (tech) { %>
                  <option value="<%= tech._id %>"><%= tech.name %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Visit Notes</label>
            <textarea class="form-control form-control-sm" name="notes" rows="2"
                      placeholder="e.g. Bring demineralized water for high-tilt bifacial array washing..."></textarea>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-light border btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Schedule Visit</button>
        </div>
      </form>
    </div>
  </div>
</div>
