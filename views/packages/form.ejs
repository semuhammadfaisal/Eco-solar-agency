<%
  var nameVal = old('name', pkg ? pkg.name : '');
  var codeVal = old('code', pkg ? pkg.code : '');
  var typeVal = old('systemType', pkg ? pkg.systemType : 'on_grid');
  var capacityVal = old('capacityKw', pkg ? pkg.capacityKw : '');
  var descVal = old('description', pkg ? pkg.description : '');
  var laborVal = old('laborCost', pkg && pkg.laborCostPaisa ? (pkg.laborCostPaisa / 100) : '');
  var transportVal = old('transportCost', pkg && pkg.transportCostPaisa ? (pkg.transportCostPaisa / 100) : '');
  var netMeteringVal = old('netMeteringCost', pkg && pkg.netMeteringCostPaisa ? (pkg.netMeteringCostPaisa / 100) : '');
  var discountVal = old('defaultDiscountPercent', pkg ? pkg.defaultDiscountPercent : 0);
  var isActiveVal = pkg ? pkg.isActive : true;

  var initialItems = [];
  if (pkg && pkg.items && pkg.items.length) {
    initialItems = pkg.items.map(function (it) {
      var itemObj = it.item || {};
      return {
        itemId: String(itemObj._id || it.item),
        name: itemObj.name || '',
        sku: itemObj.sku || '',
        category: itemObj.category || 'other',
        unit: itemObj.unit || 'pcs',
        qty: it.qty || 1,
        notes: it.notes || ''
      };
    });
  }
%>

<%- include('../partials/page-header', {
  heading: isEdit ? 'Edit ' + pkg.code : 'New Solar Package',
  subheading: 'Define reusable package templates with preset items, quantities, and installation costs.',
  actions: [
    { label: 'Back to packages', url: '/packages', icon: 'bi-arrow-left', class: 'btn-outline-secondary' }
  ]
}) %>

<div class="row g-3 g-lg-4 mt-1">
  <div class="col-12 col-xl-10">
    <div class="card app-card">
      <div class="card-body p-4">
        <%- include('../partials/form-errors') %>

        <form method="POST" action="<%= formAction %>"
              x-data="packageForm(<%= JSON.stringify(initialItems) %>, <%= JSON.stringify(items) %>)"
              @submit="prepareSubmit" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (isEdit) { %><input type="hidden" name="_method" value="PUT"><% } %>
          <input type="hidden" name="itemsJson" :value="JSON.stringify(items)">

          <h2 class="h6 fw-semibold text-uppercase text-muted mb-3">Package Details</h2>
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label for="name" class="form-label">Package Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="name" name="name" value="<%= nameVal %>" placeholder="e.g. 5kW On-Grid Standard" required>
            </div>
            <div class="col-12 col-md-3">
              <label for="systemType" class="form-label">System Type <span class="text-danger">*</span></label>
              <select class="form-select" id="systemType" name="systemType" required>
                <% systems.SYSTEM_TYPES.forEach(function (type) { %>
                  <option value="<%= type %>"<%= typeVal === type ? ' selected' : '' %>><%= systems.SYSTEM_TYPE_LABELS[type] %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-12 col-md-3">
              <label for="capacityKw" class="form-label">Capacity (kW) <span class="text-danger">*</span></label>
              <input type="number" step="0.1" min="0.1" class="form-control" id="capacityKw" name="capacityKw" value="<%= capacityVal %>" placeholder="e.g. 5.5" required>
            </div>

            <div class="col-12 col-md-6">
              <label for="code" class="form-label">Package Code</label>
              <input type="text" class="form-control font-monospace" id="code" name="code" value="<%= codeVal %>" placeholder="Leave empty for auto-generated PKG-xxxx">
              <div class="form-text">Optional custom identifier. Automatically assigned if blank.</div>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label d-block">Status</label>
              <div class="form-check form-switch mt-2">
                <input class="form-check-input" type="checkbox" id="isActive" name="isActive" value="1" <%= isActiveVal ? 'checked' : '' %>>
                <label class="form-check-label" for="isActive">Active (available in System Builder)</label>
              </div>
            </div>

            <div class="col-12">
              <label for="description" class="form-label">Description</label>
              <textarea class="form-control" id="description" name="description" rows="2" placeholder="Brief description of suitability, recommended roof size, inverter/panels included…"><%= descVal %></textarea>
            </div>
          </div>

          <hr class="my-4">

          <h2 class="h6 fw-semibold text-uppercase text-muted mb-3">Default Overheads &amp; Cost Allowances (PKR)</h2>
          <div class="row g-3">
            <div class="col-12 col-md-4">
              <label for="laborCost" class="form-label">Default Labor Cost (PKR)</label>
              <input type="text" class="form-control" id="laborCost" name="laborCost" value="<%= laborVal %>" placeholder="e.g. 45,000">
              <div class="form-text">Installation labor cost allowance.</div>
            </div>
            <div class="col-12 col-md-4">
              <label for="transportCost" class="form-label">Default Transport Cost (PKR)</label>
              <input type="text" class="form-control" id="transportCost" name="transportCost" value="<%= transportVal %>" placeholder="e.g. 15,000">
              <div class="form-text">Delivery and logistics allowance.</div>
            </div>
            <div class="col-12 col-md-4">
              <label for="netMeteringCost" class="form-label">Default Net-Metering Cost (PKR)</label>
              <input type="text" class="form-control" id="netMeteringCost" name="netMeteringCost" value="<%= netMeteringVal %>" placeholder="e.g. 100,000">
              <div class="form-text">WAPDA/DISCO application fee allowance.</div>
            </div>
            <div class="col-12 col-md-4">
              <label for="defaultDiscountPercent" class="form-label">Default Template Discount (%)</label>
              <input type="number" step="0.1" min="0" max="100" class="form-control" id="defaultDiscountPercent" name="defaultDiscountPercent" value="<%= discountVal %>">
            </div>
          </div>

          <hr class="my-4">

          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h2 class="h6 fw-semibold text-uppercase text-muted mb-0">Bill of Materials (Preset Items)</h2>
              <div class="text-muted small">Items automatically loaded when this package is selected in the System Builder.</div>
            </div>
          </div>

          <div class="card bg-light-subtle border mb-3">
            <div class="card-body p-3">
              <div class="row g-2 align-items-end">
                <div class="col-12 col-md-7">
                  <label class="form-label small fw-medium">Pick an Inventory Item</label>
                  <select class="form-select" x-model="selectedItemId">
                    <option value="">Choose item from inventory…</option>
                    <template x-for="inv in inventoryCatalog" :key="inv._id">
                      <option :value="inv._id" x-text="`[${inv.category.toUpperCase()}] ${inv.name} (${inv.sku})`"></option>
                    </template>
                  </select>
                </div>
                <div class="col-6 col-md-3">
                  <label class="form-label small fw-medium">Quantity</label>
                  <input type="number" step="1" min="1" class="form-control" x-model.number="selectedQty" placeholder="Qty">
                </div>
                <div class="col-6 col-md-2">
                  <button type="button" class="btn btn-primary w-100" @click="addItem" :disabled="!selectedItemId || selectedQty <= 0">
                    <i class="bi bi-plus-lg me-1"></i>Add
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-bordered align-middle app-table mb-0">
              <thead class="table-light">
                <tr>
                  <th style="width:40px">#</th>
                  <th>Item Description</th>
                  <th style="width:110px">Category</th>
                  <th style="width:120px">Quantity</th>
                  <th>Notes</th>
                  <th style="width:50px"></th>
                </tr>
              </thead>
              <tbody>
                <template x-for="(entry, index) in items" :key="index">
                  <tr>
                    <td class="text-muted small" x-text="index + 1"></td>
                    <td>
                      <div class="fw-medium" x-text="entry.name"></div>
                      <div class="small text-muted font-monospace" x-text="entry.sku"></div>
                    </td>
                    <td>
                      <span class="badge bg-secondary-subtle text-secondary text-uppercase" x-text="entry.category"></span>
                    </td>
                    <td>
                      <div class="input-group input-group-sm">
                        <input type="number" step="1" min="0.1" class="form-control" x-model.number="entry.qty">
                        <span class="input-group-text small" x-text="entry.unit || 'pcs'"></span>
                      </div>
                    </td>
                    <td>
                      <input type="text" class="form-control form-control-sm" x-model="entry.notes" placeholder="Optional notes…">
                    </td>
                    <td class="text-center">
                      <button type="button" class="btn btn-link text-danger p-0" @click="removeItem(index)" title="Remove item">
                        <i class="bi bi-trash"></i>
                      </button>
                    </td>
                  </tr>
                </template>
                <tr x-show="items.length === 0">
                  <td colspan="6" class="text-center text-muted py-4">
                    <i class="bi bi-box-seam d-block fs-3 mb-1"></i>
                    No items added yet. Select an item above to add to this template.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check2-circle me-1"></i><%= isEdit ? 'Save package' : 'Create package' %>
            </button>
            <a href="/packages" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function packageForm(initialItems, inventoryCatalog) {
  return {
    items: Array.isArray(initialItems) ? initialItems : [],
    inventoryCatalog: inventoryCatalog || [],
    selectedItemId: '',
    selectedQty: 1,

    addItem() {
      if (!this.selectedItemId || this.selectedQty <= 0) return;
      const found = this.inventoryCatalog.find(i => String(i._id) === String(this.selectedItemId));
      if (!found) return;

      const existingIndex = this.items.findIndex(i => String(i.itemId) === String(this.selectedItemId));
      if (existingIndex >= 0) {
        this.items[existingIndex].qty += Number(this.selectedQty);
      } else {
        this.items.push({
          itemId: String(found._id),
          name: found.name,
          sku: found.sku,
          category: found.category || 'other',
          unit: found.unit || 'pcs',
          qty: Number(this.selectedQty),
          notes: ''
        });
      }

      this.selectedItemId = '';
      this.selectedQty = 1;
    },

    removeItem(index) {
      this.items.splice(index, 1);
    },

    prepareSubmit() {
      // JSON is bound via :value
    }
  };
}
</script>
