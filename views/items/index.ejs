<%
  var headerActions = [];
  if (can('inventory.manage')) {
    headerActions.push({ label: 'Stock in', url: '/items/stock-in', icon: 'bi-box-arrow-in-down', class: 'btn-outline-primary' });
    headerActions.push({ label: 'Add item', url: '/items/new', icon: 'bi-plus-lg', class: 'btn-primary' });
  }
%>

<%- include('../partials/page-header', {
  heading: 'Inventory',
  subheading: 'Solar panels, inverters, batteries, structures, cables and every other stocked part.',
  actions: headerActions
}) %>

<div class="row g-3 mt-1">
  <div class="col-6 col-lg-3">
    <div class="card app-card h-100"><div class="card-body stat-card">
      <span class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-box-seam"></i></span>
      <div class="stat-value"><%= summary.totalItems %></div>
      <div class="stat-label">Catalogue items</div>
    </div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card h-100"><div class="card-body stat-card">
      <span class="stat-icon bg-warning-subtle text-warning-emphasis"><i class="bi bi-exclamation-triangle"></i></span>
      <div class="stat-value"><%= summary.lowStock %></div>
      <div class="stat-label">At or below minimum</div>
    </div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card h-100"><div class="card-body stat-card">
      <span class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-x-octagon"></i></span>
      <div class="stat-value"><%= summary.outOfStock %></div>
      <div class="stat-label">Out of stock</div>
    </div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card h-100"><div class="card-body stat-card">
      <span class="stat-icon bg-success-subtle text-success"><i class="bi bi-cash-stack"></i></span>
      <% if (canViewCosts && summary.totalValuePaisa !== undefined) { %>
        <div class="stat-value"><%= formatPKR(summary.totalValuePaisa) %></div>
        <div class="stat-label">Stock value at average cost</div>
      <% } else { %>
        <div class="stat-value"><%= formatQty(summary.totalUnits) %></div>
        <div class="stat-label">Units on hand</div>
      <% } %>
    </div></div>
  </div>
</div>

<div class="mt-3">
  <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-2">
    <h2 class="h6 fw-semibold mb-0">Browse by category</h2>
    <a href="/items" class="btn btn-sm <%= filters.category ? 'btn-outline-secondary' : 'btn-primary' %>">
      <i class="bi bi-grid me-1"></i>All items (<%= summary.totalItems %>)
    </a>
  </div>
  <div class="row g-2">
    <% categorySummary.forEach(function (cat) {
         var isActive = filters.category === cat.key;
    %>
      <div class="col-6 col-sm-4 col-lg-3 col-xxl-2">
        <a href="/items?category=<%= cat.key %>"
           class="card app-card h-100 text-decoration-none category-shelf-card <%= isActive ? 'border-primary shadow-sm' : '' %>">
          <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="stat-icon bg-<%= cat.badge %>-subtle text-<%= cat.badge %>-emphasis"><i class="bi <%= cat.icon %>"></i></span>
              <span class="badge rounded-pill text-bg-light border"><%= cat.itemCount %></span>
            </div>
            <div class="fw-semibold text-body small"><%= cat.label %></div>
            <div class="text-muted" style="font-size:.75rem">
              <%= formatQty(cat.units) %> units
              <% if (cat.lowStock) { %><span class="text-warning-emphasis">&bull; <%= cat.lowStock %> low</span><% } %>
            </div>
          </div>
        </a>
      </div>
    <% }); %>
  </div>
</div>

<div class="card app-card mt-3">
  <div class="card-body border-bottom">
    <form method="GET" action="/items" class="row g-2 align-items-end">
      <div class="col-12 col-md-4">
        <label for="search" class="form-label small text-muted mb-1">Search</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="search" class="form-control" id="search" name="search"
                 value="<%= filters.search %>" placeholder="SKU, name, brand, model, specs">
        </div>
      </div>

      <div class="col-6 col-md-2">
        <label for="category" class="form-label small text-muted mb-1">Category</label>
        <select class="form-select" id="category" name="category">
          <option value="">All categories</option>
          <% inventory.ITEM_CATEGORIES.forEach(function (category) { %>
            <option value="<%= category %>"<%= filters.category === category ? ' selected' : '' %>>
              <%= inventory.ITEM_CATEGORY_LABELS[category] %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-6 col-md-2">
        <label for="brand" class="form-label small text-muted mb-1">Brand</label>
        <select class="form-select" id="brand" name="brand">
          <option value="">All brands</option>
          <% brands.forEach(function (brand) { %>
            <option value="<%= brand %>"<%= filters.brand === brand ? ' selected' : '' %>><%= brand %></option>
          <% }); %>
        </select>
      </div>

      <div class="col-6 col-md-2">
        <label for="stock" class="form-label small text-muted mb-1">Stock</label>
        <select class="form-select" id="stock" name="stock">
          <option value="">Any stock level</option>
          <option value="in"<%= filters.stock === 'in' ? ' selected' : '' %>>In stock</option>
          <option value="low"<%= filters.stock === 'low' ? ' selected' : '' %>>Low stock</option>
          <option value="out"<%= filters.stock === 'out' ? ' selected' : '' %>>Out of stock</option>
        </select>
      </div>

      <div class="col-6 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i>Filter</button>
        <a href="/items" class="btn btn-outline-secondary">Reset</a>
      </div>
    </form>
  </div>

  <div class="card-header bg-transparent d-flex flex-wrap gap-2 justify-content-between align-items-center">
    <span class="small text-muted"><strong><%= total %></strong> item<%= total === 1 ? '' : 's' %> found</span>
    <div class="d-flex flex-wrap gap-2">
      <span class="badge text-bg-warning-subtle text-warning-emphasis border border-warning-subtle">
        <i class="bi bi-exclamation-triangle me-1"></i>Low stock highlighted
      </span>
      <% if (filters.search || filters.category || filters.brand || filters.stock) { %>
        <span class="badge text-bg-light border">Filtered</span>
      <% } %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle app-table mb-0">
      <thead>
        <tr>
          <th>Item</th>
          <th>Category</th>
          <th>Brand / model</th>
          <th class="text-end">On hand</th>
          <th class="text-end">Minimum</th>
          <% if (canViewCosts) { %><th class="text-end">Purchase</th><% } %>
          <th class="text-end">Selling</th>
          <th class="text-end" style="width:120px"></th>
        </tr>
      </thead>
      <tbody>
        <% if (!items.length) { %>
          <tr>
            <td colspan="<%= canViewCosts ? 8 : 7 %>" class="text-center py-5 text-muted">
              <i class="bi bi-box fs-3 d-block mb-2"></i>
              <% if (filters.category) { %>
                No items in this category yet.
                <% if (can('inventory.manage')) { %>
                  <div class="mt-2">
                    <a href="/items/new?category=<%= filters.category %>" class="btn btn-sm btn-primary">
                      <i class="bi bi-plus-lg me-1"></i>Add the first item
                    </a>
                  </div>
                <% } %>
              <% } else { %>
                No items match your filters.
              <% } %>
            </td>
          </tr>
        <% } else { %>
          <% items.forEach(function (item) {
               var rowClass = item.isOutOfStock ? 'stock-out-row' : (item.isLowStock ? 'stock-low-row' : '');
               var categoryLabel = inventory.ITEM_CATEGORY_LABELS[item.category] || item.category;
               var categoryBadge = inventory.ITEM_CATEGORY_BADGES[item.category] || 'secondary';
               var specBits = [];
               if (item.wattage !== null && item.wattage !== undefined) specBits.push(formatQty(item.wattage) + ' W');
               if (item.capacityKw !== null && item.capacityKw !== undefined) specBits.push(formatQty(item.capacityKw) + ' kW');
          %>
            <tr class="<%= rowClass %>">
              <td>
                <a href="/items/<%= item._id %>" class="fw-semibold text-decoration-none"><%= item.name %></a>
                <div class="text-muted small">
                  <span class="font-monospace"><%= item.sku %></span>
                  <% if (item.hasSerial) { %><span class="badge text-bg-info-subtle text-info-emphasis ms-1">Serial</span><% } %>
                </div>
              </td>
              <td>
                <span class="badge text-bg-<%= categoryBadge %>"><%= categoryLabel %></span>
              </td>
              <td class="small">
                <div><%= item.brand || '—' %></div>
                <div class="text-muted"><%= item.model || '' %><%= specBits.length ? ' · ' + specBits.join(' · ') : '' %></div>
              </td>
              <td class="text-end">
                <span class="fw-semibold <%= item.isOutOfStock ? 'text-danger' : (item.isLowStock ? 'text-warning-emphasis' : '') %>">
                  <%= formatQty(item.currentStock) %>
                </span>
                <span class="text-muted small"><%= item.unit %></span>
                <% if (item.isOutOfStock) { %>
                  <div class="small text-danger">Out of stock</div>
                <% } else if (item.isLowStock) { %>
                  <div class="small text-warning-emphasis">Low stock</div>
                <% } %>
              </td>
              <td class="text-end text-muted small"><%= formatQty(item.minStock) %></td>
              <% if (canViewCosts) { %>
                <td class="text-end small"><%= formatPKR(item.purchasePricePaisa) %></td>
              <% } %>
              <td class="text-end small"><%= formatPKR(item.sellingPricePaisa) %></td>
              <td class="text-end">
                <div class="d-flex justify-content-end gap-1">
                  <% if (can('inventory.manage')) { %>
                    <a class="btn btn-sm btn-outline-success" href="/items/stock-in?item=<%= item._id %>" title="Add stock"><i class="bi bi-plus-lg"></i></a>
                  <% } %>
                  <a class="btn btn-sm btn-outline-secondary" href="/items/<%= item._id %>" title="View item"><i class="bi bi-eye"></i></a>
                  <% if (can('inventory.manage')) { %>
                    <a class="btn btn-sm btn-outline-secondary" href="/items/<%= item._id %>/edit" title="Edit item"><i class="bi bi-pencil"></i></a>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <%- include('../partials/pagination', { pagination: pagination }) %>
</div>
