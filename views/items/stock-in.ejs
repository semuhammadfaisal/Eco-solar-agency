<%
  var selectedId = String(old('item', selectedItemId || ''));
  var selectedBranch = String(old('branch', branchId || ''));
  var selectedItem = items.find(function (item) { return String(item._id) === selectedId; });
  var groups = inventory.ITEM_CATEGORIES.map(function (key) {
    return {
      key: key,
      label: inventory.ITEM_CATEGORY_LABELS[key],
      items: items.filter(function (item) { return item.category === key; })
    };
  }).filter(function (group) { return group.items.length; });
%>

<%- include('../partials/page-header', {
  heading: 'Add stock',
  subheading: 'Record units that have arrived at a branch. This updates branch stock, the catalogue total and the stock ledger.',
  actions: [
    { label: 'Add new item', url: '/items/new', icon: 'bi-plus-lg', class: 'btn-outline-primary' },
    { label: 'Stock ledger', url: '/stock', icon: 'bi-arrow-left-right', class: 'btn-outline-secondary' },
    { label: 'Back to inventory', url: '/items', icon: 'bi-arrow-left', class: 'btn-outline-secondary' }
  ]
}) %>

<div class="row g-3 g-lg-4 mt-1">
  <div class="col-12 col-xl-7">
    <div class="card app-card">
      <div class="card-body p-4">
        <%- include('../partials/form-errors') %>

        <form method="POST" action="/items/stock-in" data-stock-in-form data-once novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="row g-3">
            <div class="col-12 col-md-5">
              <label for="branch" class="form-label">Receive at branch <span class="text-danger">*</span></label>
              <select class="form-select" id="branch" name="branch" required>
                <% branches.forEach(function (branch) { %>
                  <option value="<%= branch._id %>"<%= selectedBranch === String(branch._id) ? ' selected' : '' %>>
                    <%= branch.code %> — <%= branch.name %>
                  </option>
                <% }); %>
              </select>
            </div>

            <div class="col-12 col-md-7">
              <label for="item" class="form-label">Item <span class="text-danger">*</span></label>
              <select class="form-select" id="item" name="item" required data-stock-in-item>
                <option value="">Select an item…</option>
                <% groups.forEach(function (group) { %>
                  <optgroup label="<%= group.label %>">
                    <% group.items.forEach(function (item) { %>
                      <option value="<%= item._id %>"
                              data-has-serial="<%= item.hasSerial ? '1' : '0' %>"
                              data-stock="<%= item.currentStock %>"
                              data-unit="<%= item.unit %>"
                              data-sku="<%= item.sku %>"
                              <%= selectedId === String(item._id) ? 'selected' : '' %>>
                        <%= item.sku %> — <%= item.name %> (<%= formatQty(item.currentStock) %> <%= item.unit %> on hand)
                      </option>
                    <% }); %>
                  </optgroup>
                <% }); %>
              </select>
              <div class="form-text">
                Missing something? <a href="/items/new">Add the product first</a>, then receive its stock here.
              </div>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-6 col-md-4">
              <label for="qty" class="form-label">Quantity received <span class="text-danger">*</span></label>
              <input type="number" class="form-control" id="qty" name="qty" min="0.0001" step="any"
                     value="<%= old('qty') %>" inputmode="decimal" placeholder="0" required>
            </div>

            <% if (canViewCosts) { %>
              <div class="col-6 col-md-4">
                <label for="unitCost" class="form-label">Unit cost (PKR)</label>
                <input type="text" class="form-control" id="unitCost" name="unitCost" inputmode="decimal"
                       value="<%= old('unitCost') %>" placeholder="0.00">
                <div class="form-text">Optional. Updates the moving-average cost.</div>
              </div>
            <% } %>

            <div class="col-12 col-md-4">
              <label for="reference" class="form-label">Supplier bill / DC no.</label>
              <input type="text" class="form-control" id="reference" name="reference" maxlength="120"
                     value="<%= old('reference') %>" placeholder="INV-1042, DC-778…">
            </div>
          </div>

          <div class="mt-3" data-serial-block <%= selectedItem && selectedItem.hasSerial ? '' : 'hidden' %>>
            <label for="serials" class="form-label">Serial numbers and barcodes</label>
            <textarea class="form-control font-monospace" id="serials" name="serials" rows="4"
                      placeholder="One serial per line: SN-001 or SN-001,8901234567890"><%= old('serials') %></textarea>
            <div class="form-text">
              Serialised items need exactly one serial per received unit. Add an optional barcode after a comma.
              Duplicate or already-used serials and barcodes are rejected.
            </div>
          </div>

          <div class="mt-3">
            <label for="notes" class="form-label">Notes</label>
            <textarea class="form-control" id="notes" name="notes" rows="2" maxlength="500"
                      placeholder="Condition on arrival, opening stock, walk-in purchase…"><%= old('notes') %></textarea>
          </div>

          <div class="alert alert-light border small mt-3" data-stock-in-preview>
            Select an item to see the catalogue balance after this receipt.
          </div>

          <div class="d-flex flex-wrap gap-2 justify-content-end mt-4">
            <a href="/items" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-success">
              <i class="bi bi-box-arrow-in-down me-1"></i>Add stock
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-5">
    <div class="card app-card bg-light-subtle">
      <div class="card-header bg-transparent"><h2 class="h6 fw-semibold mb-0">What this does</h2></div>
      <div class="card-body small text-muted">
        <ul class="ps-3 mb-3">
          <li class="mb-2">Adds the quantity to the selected branch's balance.</li>
          <li class="mb-2">Writes a signed <strong>IN</strong> movement to the stock ledger with a <span class="font-monospace">REC-####</span> reference.</li>
          <li class="mb-2">Updates the catalogue total and moving-average cost.</li>
          <li class="mb-0">Creates one serial record per unit for serialised products, stamped with the item's warranty defaults.</li>
        </ul>
        <div class="alert alert-light border small mb-0 py-2">
          <i class="bi bi-info-circle me-1"></i>
          Use this for walk-in purchases and opening stock. For ordered goods with a supplier invoice, a purchase GRN remains the best record.
        </div>
      </div>
    </div>

    <div class="card app-card mt-3">
      <div class="card-header bg-transparent"><h2 class="h6 fw-semibold mb-0">Branches</h2></div>
      <div class="list-group list-group-flush">
        <% branches.forEach(function (branch) { %>
          <a href="/branches/<%= branch._id %>/stock" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <span><i class="bi bi-shop me-2 text-muted"></i><%= branch.name %></span>
            <span class="badge text-bg-light border font-monospace"><%= branch.code %></span>
          </a>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<script src="/js/inventory.js"></script>
