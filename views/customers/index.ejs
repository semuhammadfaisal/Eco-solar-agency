<%
  var headerActions = can('customers.manage')
    ? [{ label: 'Add customer', url: '/customers/new', icon: 'bi-person-plus', class: 'btn-primary' }]
    : [];
%>

<%- include('../partials/page-header', {
  heading: 'Customers',
  subheading: 'Every residential, commercial and industrial customer in one place.',
  actions: headerActions
}) %>

<div class="card app-card mt-3">
  <div class="card-body border-bottom">
    <form method="GET" action="/customers" class="row g-2 align-items-end">
      <div class="col-12 col-md-4">
        <label for="search" class="form-label small text-muted mb-1">Search</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="search" class="form-control" id="search" name="search"
                 value="<%= filters.search %>" placeholder="Code, name, phone, CNIC, reference">
        </div>
      </div>

      <div class="col-6 col-md-2">
        <label for="type" class="form-label small text-muted mb-1">Type</label>
        <select class="form-select" id="type" name="type">
          <option value="">All types</option>
          <% crm.CUSTOMER_TYPES.forEach(function (type) { %>
            <option value="<%= type %>"<%= filters.type === type ? ' selected' : '' %>><%= crm.CUSTOMER_TYPE_LABELS[type] %></option>
          <% }); %>
        </select>
      </div>

      <div class="col-6 col-md-2">
        <label for="city" class="form-label small text-muted mb-1">City</label>
        <select class="form-select" id="city" name="city">
          <option value="">All cities</option>
          <% cities.forEach(function (city) { %>
            <option value="<%= city %>"<%= filters.city === city ? ' selected' : '' %>><%= city %></option>
          <% }); %>
        </select>
      </div>

      <div class="col-6 col-md-2">
        <label for="source" class="form-label small text-muted mb-1">Source</label>
        <select class="form-select" id="source" name="source">
          <option value="">All sources</option>
          <% crm.CUSTOMER_SOURCES.forEach(function (source) { %>
            <option value="<%= source %>"<%= filters.source === source ? ' selected' : '' %>><%= crm.CUSTOMER_SOURCE_LABELS[source] %></option>
          <% }); %>
        </select>
      </div>

      <div class="col-6 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">
          <i class="bi bi-funnel me-1"></i>Filter
        </button>
        <a href="/customers" class="btn btn-outline-secondary">Reset</a>
      </div>
    </form>
  </div>

  <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
    <span class="small text-muted">
      <strong><%= total %></strong> customer<%= total === 1 ? '' : 's' %> found
    </span>
    <% if (filters.search || filters.type || filters.city || filters.source || filters.disco) { %>
      <span class="badge text-bg-light border">Filtered</span>
    <% } %>
  </div>

  <%
    var rows = customers.map(function (customer) {
      var typeBadge = crm.CUSTOMER_TYPE_BADGES[customer.type] || 'secondary';
      var typeLabel = crm.CUSTOMER_TYPE_LABELS[customer.type] || customer.type;
      var assigned = customer.assignedTo ? customer.assignedTo.name : '';
      var actions =
        '<a class="btn btn-sm btn-outline-secondary" href="/customers/' + customer._id + '" title="View profile">' +
          '<i class="bi bi-eye"></i>' +
        '</a>';

      if (can('customers.manage')) {
        actions +=
          '<a class="btn btn-sm btn-outline-secondary" href="/customers/' + customer._id + '/edit" title="Edit customer">' +
            '<i class="bi bi-pencil"></i>' +
          '</a>' +
          '<button type="button" class="btn btn-sm btn-outline-danger" title="Delete customer"' +
            ' data-delete-url="/customers/' + customer._id + '"' +
            ' data-delete-name="' + escapeHtml(customer.name) + '">' +
            '<i class="bi bi-trash"></i>' +
          '</button>';
      }

      return {
        cells: [
          { html:
            '<div class="min-w-0">' +
              '<div class="fw-semibold text-truncate">' + escapeHtml(customer.name) + '</div>' +
              '<div class="text-muted small"><span class="font-monospace">' + escapeHtml(customer.code) + '</span>' +
                ' · ' + escapeHtml(customer.phone) + '</div>' +
            '</div>'
          },
          { html: '<span class="badge text-bg-' + typeBadge + '">' + escapeHtml(typeLabel) + '</span>' },
          { html:
            '<div class="small">' + escapeHtml(customer.city || '—') +
              (customer.area ? '<div class="text-muted">' + escapeHtml(customer.area) + '</div>' : '') +
            '</div>'
          },
          { html:
            '<div class="small">' + escapeHtml(customer.disco || '—') +
              (customer.electricityReferenceNo
                ? '<div class="text-muted font-monospace">' + escapeHtml(customer.electricityReferenceNo) + '</div>'
                : '') +
            '</div>'
          },
          { html: '<span class="small text-muted">' + escapeHtml(crm.CUSTOMER_SOURCE_LABELS[customer.source] || customer.source) + '</span>' },
          { html: '<span class="small text-muted">' + escapeHtml(assigned || '—') + '</span>' },
          { html: '<span class="small text-muted">' + formatDate(customer.createdAt) + '</span>' },
          { class: 'text-end', html: '<div class="d-flex justify-content-end gap-1">' + actions + '</div>' }
        ]
      };
    });
  %>

  <%- include('../partials/table', {
    columns: [
      { label: 'Customer' },
      { label: 'Type' },
      { label: 'City / Area' },
      { label: 'DISCO' },
      { label: 'Source' },
      { label: 'Assigned' },
      { label: 'Added' },
      { label: '', class: 'text-end', width: '140px' }
    ],
    rows: rows,
    empty: 'No customers match your filters.'
  }) %>

  <%- include('../partials/pagination', { pagination: pagination }) %>
</div>
