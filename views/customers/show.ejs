<%
  var tabLabels = {
    overview: 'Overview',
    surveys: 'Surveys',
    quotations: 'Quotations',
    installments: 'Installments',
    installations: 'Installations',
    warranty: 'Warranty',
    complaints: 'Complaints'
  };
  var headerActions = [];
  if (can('customers.manage')) {
    headerActions.push({ label: 'Edit customer', url: '/customers/' + customer._id + '/edit', icon: 'bi-pencil', class: 'btn-primary' });
  }
  headerActions.push({ label: 'Back to customers', url: '/customers', icon: 'bi-arrow-left', class: 'btn-outline-secondary' });
%>

<%- include('../partials/page-header', {
  heading: customer.name,
  subheading: customer.code + ' · ' + (crm.CUSTOMER_TYPE_LABELS[customer.type] || customer.type),
  actions: headerActions
}) %>

<div class="card app-card mt-3">
  <div class="card-body p-4">
    <div class="d-flex flex-wrap gap-3 align-items-center">
      <span class="avatar" style="width:56px;height:56px;font-size:1rem"><%= initials(customer.name) %></span>
      <div class="flex-grow-1 min-w-0">
        <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
          <h2 class="h5 fw-bold mb-0"><%= customer.name %></h2>
          <span class="badge text-bg-<%= crm.CUSTOMER_TYPE_BADGES[customer.type] || 'secondary' %>">
            <%= crm.CUSTOMER_TYPE_LABELS[customer.type] || customer.type %>
          </span>
          <span class="badge text-bg-light border font-monospace"><%= customer.code %></span>
        </div>
        <div class="text-muted small d-flex flex-wrap gap-3">
          <span><i class="bi bi-telephone me-1"></i><%= customer.phone %></span>
          <% if (customer.city) { %><span><i class="bi bi-geo-alt me-1"></i><%= customer.city %><%= customer.area ? ' · ' + customer.area : '' %></span><% } %>
          <% if (customer.disco) { %><span><i class="bi bi-lightning-charge me-1"></i><%= customer.disco %></span><% } %>
        </div>
      </div>
      <div class="text-end small text-muted">
        <div>Added <%= formatDate(customer.createdAt) %></div>
      </div>
    </div>
  </div>

  <div class="card-header bg-transparent pb-0">
    <ul class="nav nav-tabs app-tabs">
      <% tabs.forEach(function (tab) { %>
        <li class="nav-item">
          <a class="nav-link<%= activeTab === tab ? ' active' : '' %>"
             href="/customers/<%= customer._id %>?tab=<%= tab %>"><%= tabLabels[tab] %></a>
        </li>
      <% }); %>
    </ul>
  </div>

  <div class="card-body p-4">
    <% if (activeTab === 'overview') { %>
      <div class="row g-4">
        <div class="col-12 col-lg-7">
          <h3 class="h6 fw-semibold text-uppercase text-muted mb-3">Contact &amp; location</h3>
          <dl class="row mb-0 small">
            <dt class="col-5 col-sm-4 text-muted fw-normal">Phone</dt>
            <dd class="col-7 col-sm-8"><%= customer.phone %></dd>

            <dt class="col-5 col-sm-4 text-muted fw-normal">WhatsApp</dt>
            <dd class="col-7 col-sm-8"><%= customer.whatsapp || '—' %></dd>

            <dt class="col-5 col-sm-4 text-muted fw-normal">CNIC</dt>
            <dd class="col-7 col-sm-8"><%= customer.cnic || '—' %></dd>

            <dt class="col-5 col-sm-4 text-muted fw-normal">Address</dt>
            <dd class="col-7 col-sm-8"><%= customer.address || '—' %></dd>

            <dt class="col-5 col-sm-4 text-muted fw-normal">City / area</dt>
            <dd class="col-7 col-sm-8"><%= [customer.city, customer.area].filter(Boolean).join(' · ') || '—' %></dd>

            <dt class="col-5 col-sm-4 text-muted fw-normal">GPS</dt>
            <dd class="col-7 col-sm-8"><%= customer.gpsText || '—' %></dd>
          </dl>

          <hr class="my-4">

          <h3 class="h6 fw-semibold text-uppercase text-muted mb-3">Utility &amp; classification</h3>
          <dl class="row mb-0 small">
            <dt class="col-5 col-sm-4 text-muted fw-normal">DISCO</dt>
            <dd class="col-7 col-sm-8"><%= customer.disco || '—' %></dd>

            <dt class="col-5 col-sm-4 text-muted fw-normal">Reference no.</dt>
            <dd class="col-7 col-sm-8 font-monospace"><%= customer.electricityReferenceNo || '—' %></dd>

            <dt class="col-5 col-sm-4 text-muted fw-normal">Type</dt>
            <dd class="col-7 col-sm-8"><%= crm.CUSTOMER_TYPE_LABELS[customer.type] || customer.type %></dd>

            <dt class="col-5 col-sm-4 text-muted fw-normal">Source</dt>
            <dd class="col-7 col-sm-8"><%= crm.CUSTOMER_SOURCE_LABELS[customer.source] || customer.source %></dd>

            <dt class="col-5 col-sm-4 text-muted fw-normal">Assigned to</dt>
            <dd class="col-7 col-sm-8"><%= customer.assignedTo ? customer.assignedTo.name : '—' %></dd>
          </dl>

          <% if (customer.notes) { %>
            <hr class="my-4">
            <h3 class="h6 fw-semibold text-uppercase text-muted mb-2">Notes</h3>
            <p class="small mb-0" style="white-space:pre-line"><%= customer.notes %></p>
          <% } %>
        </div>

        <div class="col-12 col-lg-5">
          <% if (can('customers.manage')) { %>
            <div class="card app-card border-danger-subtle mt-3">
              <div class="card-header bg-transparent">
                <h3 class="h6 fw-semibold mb-0 text-danger">Danger zone</h3>
              </div>
              <div class="card-body">
                <p class="small text-muted">
                  Deleting a customer is a soft delete. History is retained but the profile disappears
                  from lists and searches.
                </p>
                <button type="button" class="btn btn-outline-danger btn-sm"
                        data-delete-url="/customers/<%= customer._id %>"
                        data-delete-name="<%= customer.name %>">
                  <i class="bi bi-trash me-1"></i>Delete customer
                </button>
              </div>
            </div>
          <% } %>
        </div>
      </div>

    <% } else if (activeTab === 'quotations') { %>
      <!-- Official Quotations Section -->
      <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
        <div>
          <h3 class="h6 fw-semibold mb-1">Official Quotations for <%= customer.name %></h3>
          <p class="text-muted small mb-0">Client proposals, revisions, and milestone contracts generated for this customer.</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/quotations/new?customer=<%= customer._id %>" class="btn btn-sm btn-primary">
            <i class="bi bi-file-earmark-plus me-1"></i>New Quotation
          </a>
          <a href="/system-builder?customer=<%= customer._id %>" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-cpu me-1"></i>Build System
          </a>
        </div>
      </div>

      <% if (!customerQuotations || !customerQuotations.length) { %>
        <div class="card app-card bg-light border-0 text-center py-4 text-muted mb-4">
          <i class="bi bi-file-earmark-text fs-3 d-block mb-1"></i>
          <p class="mb-1">No quotations created for this customer yet.</p>
          <a href="/quotations/new?customer=<%= customer._id %>" class="small">Draft the first quotation</a>
        </div>
      <% } else { %>
        <div class="table-responsive mb-4">
          <table class="table table-hover align-middle app-table mb-0">
            <thead>
              <tr>
                <th>Quotation #</th>
                <th>System Type</th>
                <th>Capacity</th>
                <th class="text-end">Final Price</th>
                <th>Status</th>
                <th>Sales Rep</th>
                <th>Date</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% customerQuotations.forEach(function (q) { %>
                <tr>
                  <td>
                    <a href="/quotations/<%= q._id %>" class="font-monospace fw-bold text-decoration-none">
                      <%= q.quotationNumber %> (Rev <%= q.revision %>)
                    </a>
                  </td>
                  <td>
                    <span class="badge text-bg-light border text-uppercase">
                      <%= systems.SYSTEM_TYPE_LABELS[q.systemSummary ? q.systemSummary.systemType : 'on_grid'] || 'Solar' %>
                    </span>
                  </td>
                  <td class="fw-bold text-success"><%= formatQty(q.systemSummary ? q.systemSummary.capacityKw : 0) %> kW</td>
                  <td class="text-end font-monospace fw-bold text-primary"><%= formatPKR(q.finalPricePaisa) %></td>
                  <td>
                    <span class="badge text-bg-<%= quotations.QUOTATION_STATUS_BADGES[q.status] || 'secondary' %>">
                      <%= quotations.QUOTATION_STATUS_LABELS[q.status] || q.status %>
                    </span>
                  </td>
                  <td class="small text-muted"><%= q.assignedTo ? q.assignedTo.name : '—' %></td>
                  <td class="small text-muted"><%= formatDate(q.createdAt) %></td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <a href="/quotations/<%= q._id %>" class="btn btn-outline-primary" title="View details">
                        <i class="bi bi-eye"></i>
                      </a>
                      <a href="/quotations/<%= q._id %>/pdf" target="_blank" class="btn btn-outline-secondary" title="Download PDF">
                        <i class="bi bi-file-earmark-pdf"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

      <!-- Technical System Configs & BOMs Section -->
      <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3 mt-4 pt-3 border-top">
        <div>
          <h3 class="h6 fw-semibold mb-1">System Configurations &amp; BOMs</h3>
          <p class="text-muted small mb-0">Technical bill-of-materials and engineering configurations.</p>
        </div>
      </div>

      <% if (!systemConfigs || !systemConfigs.length) { %>
        <div class="text-center py-4 text-muted">
          <i class="bi bi-cpu fs-3 d-block mb-1"></i>
          <p class="mb-0 small">No technical system configurations saved yet.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle app-table mb-0">
            <thead>
              <tr>
                <th>System #</th>
                <th>System Title</th>
                <th>Type</th>
                <th>Capacity</th>
                <th class="text-end">Final Price</th>
                <th>Approval</th>
                <th>Created</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% systemConfigs.forEach(function (cfg) { %>
                <tr>
                  <td><a href="/system-configs/<%= cfg._id %>" class="font-monospace fw-semibold"><%= cfg.number %></a></td>
                  <td>
                    <a href="/system-configs/<%= cfg._id %>" class="fw-medium text-body"><%= cfg.name %></a>
                    <div class="text-muted small"><%= cfg.lines ? cfg.lines.length : 0 %> items</div>
                  </td>
                  <td>
                    <span class="badge text-bg-<%= systems.SYSTEM_TYPE_BADGES[cfg.systemType] || 'secondary' %>">
                      <%= systems.SYSTEM_TYPE_LABELS[cfg.systemType] || cfg.systemType %>
                    </span>
                  </td>
                  <td class="fw-bold text-success"><%= formatQty(cfg.capacityKw) %> kW</td>
                  <td class="text-end fw-bold text-primary"><%= formatPKR(cfg.finalPricePaisa) %></td>
                  <td>
                    <span class="badge text-bg-<%= systems.APPROVAL_STATUS_BADGES[cfg.approvalStatus] || 'secondary' %>">
                      <%= systems.APPROVAL_STATUS_LABELS[cfg.approvalStatus] || cfg.approvalStatus %>
                    </span>
                  </td>
                  <td class="small text-muted"><%= formatDate(cfg.createdAt) %></td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <a href="/quotations/new?systemConfig=<%= cfg._id %>" class="btn btn-outline-success" title="Draft Quotation from BOM">
                        <i class="bi bi-file-earmark-plus me-1"></i>Quote
                      </a>
                      <a href="/system-configs/<%= cfg._id %>" class="btn btn-outline-primary" title="View BOM">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i>BOM
                      </a>
                      <a href="/system-configs/<%= cfg._id %>/print" target="_blank" class="btn btn-outline-secondary" title="Print BOM">
                        <i class="bi bi-printer"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

    <% } else if (activeTab === 'installments') { %>
      <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
        <div>
          <h3 class="h6 fw-semibold mb-1">Installment Plans &amp; Financial Ledger</h3>
          <p class="text-muted small mb-0">Active financing contracts, payment allocations, and running account balances.</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/installments/ledger/<%= customer._id %>/pdf" target="_blank" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-file-earmark-pdf me-1"></i>Statement PDF
          </a>
          <a href="/installments/ledger/<%= customer._id %>" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-journal-text me-1"></i>Full Ledger
          </a>
        </div>
      </div>

      <% if (!installmentLedger || !installmentLedger.plans.length) { %>
        <div class="card app-card bg-light border-0 text-center py-5 text-muted">
          <i class="bi bi-calendar3-range fs-1 d-block mb-2"></i>
          <h4 class="h6 fw-semibold text-dark">No installment plans found</h4>
          <p class="small mb-3">No active or past installment plans have been registered for <%= customer.name %>.</p>
          <a href="/installments/new" class="btn btn-sm btn-primary">Create Installment Plan</a>
        </div>
      <% } else { %>
        <!-- Summary Cards -->
        <% var sum = installmentLedger.summary; %>
        <div class="row g-2 mb-4">
          <div class="col-6 col-md-3">
            <div class="card app-card border-primary-subtle text-center p-3 h-100">
              <div class="text-uppercase small text-muted fw-semibold">Total Financed</div>
              <div class="fs-5 fw-bold text-dark"><%= formatPKR(sum.totalFinancedPaisa) %></div>
              <div class="small text-muted">Markup: <%= formatPKR(sum.totalMarkupPaisa) %></div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card app-card border-secondary-subtle text-center p-3 h-100">
              <div class="text-uppercase small text-muted fw-semibold">Down Payments</div>
              <div class="fs-5 fw-bold text-secondary"><%= formatPKR(sum.totalDownPaymentsPaisa) %></div>
              <div class="small text-muted">Advance booking</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card app-card border-success-subtle text-center p-3 h-100">
              <div class="text-uppercase small text-muted fw-semibold">Total Recovered</div>
              <div class="fs-5 fw-bold text-success"><%= formatPKR(sum.totalPaidPaisa) %></div>
              <div class="small text-muted">Receipts cleared</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card app-card border-danger-subtle text-center p-3 h-100">
              <div class="text-uppercase small text-muted fw-semibold">Outstanding Balance</div>
              <div class="fs-5 fw-bold text-danger"><%= formatPKR(sum.totalRemainingBalancePaisa) %></div>
              <div class="small text-muted">Current receivable</div>
            </div>
          </div>
        </div>

        <!-- Plans Table -->
        <h4 class="h6 fw-bold text-primary mb-2"><i class="bi bi-calendar3-range me-1"></i>Financing Plans (<%= installmentLedger.plans.length %>)</h4>
        <div class="table-responsive mb-4">
          <table class="table table-hover align-middle app-table mb-0">
            <thead>
              <tr>
                <th>Plan #</th>
                <th>Sale #</th>
                <th>Installments</th>
                <th class="text-end">Total Payable</th>
                <th class="text-end">Recovered</th>
                <th class="text-end">Balance</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% installmentLedger.plans.forEach(function (plan) { %>
                <tr>
                  <td>
                    <a href="/installments/<%= plan._id %>" class="font-monospace fw-bold text-decoration-none">
                      <%= plan.planNumber %>
                    </a>
                  </td>
                  <td>
                    <% if (plan.sale) { %>
                      <a href="/projects/<%= plan.sale._id || plan.sale %>" class="font-monospace small">
                        <%= plan.sale.saleNumber || 'Sale' %>
                      </a>
                    <% } else { %>—<% } %>
                  </td>
                  <td class="small"><%= plan.installmentCount %> × <%= installments.FREQUENCY_LABELS[plan.frequency] || plan.frequency %></td>
                  <td class="text-end font-monospace fw-bold"><%= formatPKR(plan.totalPayablePaisa) %></td>
                  <td class="text-end font-monospace text-success"><%= formatPKR(plan.totalPaidPaisa) %></td>
                  <td class="text-end font-monospace fw-bold text-danger"><%= formatPKR(plan.remainingBalancePaisa) %></td>
                  <td>
                    <span class="badge text-bg-<%= installments.PLAN_STATUS_BADGES[plan.status] || 'secondary' %>">
                      <%= installments.PLAN_STATUS_LABELS[plan.status] || plan.status %>
                    </span>
                  </td>
                  <td class="text-end">
                    <a href="/installments/<%= plan._id %>" class="btn btn-sm btn-outline-primary">View Plan</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

    <% } else if (activeTab === 'installations') { %>
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="h6 fw-semibold text-uppercase text-muted mb-0">Installation Projects (<%= customerInstallations.length %>)</h3>
      </div>
      <% if (!customerInstallations.length) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-tools fs-2 d-block mb-3"></i>
          <p class="mb-0 small">No installation projects linked to this customer yet.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle app-table mb-0">
            <thead>
              <tr>
                <th>Installation #</th>
                <th>Lead Technician</th>
                <th>Scheduled Date</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% customerInstallations.forEach(function (inst) { %>
                <tr>
                  <td>
                    <a href="/installations/<%= inst._id %>" class="font-monospace fw-bold text-decoration-none">
                      <%= inst.installationNumber %>
                    </a>
                  </td>
                  <td><%= inst.leadTechnician ? inst.leadTechnician.name : 'Unassigned' %></td>
                  <td><%= inst.scheduledStartDate ? formatDate(inst.scheduledStartDate) : 'Not scheduled' %></td>
                  <td>
                    <span class="badge text-bg-<%= installationsConfig.INSTALLATION_STATUS_BADGES[inst.status] || 'secondary' %>">
                      <%= installationsConfig.INSTALLATION_STATUS_LABELS[inst.status] || inst.status %>
                    </span>
                  </td>
                  <td class="text-end">
                    <a href="/installations/<%= inst._id %>" class="btn btn-sm btn-outline-primary me-1">View Project</a>
                    <% if (['completed', 'commissioned'].includes(inst.status)) { %>
                      <a href="/installations/<%= inst._id %>/commissioning-pdf" target="_blank" class="btn btn-sm btn-outline-secondary" title="Commissioning PDF">
                        <i class="bi bi-file-earmark-pdf"></i>
                      </a>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

    <% } else if (activeTab === 'warranty') { %>
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="h6 fw-semibold text-uppercase text-muted mb-0">Active & Registered Warranties (<%= customerWarranties.length %>)</h3>
      </div>
      <% if (!customerWarranties.length) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-shield-check fs-2 d-block mb-3"></i>
          <p class="mb-0 small">No warranties registered for this customer yet.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle app-table mb-0">
            <thead>
              <tr>
                <th>Certificate #</th>
                <th>Equipment Covered</th>
                <th>Serial Number</th>
                <th>Warranty Classification</th>
                <th>Validity Period</th>
                <th>Status</th>
                <th class="text-end">Certificate PDF</th>
              </tr>
            </thead>
            <tbody>
              <% customerWarranties.forEach(function (war) { %>
                <tr>
                  <td>
                    <a href="/warranties/<%= war._id %>" class="font-monospace fw-bold text-decoration-none">
                      <%= war.warrantyNumber %>
                    </a>
                  </td>
                  <td><%= war.item ? war.item.name : 'Component' %></td>
                  <td><code><%= war.serialString || 'Standard' %></code></td>
                  <td>
                    <span class="badge text-bg-<%= installationsConfig.WARRANTY_TYPE_BADGES[war.warrantyType] || 'secondary' %>">
                      <%= installationsConfig.WARRANTY_TYPE_LABELS[war.warrantyType] || war.warrantyType %>
                    </span>
                  </td>
                  <td class="small">
                    <%= formatDate(war.startDate) %> to <strong><%= formatDate(war.endDate) %></strong>
                    (<%= war.years %>y)
                  </td>
                  <td>
                    <span class="badge text-bg-<%= installationsConfig.WARRANTY_STATUS_BADGES[war.status] || 'secondary' %>">
                      <%= installationsConfig.WARRANTY_STATUS_LABELS[war.status] || war.status %>
                    </span>
                  </td>
                  <td class="text-end">
                    <a href="/warranties/<%= war._id %>/certificate-pdf" target="_blank" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-file-earmark-pdf me-1"></i>Certificate
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

    <% } else if (activeTab === 'complaints') { %>
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="h6 fw-semibold text-uppercase text-muted mb-0">Service & Complaint History (<%= customerComplaints.length %>)</h3>
        <a href="/complaints?customer=<%= customer._id %>" class="btn btn-sm btn-primary">
          <i class="bi bi-plus-lg me-1"></i>New Ticket
        </a>
      </div>
      <% if (!customerComplaints.length) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-headset fs-2 d-block mb-3"></i>
          <p class="mb-0 small">No complaints or service tickets on record for this customer.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle app-table mb-0">
            <thead>
              <tr>
                <th>Ticket #</th>
                <th>Issue Category</th>
                <th>Priority</th>
                <th>Warranty Status</th>
                <th>Technician</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% customerComplaints.forEach(function (cmp) { %>
                <tr>
                  <td>
                    <a href="/complaints/<%= cmp._id %>" class="font-monospace fw-bold text-decoration-none">
                      <%= cmp.ticketNumber %>
                    </a>
                  </td>
                  <td>
                    <span class="badge text-bg-light border">
                      <%= installationsConfig.COMPLAINT_TYPE_LABELS[cmp.issueType] || cmp.issueType %>
                    </span>
                  </td>
                  <td>
                    <span class="badge text-bg-<%= installationsConfig.COMPLAINT_PRIORITY_BADGES[cmp.priority] || 'secondary' %>">
                      <%= cmp.priority ? cmp.priority.toUpperCase() : 'MEDIUM' %>
                    </span>
                  </td>
                  <td>
                    <% if (cmp.isUnderWarranty) { %>
                      <span class="badge text-bg-success">Under Warranty</span>
                    <% } else { %>
                      <span class="badge text-bg-warning">Paid Service</span>
                    <% } %>
                  </td>
                  <td><%= cmp.assignedTechnician ? cmp.assignedTechnician.name : 'Unassigned' %></td>
                  <td>
                    <span class="badge text-bg-<%= installationsConfig.COMPLAINT_STATUS_BADGES[cmp.status] || 'secondary' %>">
                      <%= installationsConfig.COMPLAINT_STATUS_LABELS[cmp.status] || cmp.status %>
                    </span>
                  </td>
                  <td class="text-end">
                    <a href="/complaints/<%= cmp._id %>" class="btn btn-sm btn-outline-primary">View Ticket</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

    <% } else { %>
      <div class="text-center py-5 text-muted">
        <i class="bi bi-tools fs-2 d-block mb-3"></i>
        <h3 class="h6 fw-semibold text-body"><%= tabLabels[activeTab] %></h3>
        <p class="mb-0 small">
          This tab will be connected when the <%= tabLabels[activeTab].toLowerCase() %> module is added.
          The customer profile is already ready for it.
        </p>
      </div>
    <% } %>
  </div>
</div>
