<%- include('../partials/page-header', { heading: 'Solar Brands', subheading: 'Reusable brands linked to products and consolidated stock.', actions: can('brands.manage') ? [{ label: 'Add brand', url: '/brands/new', icon: 'bi-plus-lg', class: 'btn-primary' }] : [] }) %>
<div class="card app-card mt-3"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Brand</th><th>Contact</th><th class="text-end">Products</th><th>Status</th><th></th></tr></thead><tbody>
<% if (!brands.length) { %><tr><td colspan="5" class="text-center text-muted py-5">No brands yet. Existing typed brand names remain available until converted.</td></tr><% } %>
<% brands.forEach(function(brand){ %><tr><td><strong><%= brand.name %></strong><div class="small text-muted"><%= brand.description || '' %></div></td><td><%= brand.contactName || '—' %><div class="small text-muted"><%= brand.phone %></div></td><td class="text-end"><%= brand.productCount %></td><td><span class="badge text-bg-<%= brand.isActive ? 'success' : 'secondary' %>"><%= brand.isActive ? 'Active' : 'Inactive' %></span></td><td class="text-end"><% if (can('brands.manage')) { %><a class="btn btn-sm btn-outline-secondary" href="/brands/<%= brand._id %>/edit">Edit</a><% } %></td></tr><% }) %>
</tbody></table></div></div>
