<%
  var groups = inventory.ITEM_CATEGORIES.map(function (key) {
    return {
      key: key,
      label: inventory.ITEM_CATEGORY_LABELS[key],
      items: items.filter(function (item) { return item.category === key; })
    };
  }).filter(function (group) { return group.items.length; });

  function costValue(item) {
    return canViewCosts ? Number(item.avgCostPaisa || 0) / 100 : '';
  }

  function branchPriceValue(item) {
    return Number(item.retailPricePaisa || item.sellingPricePaisa || item.avgCostPaisa || 0) / 100;
  }
%>

<%- include('../partials/page-header', {
  heading: 'New Stock Transfer',
  subheading: 'Stock leaves the source and arrives at the destination immediately, with its transfer price and margin recorded.',
  actions: [{ label: 'Back', url: '/transfers', icon: 'bi-arrow-left', class: 'btn-outline-secondary' }]
}) %>

<div class="row g-3 g-lg-4 mt-1">
  <div class="col-12 col-xl-9">
    <div class="card app-card">
      <div class="card-body p-4">
        <%- include('../partials/form-errors') %>

        <form method="POST" action="/transfers" data-transfer-form data-once novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label" for="sourceBranch">Source branch <span class="text-danger">*</span></label>
              <select class="form-select" id="sourceBranch" name="sourceBranch" required
                      onchange="window.location.href='/transfers/new?source='+encodeURIComponent(this.value)">
                <% sourceBranches.forEach(function (branch) { %>
                  <option value="<%= branch._id %>"<%= sourceBranchId === String(branch._id) ? ' selected' : '' %>>
                    <%= branch.code %> — <%= branch.name %>
                  </option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="destinationBranch">Destination branch <span class="text-danger">*</span></label>
              <select class="form-select" id="destinationBranch" name="destinationBranch" required>
                <% if (!destinationBranches.length) { %>
                  <option value="">No other branch available</option>
                <% } %>
                <% destinationBranches.forEach(function (branch) { %>
                  <option value="<%= branch._id %>"><%= branch.code %> — <%= branch.name %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-2">
            <h2 class="h6 fw-semibold text-uppercase text-muted mb-0">Products</h2>
            <button type="button" class="btn btn-sm btn-outline-primary" data-add-line>
              <i class="bi bi-plus-lg me-1"></i>Add line
            </button>
          </div>

          <% if (!items.length) { %>
            <div class="alert alert-warning mb-3">No stock is available at this branch to transfer.</div>
          <% } %>

          <div class="table-responsive border rounded">
            <table class="table align-middle app-table mb-0" id="transferLines">
              <thead>
                <tr>
                  <th style="min-width:220px">Product</th>
                  <th style="width:110px" class="text-end">Available</th>
                  <th style="width:110px" class="text-end">Quantity</th>
                  <% if (canViewCosts) { %>
                    <th style="width:130px" class="text-end">Purchase price</th>
                  <% } %>
                  <th style="width:150px" class="text-end">Branch price (PKR)</th>
                  <% if (canViewCosts) { %>
                    <th style="width:130px" class="text-end">Profit</th>
                  <% } %>
                  <th style="width:48px"></th>
                </tr>
              </thead>
              <tbody data-transfer-lines>
                <tr data-line>
                  <td>
                    <select class="form-select form-select-sm" name="item" data-line-item>
                      <option value="">Select product…</option>
                      <% groups.forEach(function (group) { %>
                        <optgroup label="<%= group.label %>">
                          <% group.items.forEach(function (item) { %>
                            <option value="<%= item._id %>"
                                    data-cost="<%= costValue(item) %>"
                                    data-price="<%= branchPriceValue(item) %>"
                                    data-stock="<%= item.branchStock %>"
                                    data-unit="<%= item.unit %>"
                                    data-sku="<%= item.sku %>">
                              <%= item.sku %> — <%= item.name %>
                            </option>
                          <% }); %>
                        </optgroup>
                      <% }); %>
                    </select>
                  </td>
                  <td class="text-end small text-muted" data-line-available>—</td>
                  <td>
                    <input type="number" class="form-control form-control-sm text-end" name="quantity"
                           min="0.0001" step="any" inputmode="decimal" data-line-qty placeholder="0">
                  </td>
                  <% if (canViewCosts) { %>
                    <td class="text-end small" data-line-cost-display>—</td>
                  <% } %>
                  <td>
                    <input type="text" class="form-control form-control-sm text-end" name="branchPrice"
                           inputmode="decimal" data-line-price placeholder="0.00">
                  </td>
                  <% if (canViewCosts) { %>
                    <td class="text-end small fw-semibold" data-line-profit>—</td>
                  <% } %>
                  <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger" data-remove-line title="Remove line">
                      <i class="bi bi-x-lg"></i>
                    </button>
                  </td>
                </tr>
              </tbody>
              <tfoot>
                <tr>
                  <th colspan="3" class="text-end text-uppercase small text-muted">
                    Transfer totals
                  </th>
                  <% if (canViewCosts) { %>
                    <th class="text-end" data-total-cost>0</th>
                  <% } %>
                  <th class="text-end" data-total-branch>0</th>
                  <% if (canViewCosts) { %>
                    <th class="text-end" data-total-profit>0</th>
                  <% } %>
                  <th></th>
                </tr>
                <tr>
                  <td colspan="<%= canViewCosts ? 7 : 5 %>" class="text-end small text-muted pt-0 border-0">
                    <% if (canViewCosts) { %>
                      Inventory value <span class="fw-semibold text-body" data-total-cost-label>0</span>
                      &nbsp;·&nbsp;
                    <% } %>
                    Branch value <span class="fw-semibold text-body" data-total-branch-label>0</span>
                    <% if (canViewCosts) { %>
                      &nbsp;·&nbsp; Profit <span class="fw-semibold text-body" data-total-profit-label>0</span>
                    <% } %>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>

          <div class="form-text mt-2">
            Branch price defaults to the retail price. Profit is branch price minus purchase price, per unit.
            <% if (!canViewCosts) { %>
              Purchase costs are hidden for your role.
            <% } %>
          </div>

          <div class="mt-3">
            <label class="form-label" for="notes">Notes</label>
            <textarea class="form-control" id="notes" name="notes" rows="2" maxlength="1000"
                      placeholder="Reason for transfer, agreed branch rate…"></textarea>
          </div>

          <div class="d-flex flex-wrap gap-2 justify-content-end mt-4">
            <a href="/transfers" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary" <%= items.length ? '' : 'disabled' %>
                    onclick="return confirm('Transfer this stock now?')">
              <i class="bi bi-check2-circle me-1"></i>Complete transfer
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-3">
    <div class="card app-card bg-light-subtle">
      <div class="card-header bg-transparent"><h2 class="h6 fw-semibold mb-0">How the numbers work</h2></div>
      <div class="card-body small text-muted">
        <ul class="ps-3 mb-3">
          <li class="mb-2"><strong>Purchase price</strong> is the moving-average cost of the unit at the source branch.</li>
          <li class="mb-2"><strong>Branch price</strong> is what the destination branch takes the unit at. It defaults to retail but can be edited.</li>
          <li class="mb-2"><strong>Profit</strong> = (branch price − purchase price) × quantity. A negative figure is a loss on the transfer.</li>
          <li class="mb-0"><strong>Inventory value</strong> is the cost leaving the source; <strong>branch value</strong> is the value arriving at the destination.</li>
        </ul>
        <div class="alert alert-light border small mb-0 py-2">
          <i class="bi bi-lock me-1"></i>
          <% if (canViewCosts) { %>
            Purchase prices and profit are only shown to owner, accountant and storekeeper roles.
          <% } else { %>
            Your role can record branch prices but cannot see purchase prices or profit.
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<template id="transferLineTemplate">
  <tr data-line>
    <td>
      <select class="form-select form-select-sm" name="item" data-line-item>
        <option value="">Select product…</option>
        <% groups.forEach(function (group) { %>
          <optgroup label="<%= group.label %>">
            <% group.items.forEach(function (item) { %>
              <option value="<%= item._id %>"
                      data-cost="<%= costValue(item) %>"
                      data-price="<%= branchPriceValue(item) %>"
                      data-stock="<%= item.branchStock %>"
                      data-unit="<%= item.unit %>"
                      data-sku="<%= item.sku %>">
                <%= item.sku %> — <%= item.name %>
              </option>
            <% }); %>
          </optgroup>
        <% }); %>
      </select>
    </td>
    <td class="text-end small text-muted" data-line-available>—</td>
    <td>
      <input type="number" class="form-control form-control-sm text-end" name="quantity"
             min="0.0001" step="any" inputmode="decimal" data-line-qty placeholder="0">
    </td>
    <% if (canViewCosts) { %>
      <td class="text-end small" data-line-cost-display>—</td>
    <% } %>
    <td>
      <input type="text" class="form-control form-control-sm text-end" name="branchPrice"
             inputmode="decimal" data-line-price placeholder="0.00">
    </td>
    <% if (canViewCosts) { %>
      <td class="text-end small fw-semibold" data-line-profit>—</td>
    <% } %>
    <td class="text-end">
      <button type="button" class="btn btn-sm btn-outline-danger" data-remove-line title="Remove line">
        <i class="bi bi-x-lg"></i>
      </button>
    </td>
  </tr>
</template>

<script src="/js/inventory.js"></script>
