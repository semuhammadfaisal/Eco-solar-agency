<% if (!printMode) { %>
  <%- include('../partials/page-header', { heading: sale.number, subheading: 'POS receipt · ' + formatDateTime(sale.soldAt) + (sale.status === 'cancelled' ? ' · CANCELLED' : ''), actions: [{ label: 'Print receipt', url: '/pos/' + sale._id + '?print=1', icon: 'bi-printer', class: 'btn-primary' }, { label: 'Back', url: '/pos', icon: 'bi-arrow-left', class: 'btn-outline-secondary' }] }) %>
  <% if (sale.status === 'completed' && can('pos.cancel')) { %><form method="POST" action="/pos/<%= sale._id %>/cancel" class="text-end mt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger" onclick="return confirm('Cancel this sale and restore all stock?')">Cancel sale</button></form><% } %>
<% } %>
<div class="card app-card <%= printMode ? 'border-0' : 'mt-3' %>"><div class="card-body p-4"><div class="text-center mb-4"><h1 class="h4"><%= settings.companyName || appName %></h1><div class="font-monospace"><%= sale.number %></div><div class="small text-muted"><%= formatDateTime(sale.soldAt) %> · <%= sale.branch.name %></div><% if(sale.status === 'cancelled'){ %><div class="badge text-bg-danger mt-2">CANCELLED</div><% } %></div><div class="row small mb-3"><div class="col-6"><strong>Customer:</strong> <%= sale.customerName %><br><%= sale.customerPhone %></div><div class="col-6 text-end"><strong>Type:</strong> <%= sale.saleType %><br><strong>Payment:</strong> <%= sale.paymentMethod %></div></div><table class="table table-sm"><thead><tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Rate</th><th class="text-end">Discount</th><th class="text-end">Total</th></tr></thead><tbody><% sale.items.forEach(function(line){ %><tr><td><%= line.name %><div class="small text-muted"><%= line.sku %></div></td><td class="text-end"><%= formatQty(line.quantity) %> <%= line.unit %></td><td class="text-end"><%= formatPKR(line.unitPricePaisa) %></td><td class="text-end"><%= formatPKR(line.discountPaisa) %></td><td class="text-end fw-bold"><%= formatPKR(line.lineTotalPaisa) %></td></tr><% }) %></tbody><tfoot><tr><th colspan="4" class="text-end">Subtotal</th><th class="text-end"><%= formatPKR(sale.subtotalPaisa) %></th></tr><tr><th colspan="4" class="text-end">Discount</th><th class="text-end"><%= formatPKR(sale.discountPaisa) %></th></tr><tr><th colspan="4" class="text-end">Grand total</th><th class="text-end fs-5"><%= formatPKR(sale.totalPaisa) %></th></tr><tr><th colspan="4" class="text-end">Paid / Due</th><th class="text-end"><%= formatPKR(sale.paidPaisa) %> / <%= formatPKR(sale.duePaisa) %></th></tr></tfoot></table><div class="text-center small text-muted mt-4">Thank you for your business.</div></div></div><% if(printMode){ %><script>window.print()</script><% } %>
