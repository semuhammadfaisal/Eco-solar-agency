<%- include('../partials/page-header', { heading: 'Fast Sales / POS', subheading: 'Daily retail and wholesale counter sales.', actions: can('pos.sell') ? [{ label: 'New sale', url: '/pos/new', icon: 'bi-plus-lg', class: 'btn-primary' }] : [] }) %>
<div class="row g-3 mt-1"><div class="col-md-4"><div class="card app-card p-3"><div class="small text-muted">Sales</div><div class="h4 mb-0"><%= formatPKR(totals.sales) %></div></div></div><div class="col-md-4"><div class="card app-card p-3"><div class="small text-muted">Discounts</div><div class="h4 mb-0"><%= formatPKR(totals.discount) %></div></div></div><div class="col-md-4"><div class="card app-card p-3"><div class="small text-muted">Profit</div><div class="h4 mb-0"><%= can('profit.view') ? formatPKR(totals.profit) : 'Restricted' %></div></div></div></div>
<div class="card app-card mt-3"><div class="card-body border-bottom"><form class="row g-2"><div class="col-md-3"><select class="form-select" name="branch"><option value="">All branches</option><% branches.forEach(function(b){ %><option value="<%= b._id %>" <%= filters.branch === String(b._id) ? 'selected' : '' %>><%= b.name %></option><% }) %></select></div><div class="col-md-3"><input class="form-control" type="date" name="from" value="<%= filters.from %>"></div><div class="col-md-3"><input class="form-control" type="date" name="to" value="<%= filters.to %>"></div><div class="col-md-3"><button class="btn btn-outline-primary">Filter</button></div></form></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Invoice</th><th>Date</th><th>Branch</th><th>Customer</th><th>Type</th><th class="text-end">Discount</th><th class="text-end">Total</th><th>Cashier</th></tr></thead><tbody><% sales.forEach(function(s){ %><tr><td><a class="font-monospace fw-semibold" href="/pos/<%= s._id %>"><%= s.number %></a></td><td><%= formatDateTime(s.soldAt) %></td><td><%= s.branch ? s.branch.name : '—' %></td><td><%= s.customerName %></td><td><span class="badge text-bg-light border"><%= s.saleType %></span></td><td class="text-end"><%= formatPKR(s.discountPaisa) %></td><td class="text-end fw-bold"><%= formatPKR(s.totalPaisa) %></td><td><%= s.createdBy ? s.createdBy.name : '—' %></td></tr><% }) %></tbody></table></div></div>
