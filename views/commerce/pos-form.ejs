<%- include('../partials/page-header', { heading: 'New POS Sale', subheading: 'Stock is deducted from the selected branch when this bill is completed.', actions: [{ label: 'Sales history', url: '/pos', icon: 'bi-arrow-left', class: 'btn-outline-secondary' }] }) %>
<div class="card app-card mt-3"><div class="card-body p-4"><form method="POST" action="/pos" id="posForm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><div class="col-md-4"><label class="form-label">Branch *</label><select class="form-select" name="branch" required><% branches.forEach(function(b){ %><option value="<%= b._id %>" <%= String(branch._id) === String(b._id) ? 'selected' : '' %>><%= b.name %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Sale type</label><select class="form-select" name="saleType" id="saleType"><option value="retail">Retail</option><option value="wholesale">Wholesale</option></select></div><div class="col-md-4"><label class="form-label">Payment</label><select class="form-select" name="paymentMethod"><option value="cash">Cash</option><option value="bank">Bank</option><option value="credit">Credit</option><option value="mixed">Mixed</option></select></div><div class="col-md-4"><label class="form-label">Customer name</label><input class="form-control" name="customerName" value="Walk-in Customer"></div><div class="col-md-4"><label class="form-label">Phone</label><input class="form-control" name="customerPhone"></div><div class="col-md-4"><label class="form-label">Paid amount (PKR)</label><input class="form-control" name="paid" inputmode="decimal" placeholder="Blank = fully paid"></div></div>
<hr><div class="table-responsive"><table class="table align-middle"><thead><tr><th style="min-width:280px">Product</th><th>Stock</th><th>Qty</th><th>Unit price</th><th>Discount</th></tr></thead><tbody><% for(var i=0;i<10;i++){ %><tr><td><select class="form-select product-select" name="item"><option value="">Select product</option><% products.forEach(function(p){ %><option value="<%= p._id %>" data-stock="<%= p.stock %>" data-retail="<%= p.retailPricePaisa / 100 %>" data-wholesale="<%= p.wholesalePricePaisa / 100 %>"><%= p.sku %> — <%= p.name %> (<%= p.brand || 'No brand' %>)</option><% }) %></select></td><td class="stock-cell text-muted">—</td><td><input class="form-control" type="number" name="quantity" min="0" step="0.001"></td><td><input class="form-control price-input" name="unitPrice" inputmode="decimal"></td><td><input class="form-control" name="lineDiscount" inputmode="decimal" value="0"></td></tr><% } %></tbody></table></div><div class="row g-3"><div class="col-md-9"><label class="form-label">Notes</label><textarea class="form-control" name="notes" rows="2"></textarea></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary btn-lg w-100" onclick="return confirm('Complete this sale and deduct stock?')">Complete sale</button></div></div></form></div></div>
<script>document.addEventListener('DOMContentLoaded',function(){var type=document.getElementById('saleType');function update(row){var opt=row.querySelector('.product-select').selectedOptions[0];row.querySelector('.stock-cell').textContent=opt&&opt.value?opt.dataset.stock:'—';row.querySelector('.price-input').value=opt&&opt.value?(type.value==='wholesale'?opt.dataset.wholesale:opt.dataset.retail):'';}document.querySelectorAll('tbody tr').forEach(function(row){row.querySelector('.product-select').addEventListener('change',function(){update(row);});});type.addEventListener('change',function(){document.querySelectorAll('tbody tr').forEach(update);});});</script>
