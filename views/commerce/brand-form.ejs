<%- include('../partials/page-header', { heading: isEdit ? 'Edit brand' : 'Add brand', subheading: 'Brand details used throughout inventory and reports.', actions: [{ label: 'Back', url: '/brands', icon: 'bi-arrow-left', class: 'btn-outline-secondary' }] }) %>
<div class="card app-card mt-3"><div class="card-body p-4"><form method="POST" action="<%= formAction %>" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(isEdit){ %><input type="hidden" name="_method" value="PUT"><% } %>
<div class="col-md-6"><label class="form-label">Brand name *</label><input class="form-control" name="name" required maxlength="100" value="<%= old('name', brand ? brand.name : '') %>"></div><div class="col-md-3"><label class="form-label">Contact person</label><input class="form-control" name="contactName" value="<%= old('contactName', brand ? brand.contactName : '') %>"></div><div class="col-md-3"><label class="form-label">Phone</label><input class="form-control" name="phone" value="<%= old('phone', brand ? brand.phone : '') %>"></div>
<div class="col-md-9"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="3"><%= old('description', brand ? brand.description : '') %></textarea></div><div class="col-md-3"><label class="form-label">Status</label><select class="form-select" name="isActive"><option value="1">Active</option><option value="0" <%= brand && !brand.isActive ? 'selected' : '' %>>Inactive</option></select></div><div class="col-12"><button class="btn btn-primary">Save brand</button></div></form></div></div>
