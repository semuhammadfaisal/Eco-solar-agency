<%
  var equityValue = old(
    'equity',
    partner ? Number((partner.equityBps / 100).toFixed(2)) : ''
  );
  var joinedValue = old(
    'joinedAt',
    partner && partner.joinedAt ? partner.joinedAt.toISOString().slice(0, 10) : today
  );
  var activeChecked = oldInput.isActive !== undefined
    ? ['on', 'true', '1', 'yes'].indexOf(String(oldInput.isActive).toLowerCase()) !== -1
    : (partner ? partner.isActive : true);
%>

<%- include('../partials/page-header', {
  heading: isEdit ? 'Edit partner' : 'Add partner',
  subheading: isEdit
    ? 'Update equity share, contact details and status.'
    : 'Add a business partner and their equity share of the profit.',
  actions: [
    { label: 'Back to partners', url: '/partners', icon: 'bi-arrow-left', class: 'btn-outline-secondary' }
  ]
}) %>

<div class="row g-3 g-lg-4 mt-1">
  <div class="col-12 col-xl-8">
    <div class="card app-card">
      <div class="card-body p-4">
        <%- include('../partials/form-errors') %>

        <form method="POST" action="<%= formAction %>" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (formMethod !== 'POST') { %>
            <input type="hidden" name="_method" value="<%= formMethod %>">
          <% } %>

          <h2 class="h6 fw-semibold text-uppercase text-muted mb-3">Partner details</h2>

          <div class="row g-3">
            <div class="col-12 col-md-8">
              <label for="name" class="form-label">Partner name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="name" name="name"
                     value="<%= old('name', partner ? partner.name : '') %>"
                     maxlength="150" required placeholder="Full name">
            </div>

            <div class="col-12 col-md-4">
              <label for="equity" class="form-label">Equity share <span class="text-danger">*</span></label>
              <div class="input-group">
                <input type="number" step="0.01" min="0" max="100" class="form-control"
                       id="equity" name="equity" value="<%= equityValue %>" required placeholder="50.00">
                <span class="input-group-text">%</span>
              </div>
              <div class="form-text">Stored as basis points; 33.33% is exact.</div>
            </div>

            <div class="col-12 col-md-6">
              <label for="phone" class="form-label">Phone</label>
              <input type="text" class="form-control" id="phone" name="phone"
                     value="<%= old('phone', partner ? partner.phone : '') %>"
                     maxlength="30" placeholder="0300-1234567">
            </div>

            <div class="col-12 col-md-6">
              <label for="email" class="form-label">Email</label>
              <input type="email" class="form-control" id="email" name="email"
                     value="<%= old('email', partner ? partner.email : '') %>"
                     maxlength="150" placeholder="partner@example.com">
            </div>

            <div class="col-12 col-md-6">
              <label for="cnic" class="form-label">CNIC</label>
              <input type="text" class="form-control" id="cnic" name="cnic"
                     value="<%= old('cnic', partner ? partner.cnic : '') %>"
                     maxlength="15" placeholder="12345-1234567-1" inputmode="numeric">
            </div>

            <div class="col-12 col-md-6">
              <label for="joinedAt" class="form-label">Partner since <span class="text-danger">*</span></label>
              <input type="date" class="form-control" id="joinedAt" name="joinedAt"
                     value="<%= joinedValue %>" required>
            </div>

            <div class="col-12">
              <label for="address" class="form-label">Address</label>
              <input type="text" class="form-control" id="address" name="address"
                     value="<%= old('address', partner ? partner.address : '') %>"
                     maxlength="300" placeholder="House, street, city">
            </div>

            <div class="col-12">
              <label for="notes" class="form-label">Notes</label>
              <textarea class="form-control" id="notes" name="notes" rows="3" maxlength="1000"
                        placeholder="Anything worth remembering about this partner"><%= old('notes', partner ? partner.notes : '') %></textarea>
            </div>

            <div class="col-12">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="isActive"
                       name="isActive" value="on"<%= activeChecked ? ' checked' : '' %>>
                <label class="form-check-label" for="isActive">
                  Active partner (only active partners receive a profit share)
                </label>
              </div>
            </div>
          </div>

          <hr class="my-4">

          <div class="d-flex flex-wrap gap-2 justify-content-end">
            <a href="/partners" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check2 me-1"></i><%= isEdit ? 'Save changes' : 'Add partner' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-4">
    <div class="card app-card bg-light-subtle">
      <div class="card-header bg-transparent"><h2 class="h6 fw-semibold mb-0">How equity works</h2></div>
      <div class="card-body small text-muted">
        <p>Equity is the partner's share of the business. Two partners at 50% each split every
          PKR 100 of profit as PKR 50.00 / PKR 50.00.</p>
        <p class="mb-2">Active partners cannot hold more than 100% between them. Inactive partners
          are excluded from profit sharing and from the equity total.</p>
        <p class="mb-0">Example: a 33.33% partner receives PKR 33.33 of every PKR 100 profit.</p>
      </div>
    </div>
  </div>
</div>
