<%
  var statusBadgeClass = quotations.SALE_STATUS_BADGES[sale.status] || 'secondary';
  var statusLabel = quotations.SALE_STATUS_LABELS[sale.status] || sale.status;
  var quotationId = sale.quotation ? (sale.quotation._id || sale.quotation) : null;
  var quotationNum = sale.quotation ? sale.quotation.quotationNumber : 'Quotation';
  var projectTitle = sale.projectTitle || (sale.customer ? sale.customer.name + ' project' : 'Project');
%>

<%- include('../partials/page-header', {
  heading: projectTitle,
  subheading: sale.saleNumber + ' · ' + formatQty(sale.systemSummary ? sale.systemSummary.capacityKw : 0) + ' kW ' + (systems.SYSTEM_TYPE_LABELS[sale.systemSummary ? sale.systemSummary.systemType : 'on_grid'] || 'Solar System') + ' · Started ' + formatDate(sale.startDate || sale.createdAt),
  actions: [
    ...(quotationId ? [{ label: 'View Quotation (' + quotationNum + ')', url: '/quotations/' + quotationId, icon: 'bi-file-earmark-text', class: 'btn-outline-primary' }] : []),
    ...(sale.installmentPlan ? [{ label: 'View Installment Plan', url: '/installments/' + (sale.installmentPlan._id || sale.installmentPlan), icon: 'bi-calendar3-range', class: 'btn-primary' }] : [{ label: 'Create Installment Plan', url: '/installments/new?sale=' + sale._id, icon: 'bi-plus-lg', class: 'btn-primary' }]),
    { label: 'Back to projects', url: '/projects', icon: 'bi-arrow-left', class: 'btn-outline-secondary' }
  ]
}) %>

<!-- Sizing & Commercial Ribbon -->
<div class="row g-2 mb-3 mt-1">
  <div class="col-6 col-lg-3">
    <div class="card app-card border-primary-subtle text-center p-3 h-100">
      <div class="text-uppercase small text-muted fw-semibold">Capacity</div>
      <div class="display-6 fw-bold text-primary"><%= formatQty(sale.systemSummary ? sale.systemSummary.capacityKw : 0) %> kW</div>
      <div class="small text-muted"><%= sale.systemSummary ? sale.systemSummary.panelCount : 0 %> Solar Panels</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card border-success-subtle text-center p-3 h-100">
      <div class="text-uppercase small text-muted fw-semibold">Contract Amount</div>
      <div class="display-6 fw-bold text-success"><%= formatPKR(sale.amountPaisa) %></div>
      <div class="small text-muted"><%= quotations.PAYMENT_OPTION_LABELS[sale.paymentType] || sale.paymentType %></div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card border-info-subtle text-center p-3 h-100">
      <div class="text-uppercase small text-muted fw-semibold">Project Stage</div>
      <div class="d-flex align-items-center justify-content-center h-50">
        <span class="badge text-bg-<%= statusBadgeClass %> fs-6 px-3 py-2">
          <%= statusLabel %>
        </span>
      </div>
      <div class="small text-muted">Started <%= formatDate(sale.startDate || sale.createdAt) %></div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card app-card border-warning-subtle text-center p-3 h-100">
      <div class="text-uppercase small text-muted fw-semibold">Financial Margin</div>
      <% if (canViewProfit && sale.expectedProfitPaisa !== undefined) { %>
        <div class="display-6 fw-bold <%= sale.expectedProfitPaisa < 0 ? 'text-danger' : 'text-primary' %>">
          <%= formatPKR(sale.expectedProfitPaisa) %>
        </div>
        <div class="small text-muted">Margin: <%= sale.profitMarginPercent %>%</div>
      <% } else { %>
        <div class="display-6 fw-bold text-muted">—</div>
        <div class="small text-muted">Restricted for this role</div>
      <% } %>
    </div>
  </div>
</div>

<div class="row g-3 mb-3">
  <!-- Customer Profile Card -->
  <div class="col-12 col-lg-6">
    <div class="card app-card h-100">
      <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
        <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
          <i class="bi bi-person-badge"></i> Customer Details
        </h3>
        <% if (sale.customer) { %>
          <a href="/customers/<%= sale.customer._id %>" class="btn btn-sm btn-outline-secondary">View Profile</a>
        <% } %>
      </div>
      <div class="card-body p-3 p-md-4">
        <% if (sale.customer) { %>
          <dl class="row mb-0 small">
            <dt class="col-4 text-muted fw-normal">Customer Name</dt>
            <dd class="col-8 fw-semibold"><%= sale.customer.name %> (<%= sale.customer.code %>)</dd>

            <dt class="col-4 text-muted fw-normal">Phone</dt>
            <dd class="col-8"><%= sale.customer.phone %></dd>

            <dt class="col-4 text-muted fw-normal">Address / City</dt>
            <dd class="col-8"><%= [sale.customer.address, sale.customer.city].filter(Boolean).join(', ') || '—' %></dd>

            <dt class="col-4 text-muted fw-normal">DISCO / Ref #</dt>
            <dd class="col-8"><%= sale.customer.disco || '—' %> · <%= sale.customer.electricityReferenceNo || '—' %></dd>
          </dl>
        <% } else { %>
          <div class="text-muted small">No customer linked.</div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Contract & Project Meta Card -->
  <div class="col-12 col-lg-6">
    <div class="card app-card h-100">
      <div class="card-header bg-transparent py-3">
        <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
          <i class="bi bi-info-circle"></i> Project Metadata
        </h3>
      </div>
      <div class="card-body p-3 p-md-4">
        <dl class="row mb-0 small">
          <dt class="col-4 text-muted fw-normal">Project Title</dt>
          <dd class="col-8 fw-semibold"><%= sale.projectTitle || '—' %></dd>

          <dt class="col-4 text-muted fw-normal">Invoice Number</dt>
          <dd class="col-8 font-monospace fw-bold text-primary"><%= sale.invoiceNumber || '—' %></dd>

          <dt class="col-4 text-muted fw-normal">Sale Number</dt>
          <dd class="col-8 font-monospace fw-bold text-dark"><%= sale.saleNumber %></dd>

          <dt class="col-4 text-muted fw-normal">Quotation Ref</dt>
          <dd class="col-8">
            <% if (sale.quotation) { %>
              <a href="/quotations/<%= sale.quotation._id %>" class="font-monospace fw-semibold">
                <%= sale.quotation.quotationNumber %> (Rev <%= sale.quotation.revision %>)
              </a>
            <% } else { %>
              <span class="badge text-bg-light border text-muted">Direct project</span>
            <% } %>
          </dd>

          <dt class="col-4 text-muted fw-normal">Start Date</dt>
          <dd class="col-8"><%= formatDate(sale.startDate || sale.createdAt) %></dd>

          <dt class="col-4 text-muted fw-normal">Assigned Salesperson</dt>
          <dd class="col-8"><%= sale.assignedTo ? sale.assignedTo.name : '—' %></dd>

          <dt class="col-4 text-muted fw-normal">Approved By</dt>
          <dd class="col-8"><%= sale.approvedBy ? sale.approvedBy.name : 'Management' %> on <%= formatDate(sale.approvedAt || sale.createdAt) %></dd>

          <dt class="col-4 text-muted fw-normal">Status</dt>
          <dd class="col-8">
            <span class="badge text-bg-<%= statusBadgeClass %>"><%= statusLabel %></span>
          </dd>
        </dl>
      </div>
    </div>
  </div>
</div>

<!-- Milestone Payment Schedule Tracking -->
<div class="card app-card mb-3">
  <div class="card-header bg-transparent py-3">
    <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
      <i class="bi bi-calendar-check"></i> Project Milestones &amp; Billing Schedule
    </h3>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 app-table">
        <thead class="table-light">
          <tr>
            <th style="width: 40px;">#</th>
            <th>Milestone Description</th>
            <th class="text-center" style="width: 110px;">Percentage</th>
            <th class="text-end" style="width: 170px;">Amount</th>
            <th style="width: 150px;">Due Date</th>
            <th style="width: 110px;">Status</th>
            <th>Notes</th>
          </tr>
        </thead>
        <tbody>
          <% if (sale.paymentPlan && sale.paymentPlan.length) { %>
            <% sale.paymentPlan.forEach(function (ms, idx) { %>
              <tr>
                <td class="text-muted small"><%= idx + 1 %></td>
                <td class="fw-semibold"><%= ms.label %></td>
                <td class="text-center"><span class="badge text-bg-light border font-monospace"><%= ms.percent %>%</span></td>
                <td class="text-end font-monospace fw-bold text-dark"><%= formatPKR(ms.amountPaisa) %></td>
                <td class="small text-muted"><%= ms.dueDate ? formatDate(ms.dueDate) : 'Upon Stage Completion' %></td>
                <td>
                  <% if (ms.isPaid) { %>
                    <span class="badge text-bg-success">Paid</span>
                  <% } else { %>
                    <span class="badge text-bg-warning">Pending</span>
                  <% } %>
                </td>
                <td class="small text-muted"><%= ms.notes || '—' %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-3 text-muted small">
                100% advance payment contract (<%= formatPKR(sale.amountPaisa) %>).
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Snapshot Bill of Materials / Equipment List -->
<div class="card app-card mb-3">
  <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
    <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
      <i class="bi bi-box-seam"></i> Equipment Snapshot &amp; Delivery Scope
    </h3>
    <span class="badge text-bg-light border text-muted">
      <%= sale.itemsSnapshot ? sale.itemsSnapshot.length : 0 %> Items
    </span>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 app-table">
      <thead class="table-light">
        <tr>
          <th style="width: 40px;">#</th>
          <th>Component Description</th>
          <th>Category</th>
          <th>Brand / Specs</th>
          <th class="text-center" style="width: 90px;">Qty</th>
          <th class="text-end" style="width: 150px;">Unit Price</th>
          <th class="text-end" style="width: 150px;">Total Price</th>
        </tr>
      </thead>
      <tbody>
        <% if (sale.itemsSnapshot && sale.itemsSnapshot.length) { %>
          <% sale.itemsSnapshot.forEach(function (line, idx) { %>
            <tr class="<%= line.isOptionalExtra ? 'table-info-subtle' : '' %>">
              <td class="text-muted small"><%= idx + 1 %></td>
              <td>
                <div class="fw-semibold text-body">
                  <%= line.itemSnapshot ? line.itemSnapshot.name : 'Component' %>
                  <% if (line.isOptionalExtra) { %>
                    <span class="badge text-bg-info text-white ms-1" style="font-size:0.65rem;">Optional Extra</span>
                  <% } %>
                </div>
                <% if (line.notes) { %>
                  <div class="text-muted small"><%= line.notes %></div>
                <% } %>
              </td>
              <td>
                <span class="badge text-bg-secondary text-uppercase" style="font-size:0.65rem;">
                  <%= line.itemSnapshot ? line.itemSnapshot.category : 'other' %>
                </span>
              </td>
              <td class="small text-muted">
                <%= [line.itemSnapshot ? line.itemSnapshot.brand : '', line.itemSnapshot ? line.itemSnapshot.model : ''].filter(Boolean).join(' ') || '—' %>
              </td>
              <td class="text-center fw-semibold">
                <%= formatQty(line.qty) %> <span class="text-muted small"><%= line.itemSnapshot ? line.itemSnapshot.unit : 'pcs' %></span>
              </td>
              <td class="text-end font-monospace"><%= formatPKR(line.unitSellingPricePaisa) %></td>
              <td class="text-end font-monospace fw-bold text-dark"><%= formatPKR(line.totalSellingPricePaisa) %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center py-3 text-muted small">
              No equipment snapshot for this project yet.
              <% if (sale.quotation) { %>
                Items are copied from the approved quotation.
              <% } else { %>
                This project was started directly, so scope is recorded in the notes and milestone schedule.
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Material Dispatch & Security Gate Card -->
<div class="card app-card mb-4">
  <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
    <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
      <i class="bi bi-truck"></i> Material Issue &amp; Security Compliance Gate
    </h3>
    <% if (sale.isMaterialIssued) { %>
      <span class="badge text-bg-success"><i class="bi bi-check-circle-fill me-1"></i>Material Issued</span>
    <% } else { %>
      <span class="badge text-bg-warning"><i class="bi bi-hourglass-split me-1"></i>Material Pending Dispatch</span>
    <% } %>
  </div>
  <div class="card-body p-3 p-md-4">
    <% if (sale.isMaterialIssued) { %>
      <div class="alert alert-success d-flex align-items-center justify-content-between mb-0">
        <div>
          <i class="bi bi-check2-circle fs-5 me-2"></i>
          <strong>Material &amp; Equipment Dispatched:</strong> Handover completed on <%= formatDate(sale.materialIssuedAt) %>
          <% if (sale.materialIssuedBy) { %> by <%= sale.materialIssuedBy.name || 'Store' %><% } %>.
          <% if (sale.materialIssueNotes) { %><span class="d-block text-muted small mt-1">Notes: <%= sale.materialIssueNotes %></span><% } %>
        </div>
      </div>
    <% } else { %>
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
          <p class="mb-1 fw-semibold text-dark">Ready to issue and dispatch equipment to customer site?</p>
          <p class="text-muted small mb-0">
            For installment contracts, material issue is strictly gated: all security checklist items must be verified, or an owner override must be on record.
          </p>
        </div>
        <form method="POST" action="/installments/sales/<%= sale._id %>/issue-material" class="d-flex gap-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="text" class="form-control form-control-sm" name="notes" placeholder="Dispatch note / gate pass #">
          <button type="submit" class="btn btn-success btn-sm text-nowrap"
                  onclick="return confirm('Confirm material issue and warehouse dispatch for this sale?');">
            <i class="bi bi-box-seam me-1"></i>Issue Material
          </button>
        </form>
      </div>
    <% } %>
  </div>
</div>

<% if (canManage) { %>
  <div class="card app-card mb-4">
    <div class="card-header bg-transparent py-3">
      <h3 class="h6 fw-bold mb-0 text-primary d-flex align-items-center gap-2">
        <i class="bi bi-sliders"></i> Update Project Status
      </h3>
    </div>
    <div class="card-body p-3 p-md-4">
      <form method="POST" action="/projects/<%= sale._id %>/status" class="row g-3 align-items-end">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="col-12 col-md-4">
          <label class="form-label small fw-semibold text-uppercase text-muted">Status <span class="text-danger">*</span></label>
          <select class="form-select" name="status" required>
            <% quotations.SALE_STATUSES.forEach(function (st) { %>
              <option value="<%= st %>" <%= sale.status === st ? 'selected' : '' %>>
                <%= quotations.SALE_STATUS_LABELS[st] || st %>
              </option>
            <% }); %>
          </select>
        </div>

        <div class="col-12 col-md-6">
          <label class="form-label small fw-semibold text-uppercase text-muted">Progress Notes</label>
          <input type="text" class="form-control" name="notes" placeholder="e.g. Structure mounted, panels delivered to site">
        </div>

        <div class="col-12 col-md-2">
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-check2 me-1"></i>Update
          </button>
        </div>
      </form>
    </div>
  </div>
<% } %>
