{
  "name": "solar-agency-software",
  "version": "1.0.0",
  "private": true,
  "description": "Solar Business Management System for a solar company in Pakistan",
  "main": "app.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node --test tests/*.test.js",
    "seed": "node scripts/seed.js",
    "seed:force": "node scripts/seed.js --force",
    "seed:demo": "node scripts/seedDemo.js",
    "backup": "node scripts/backup.js",
    "migrate:commerce": "node scripts/migrateCommerce.js",
    "migrate:business-numbers": "node scripts/migrateBusinessNumbers.js",
    "sync:quotation-counter": "node scripts/syncQuotationCounter.js",
    "remove:leads": "node scripts/removeLeads.js",
    "remove:leads:empty": "node scripts/removeLeads.js --confirm-empty",
    "remove:leads:confirm": "node scripts/removeLeads.js --confirm"
  },
  "dependencies": {
    "alpinejs": "^3.14.8",
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.7",
    "compression": "^1.7.4",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "csurf": "^1.11.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "fullcalendar": "^6.1.22",
    "helmet": "^8.0.0",
    "method-override": "^3.0.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
