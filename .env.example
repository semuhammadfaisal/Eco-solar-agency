# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Public URL of the app (used in e-mails / links later). No trailing slash.
APP_URL=http://localhost:3000
APP_NAME=Solar Agency

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/solar_agency

# Or MongoDB Atlas
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/solar_agency?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Session / security
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-64-chars

# Session lifetime in days
SESSION_MAX_AGE_DAYS=14

# bcrypt cost factor (12 is a good default; raise it only if the server can handle it)
BCRYPT_ROUNDS=12

# Login rate limiting
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX_ATTEMPTS=10

# ---------------------------------------------------------------------------
# First owner account (used by `npm run seed`)
# ---------------------------------------------------------------------------
SEED_OWNER_NAME=Company Owner
SEED_OWNER_EMAIL=owner@example.com
# Leave blank to have the seed script generate a strong temporary password
SEED_OWNER_PASSWORD=
SEED_OWNER_PHONE=03001234567
